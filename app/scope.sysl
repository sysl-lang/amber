// The scope: what every meter has read over the last few seconds, each in its meter's colour, against
// the circuit's own time.
//
// **Each channel has a vertical scale of its own**, as a bench oscilloscope's do: a trace is centred
// on what it has read in the window and scaled so that it nearly fills the height, at a number of
// volts a division from the 1-2-5 sequence. A 10 mV input beside a 2.5 V output is two waves of a size,
// and the legend says what a division is worth for each and how far each swings, so the two sizes can
// still be compared. A mark at the left edge, in the trace's
// colour, shows where its zero volts is when that is in view.

import sh.sysl.amber.engineering
import sh.sysl.ui.{View, Canvas, Size, Rect, Image}
import sh.sysl.plutovg
import sysl.math.{max, min}

const SCOPE_HEIGHT: int = 170
const SCOPE_GROUND: u32 = 0x0B0D10
const GRATICULE: u32 = 0x22262E
const AXIS: u32 = 0x3A404C

// How many divisions the plot is high.
const DIVISIONS: int = 5

private struct Scope
    m: &Model

scope(m: &Model) -> &View = Scope(m)

impl View for Scope
    measure(&self, c: *Canvas, avail: Size) -> Size = Size(avail.w, SCOPE_HEIGHT)

    paint(&self, c: *Canvas, r: Rect)
        val m = self.m

        c.fill(r, SCOPE_GROUND)

        if m.meters.len() == 0
            c.ink(DIM)
            c.text(Rect(r.x + 16, r.y + r.h / 2 - 10, r.w - 32, 20), "put a meter across two points to watch its voltage here")
            c.unink()
            return

        // The plot leaves room on the left for the channels' zero marks and on the right for the legend.
        val plot = Rect(r.x + 24, r.y + 12, r.w - 24 - 250, r.h - 34)
        val now = m.s.time
        val from = now - m.window()

        if m.scope.fit(r, c.pixel_scale()) is Some(vg)
            trace_all(m, vg, r, plot, c.pixel_scale(), from)
            c.draw_image(r, Image(m.scope.surface.unwrap()))

        c.ink(DIM)
        c.text(Rect(plot.x, plot.bottom() + 4, 200, 18), s"${engineering(m.window())}s across")
        c.text(Rect(plot.right() - 120, plot.bottom() + 4, 120, 18), s"t = ${engineering(now)}s")
        c.unink()

        for k in 0..<m.meters.len()
            val mt = m.meters[k]
            val y = r.y + 14 + int(k) * 22
            val (lo, hi) = reach(mt, from)
            val (_, per_div) = channel_scale(lo, hi)

            if y + 18 > r.bottom() then break

            c.fill(Rect(plot.right() + 16, y + 6, 14, 4), mt.colour)
            c.ink(INK)
            c.text(Rect(plot.right() + 36, y, 130, 18), s"${mt.name}  ${volts(per_div)}/div")
            c.unink()
            c.ink(DIM)
            c.text(Rect(plot.right() + 170, y, 80, 18), legend_value(lo, hi, m.reading(mt)))
            c.unink()

// What the legend says of a channel whose readings ran from `lo` to `hi` and read `now` last: how far
// it swings from top to bottom, so that an amplifier's gain is the ratio of two figures side by side,
// since each trace is scaled to fill the plot whatever its size. A channel that hardly moves, by less
// than a millivolt or a two-hundredth of its voltage, has no swing worth reading, and gives its
// voltage: a regulated 5 V with 10 mV of ripple is 5 V, while a first stage's 80 mV on its 2 V bias is
// a swing.
legend_value(lo: real, hi: real, now: real) -> string
    if hi - lo < max(1e-3, 0.005 * max(lo.abs(), hi.abs())) then volts(now) else s"${volts(hi - lo)} p-p"

// The lowest and highest reading meter `mt` has made since `from`, or zero for both if it has made none.
reach(mt: Meter, from: real) -> (real, real)
    var lo = 0.0
    var hi = 0.0
    var any = false

    for j in 0..<mt.times.len()
        if mt.times[j] >= from
            val v = mt.readings[j]

            lo = if any then min(lo, v) else v
            hi = if any then max(hi, v) else v
            any = true

    (lo, hi)

// The scale of a channel whose readings run from `lo` to `hi`: the voltage at the plot's middle, and
// the volts a division, the smallest step of the 1-2-5 sequence that fits the readings with a twentieth
// to spare. A trace that hardly moves is drawn at a twentieth of its size, so a steady 9 V is a flat line
// at 100 mV a division rather than its rounding errors blown up to fill the plot; and never finer than a
// millivolt across the whole height. The middle is put on a fifth of a division, so the trace stays
// still while what it reads does.
channel_scale(lo: real, hi: real) -> (real, real)
    val span = max(max(hi - lo, 0.05 * max(lo.abs(), hi.abs())), 1e-3)
    val per_div = step_125(1.05 * span / real(DIVISIONS))
    val notch = per_div / 5.0

    (((lo + hi) / 2.0 / notch).round() * notch, per_div)

// The smallest of 1, 2 and 5 times a power of ten that is at least `x`, which is more than zero.
step_125(x: real) -> real
    var decade = 10.0.pow(x.log10().floor())

    // The logarithm can land a hair either side of a power of ten.
    if decade > x then decade /= 10.0

    if x <= decade * (1.0 + 1e-9) then return decade

    if x <= 2.0 * decade * (1.0 + 1e-9) then return 2.0 * decade

    if x <= 5.0 * decade * (1.0 + 1e-9) then return 5.0 * decade

    10.0 * decade

// Draw the graticule, each channel's zero mark and every meter's trace into the scope's picture.
private trace_all(m: &Model, vg: &plutovg.Canvas, r: Rect, plot: Rect, scale: real, from: real)
    val left = real(plot.x - r.x)
    val top = real(plot.y - r.y)
    val w = real(plot.w)
    val h = real(plot.h)
    val window = m.window()

    vg.line_width(f32(scale))

    for k in 0..DIVISIONS
        tone(vg, if k == 0 || k == DIVISIONS then AXIS else GRATICULE)
        vg.begin()
        vg.move_to(f32(left * scale), f32((top + h * real(k) / real(DIVISIONS)) * scale))
        vg.line_to(f32((left + w) * scale), f32((top + h * real(k) / real(DIVISIONS)) * scale))
        vg.stroke()

    vg.line_join(plutovg.LineJoin.Round)

    for k in 0..<m.meters.len()
        val mt = m.meters[k]
        val (lo, hi) = reach(mt, from)
        val (centre, per_div) = channel_scale(lo, hi)
        // Where a reading of `v` is drawn, in the picture's points from its top.
        val y_of = (v: real) -> top + h * (0.5 - (v - centre) / (real(DIVISIONS) * per_div))
        val y0 = y_of(0.0)
        var started = false

        tone(vg, mt.colour)

        if y0 >= top && y0 <= top + h
            vg.begin()
            vg.move_to(f32((left - 10.0) * scale), f32((y0 - 4.0) * scale))
            vg.line_to(f32((left - 3.0) * scale), f32(y0 * scale))
            vg.line_to(f32((left - 10.0) * scale), f32((y0 + 4.0) * scale))
            vg.close_path()
            vg.fill()

        vg.line_width(f32(2.0 * scale))
        vg.begin()

        for j in 0..<mt.times.len()
            val t = mt.times[j]

            if t < from then continue

            val x = (left + w * (t - from) / window) * scale
            val y = y_of(mt.readings[j]) * scale

            if started then vg.line_to(f32(x), f32(y)) else vg.move_to(f32(x), f32(y))

            started = true

        vg.stroke()

tone(vg: &plutovg.Canvas, colour: u32) =
    vg.rgb(f32(int((colour >> 16) & 0xFF)) / 255.0, f32(int((colour >> 8) & 0xFF)) / 255.0, f32(int(colour & 0xFF)) / 255.0)
