@tests

import sh.sysl.amber.{parse_schematic, Switch}
import sysl.text.Search

val LED = """
    battery  B1  0 0  0 6  9V
    resistor R1  0 0  6 0  470
    led      D1  6 0  6 6  red
    wire         6 6  0 6
    ground       0 6
    """

private led_model() -> &Model = model("led.amber", parse_schematic(LED).unwrap())

@test("two clicks on points make a meter reading the first less the second")
two_clicks_make_a_meter()
    val m = led_model()

    assert(m.probe(0, 0))
    assert(m.probing && m.meters.len() == 0)
    assert(m.probe(0, 6))
    assert(!m.probing && m.meters.len() == 1)
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-9)

@test("meters across the resistor and the LED add up to the battery")
meters_add_up()
    val m = led_model()

    m.probe(0, 0)
    m.probe(6, 0)
    m.probe(6, 0)
    m.probe(6, 6)

    val total = m.reading(m.meters[0]) + m.reading(m.meters[1])

    assert((total - 9.0).abs() < 1e-9)
    assert(m.reading(m.meters[1]) > 1.6 && m.reading(m.meters[1]) < 2.1)

@test("a meter with its leads swapped reads negative")
swapped_leads()
    val m = led_model()

    m.probe(6, 0)
    m.probe(0, 0)
    assert(m.reading(m.meters[0]) < -7.0)

@test("a click where no node is places no lead, and a second click on the red lead's point cancels it")
clicks_off_the_circuit()
    val m = led_model()

    assert(!m.probe(3, 3))
    assert(!m.probing)
    assert(m.probe(0, 0))
    assert(m.probe(0, 0))
    assert(!m.probing && m.meters.len() == 0)

@test("the status line gives a clicked part's voltage, current and power")
status_of_a_part()
    val m = led_model()

    m.selected = m.sch.find("R1").unwrap()
    assert(status(m).contains("R1 470Ω resistor: 7.16V across, 15.2mA through, 109mW taken"))
    m.selected = m.sch.find("B1").unwrap()
    assert(status(m).ends_with("delivered"))

@test("a circuit that cannot be solved says so instead of reading")
unsolvable()
    val m = model("bad.amber", parse_schematic("battery B1 0 0 0 1 5\nwire 0 0 0 1\nground 0 1").unwrap())

    assert(status(m).contains("cannot solve:"))

val RC = """
    speed 1
    battery   B1  0 0  0 6  9V
    switch    S1  0 0  3 0
    resistor  R1  3 0  7 0  10k
    capacitor C1  7 0  7 6  100u
    wire          7 6  0 6
    ground        0 6
    meter     M1  7 0  7 6
    """

private rc_model() -> &Model = model("rc.amber", parse_schematic(RC).unwrap())

@test("the file's meters are the model's first, and the file's speed is the clock's")
file_meters_and_speed()
    val m = rc_model()

    assert(m.meters.len() == 1)
    assert(m.pace() == 1.0)
    assert(m.meters[0].times.len() == 1)

@test("clicking a switch closes it, and the clock then charges the capacitor")
switch_and_clock()
    val m = rc_model()
    val s1 = m.sch.find("S1").unwrap()

    // Open, a second passes and nothing happens.
    tick(m, 0.1)
    assert(m.reading(m.meters[0]).abs() < 1e-9)
    m.toggle(s1)
    m.selected = s1
    assert(status(m).contains("closed switch"))

    // A tenth of a second at a second a second, ten frames: 0.1 time constants.
    for _ in 0..<10
        tick(m, 0.1)

    assert((m.s.time - 1.1).abs() < 1e-9)
    assert((m.reading(m.meters[0]) - 9.0 * (1.0 - (-1.0).exp())).abs() < 0.02)
    // Every frame sampled the meter several times.
    assert(int(m.meters[0].times.len()) == 1 + 11 * SAMPLES_PER_FRAME)

@test("a paused clock does not move, and a restart starts again from empty")
pause_and_restart()
    val m = rc_model()

    m.toggle(m.sch.find("S1").unwrap())
    tick(m, 0.1)
    m.running = false
    tick(m, 0.1)
    assert((m.s.time - 0.1).abs() < 1e-9)
    m.restart()
    assert(m.s.time == 0.0)
    assert(m.meters[0].times.len() == 1)
    assert(m.reading(m.meters[0]).abs() < 1e-9)

@test("a frame owes no more than a tenth of a second, however late it is")
late_frame()
    val m = rc_model()

    tick(m, 3.0)
    assert((m.s.time - 0.1).abs() < 1e-9)

@test("dots move with the current, in proportion to the largest seen, and not at all for a trickle")
dot_speeds()
    assert(dot_speed(1e-3, 1e-3) == 3.0)
    assert(dot_speed(-0.5e-3, 1e-3) == -1.5)
    assert(dot_speed(1e-12, 1e-3) == 0.0)
    assert(dot_speed(1e-8, 1e-3) == 0.0)

@test("a meter forgets its oldest half once it has read many times")
meter_memory()
    val m = rc_model()
    var mt = m.meters[0]

    for k in 0..<9000
        mt.record(real(k), 0.0)

    assert(mt.times.len() < 8192)
    assert(mt.times[mt.times.len() - 1] == 8999.0)

@test("a meter clicked into place is named after the meters already there")
meter_names()
    val m = rc_model()

    m.probe(0, 0)
    m.probe(0, 6)
    m.probe(3, 0)
    m.probe(7, 0)
    assert(m.meters[0].name == "M1")
    assert(m.meters[1].name == "M2")
    assert(m.meters[2].name == "M3")

@test("a restart puts the switches back as the file has them")
restart_resets_switches()
    val m = rc_model()
    val s1 = m.sch.find("S1").unwrap()

    m.toggle(s1)
    m.restart()
    assert(m.s.circuit.parts[usize(m.sch.elements[usize(s1)].part)].kind == Switch(false))

// A common-emitter stage, its emitter landing along the bottom rail.
val STAGE = """
    battery  B1  0 0  0 6  9
    wire         0 0  8 0
    resistor RC  4 0  4 2  1k
    npn      Q1  4 2  6 4  4 6
    resistor RB  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 6
    """

// The same stage for a PNP, the battery turned over.
val PNP_STAGE = """
    battery  B1  0 6  0 0  9
    wire         0 0  8 0
    resistor RC  4 0  4 2  1k
    pnp      Q1  4 2  6 4  4 6
    resistor RB  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 0
    """

@test("meters on a transistor's terminals read its base–emitter and collector–emitter voltages")
transistor_meters()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())
    val q = m.sch.elements[m.sch.find("Q1").unwrap()].part

    assert(m.probe(6, 4))
    assert(m.probe(4, 6))
    assert(m.probe(4, 2))
    assert(m.probe(4, 6))
    assert(m.meters.len() == 2)
    assert(m.reading(m.meters[0]) > 0.55 && m.reading(m.meters[0]) < 0.75)
    assert((m.reading(m.meters[1]) - m.s.across(q)).abs() < 1e-12)

@test("the status line gives a clicked transistor's voltages and the currents into it, or out of a PNP")
status_of_a_transistor()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())

    m.selected = m.sch.find("Q1").unwrap()
    assert(status(m).contains("Q1 2N3904 NPN transistor: "))
    assert(status(m).contains("A into the collector, "))
    assert(status(m).ends_with("A into the base"))

    val p = model("pnp.amber", parse_schematic(PNP_STAGE).unwrap())

    p.selected = p.sch.find("Q1").unwrap()
    assert(status(p).contains("Q1 2N3906 PNP transistor: -"))
    assert(status(p).contains("A out of the collector, "))
    assert(status(p).ends_with("A out of the base"))

@test("a transistor's dots run in at its collector and base and out at its emitter, and the other way for a PNP")
transistor_dots()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())
    val i = usize(m.sch.find("Q1").unwrap())

    m.flow(0.1)
    assert(m.part_flow[i] > 0.0 && m.base_flow[i] > 0.0 && m.emitter_flow[i] > 0.0)
    // The emitter carries the largest current, so it sets the dots' pace.
    assert((m.emitter_flow[i] - 0.3).abs() < 1e-9)
    assert(m.emitter_flow[i] > m.part_flow[i] && m.part_flow[i] > m.base_flow[i])

    val p = model("pnp.amber", parse_schematic(PNP_STAGE).unwrap())

    p.flow(0.1)
    assert(p.part_flow[i] < 0.0 && p.base_flow[i] < 0.0 && p.emitter_flow[i] < 0.0)

// A common-source stage, its source landing along the bottom rail, and the same for a PMOS.
val MOS_STAGE = """
    battery  B1  0 0  0 6  9
    wire         0 0  8 0
    resistor RD  4 0  4 2  1k
    nmos     M1  4 2  6 4  4 6
    resistor RG  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 6
    """

val PMOS_STAGE = """
    battery  B1  0 6  0 0  9
    wire         0 0  8 0
    resistor RD  4 0  4 2  1k
    pmos     M1  4 2  6 4  4 6
    resistor RG  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 0
    """

@test("meters on a MOSFET's terminals read its gate–source and drain–source voltages")
mosfet_meters()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())
    val q = m.sch.elements[m.sch.find("M1").unwrap()].part

    assert(m.probe(6, 4))
    assert(m.probe(4, 6))
    assert(m.probe(4, 2))
    assert(m.probe(4, 6))
    assert(m.meters.len() == 2)
    // The gate sits at the supply, which the source is 9 V below.
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)
    assert((m.reading(m.meters[1]) - m.s.across(q)).abs() < 1e-12)

@test("the status line gives a clicked MOSFET's voltages and the drain current, into an NMOS and out of a PMOS")
status_of_a_mosfet()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())

    m.selected = m.sch.find("M1").unwrap()
    assert(status(m).contains("M1 2N7000 N-channel MOSFET: "))
    assert(status(m).contains("V drain to source, 9V gate to source, "))
    assert(status(m).ends_with("A into the drain"))

    val p = model("pmos.amber", parse_schematic(PMOS_STAGE).unwrap())

    p.selected = p.sch.find("M1").unwrap()
    assert(status(p).contains("M1 BS250 P-channel MOSFET: -"))
    assert(status(p).contains("V drain to source, -9V gate to source, "))
    assert(status(p).ends_with("A out of the drain"))

@test("a MOSFET's dots run through its channel from the drain to the source, and the other way for a PMOS, with none at its gate")
mosfet_dots()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())
    val i = usize(m.sch.find("M1").unwrap())

    m.flow(0.1)
    // Drain and source carry the one current, the largest in the circuit, so it sets the dots' pace.
    assert((m.part_flow[i] - 0.3).abs() < 1e-9)
    assert((m.emitter_flow[i] - 0.3).abs() < 1e-9)
    assert(m.base_flow[i] == 0.0)

    val p = model("pmos.amber", parse_schematic(PMOS_STAGE).unwrap())

    p.flow(0.1)
    assert((p.part_flow[i] + 0.3).abs() < 1e-9)
    assert((p.emitter_flow[i] + 0.3).abs() < 1e-9)
    assert(p.base_flow[i] == 0.0)
