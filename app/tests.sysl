@tests

import sh.sysl.amber.{parse_schematic, Switch, Oscillator, Waveform, Generator, Dc, oscillator, Shape}
import sh.sysl.sdl3.{SCANCODE_B, SCANCODE_C, SCANCODE_R, SCANCODE_S, SCANCODE_M, SCANCODE_SPACE, SCANCODE_MINUS, SCANCODE_EQUALS}
import sysl.buf.{Buf, buf}
import sysl.math.{max, min, tau}
import sysl.raw.str_cast
import sysl.text.Search

val LED = """
    battery  B1  0 0  0 6  9V
    resistor R1  0 0  6 0  470
    led      D1  6 0  6 6  red
    wire         6 6  0 6
    ground       0 6
    """

private led_model() -> &Model = model("led.amber", parse_schematic(LED).unwrap())

@test("two clicks on points make a meter reading the first less the second")
two_clicks_make_a_meter()
    val m = led_model()

    assert(m.probe(0, 0))
    assert(m.probing && m.meters.len() == 0)
    assert(m.probe(0, 6))
    assert(!m.probing && m.meters.len() == 1)
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-9)

@test("meters across the resistor and the LED add up to the battery")
meters_add_up()
    val m = led_model()

    m.probe(0, 0)
    m.probe(6, 0)
    m.probe(6, 0)
    m.probe(6, 6)

    val total = m.reading(m.meters[0]) + m.reading(m.meters[1])

    assert((total - 9.0).abs() < 1e-9)
    assert(m.reading(m.meters[1]) > 1.6 && m.reading(m.meters[1]) < 2.1)

@test("a meter with its leads swapped reads negative")
swapped_leads()
    val m = led_model()

    m.probe(6, 0)
    m.probe(0, 0)
    assert(m.reading(m.meters[0]) < -7.0)

@test("a click where no node is places no lead, and a second click on the red lead's point cancels it")
clicks_off_the_circuit()
    val m = led_model()

    assert(!m.probe(3, 3))
    assert(!m.probing)
    assert(m.probe(0, 0))
    assert(m.probe(0, 0))
    assert(!m.probing && m.meters.len() == 0)

@test("the status line gives a clicked part's voltage, current and power")
status_of_a_part()
    val m = led_model()

    m.selected = m.sch.find("R1").unwrap()
    assert(status(m).contains("R1 470Ω resistor: 7.16V across, 15.2mA through, 109mW taken"))
    m.selected = m.sch.find("B1").unwrap()
    assert(status(m).ends_with("delivered"))

@test("a circuit that cannot be solved says so instead of reading")
unsolvable()
    val m = model("bad.amber", parse_schematic("battery B1 0 0 0 1 5\nwire 0 0 0 1\nground 0 1").unwrap())

    assert(status(m).contains("cannot solve:"))

val RC = """
    speed 1
    battery   B1  0 0  0 6  9V
    switch    S1  0 0  3 0
    resistor  R1  3 0  7 0  10k
    capacitor C1  7 0  7 6  100u
    wire          7 6  0 6
    ground        0 6
    meter     M1  7 0  7 6
    """

private rc_model() -> &Model = model("rc.amber", parse_schematic(RC).unwrap())

@test("the file's meters are the model's first, and the file's speed is the clock's")
file_meters_and_speed()
    val m = rc_model()

    assert(m.meters.len() == 1)
    assert(m.pace() == 1.0)
    assert(m.meters[0].times.len() == 1)

@test("clicking a switch closes it, and the clock then charges the capacitor")
switch_and_clock()
    val m = rc_model()
    val s1 = m.sch.find("S1").unwrap()

    // Open, a second passes and nothing happens.
    tick(m, 0.1)
    assert(m.reading(m.meters[0]).abs() < 1e-9)
    m.toggle(s1)
    m.selected = s1
    assert(status(m).contains("closed switch"))

    // A tenth of a second at a second a second, ten frames: 0.1 time constants.
    for _ in 0..<10
        tick(m, 0.1)

    assert((m.s.time - 1.1).abs() < 1e-9)
    assert((m.reading(m.meters[0]) - 9.0 * (1.0 - (-1.0).exp())).abs() < 0.02)
    // Every frame sampled the meter several times.
    assert(int(m.meters[0].times.len()) == 1 + 11 * SAMPLES_PER_FRAME)

@test("a paused clock does not move, and a restart starts again from empty")
pause_and_restart()
    val m = rc_model()

    m.toggle(m.sch.find("S1").unwrap())
    tick(m, 0.1)
    m.running = false
    tick(m, 0.1)
    assert((m.s.time - 0.1).abs() < 1e-9)
    m.restart()
    assert(m.s.time == 0.0)
    assert(m.meters[0].times.len() == 1)
    assert(m.reading(m.meters[0]).abs() < 1e-9)

@test("a frame owes no more than a tenth of a second, however late it is")
late_frame()
    val m = rc_model()

    tick(m, 3.0)
    assert((m.s.time - 0.1).abs() < 1e-9)

@test("dots move with the current, in proportion to the largest seen, and not at all for a trickle")
dot_speeds()
    assert(dot_speed(1e-3, 1e-3) == 3.0)
    assert(dot_speed(-0.5e-3, 1e-3) == -1.5)
    assert(dot_speed(1e-12, 1e-3) == 0.0)
    assert(dot_speed(1e-8, 1e-3) == 0.0)

@test("a meter forgets its oldest half once it has read many times")
meter_memory()
    val m = rc_model()
    var mt = m.meters[0]

    for k in 0..<9000
        mt.record(real(k), 0.0)

    assert(mt.times.len() < 8192)
    assert(mt.times[mt.times.len() - 1] == 8999.0)

@test("a meter clicked into place is named after the meters already there")
meter_names()
    val m = rc_model()

    m.probe(0, 0)
    m.probe(0, 6)
    m.probe(3, 0)
    m.probe(7, 0)
    assert(m.meters[0].name == "M1")
    assert(m.meters[1].name == "M2")
    assert(m.meters[2].name == "M3")

@test("a restart puts the switches back as the file has them")
restart_resets_switches()
    val m = rc_model()
    val s1 = m.sch.find("S1").unwrap()

    m.toggle(s1)
    m.restart()
    assert(m.s.circuit.parts[usize(m.sch.elements[usize(s1)].part)].kind == Switch(false))

// A common-emitter stage, its emitter landing along the bottom rail.
val STAGE = """
    battery  B1  0 0  0 6  9
    wire         0 0  8 0
    resistor RC  4 0  4 2  1k
    npn      Q1  4 2  6 4  4 6
    resistor RB  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 6
    """

// The same stage for a PNP, the battery turned over.
val PNP_STAGE = """
    battery  B1  0 6  0 0  9
    wire         0 0  8 0
    resistor RC  4 0  4 2  1k
    pnp      Q1  4 2  6 4  4 6
    resistor RB  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 0
    """

@test("meters on a transistor's terminals read its base–emitter and collector–emitter voltages")
transistor_meters()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())
    val q = m.sch.elements[m.sch.find("Q1").unwrap()].part

    assert(m.probe(6, 4))
    assert(m.probe(4, 6))
    assert(m.probe(4, 2))
    assert(m.probe(4, 6))
    assert(m.meters.len() == 2)
    assert(m.reading(m.meters[0]) > 0.55 && m.reading(m.meters[0]) < 0.75)
    assert((m.reading(m.meters[1]) - m.s.across(q)).abs() < 1e-12)

@test("the status line gives a clicked transistor's voltages and the currents into it, or out of a PNP")
status_of_a_transistor()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())

    m.selected = m.sch.find("Q1").unwrap()
    assert(status(m).contains("Q1 2N3904 NPN transistor: "))
    assert(status(m).contains("A into the collector, "))
    assert(status(m).ends_with("A into the base"))

    val p = model("pnp.amber", parse_schematic(PNP_STAGE).unwrap())

    p.selected = p.sch.find("Q1").unwrap()
    assert(status(p).contains("Q1 2N3906 PNP transistor: -"))
    assert(status(p).contains("A out of the collector, "))
    assert(status(p).ends_with("A out of the base"))

@test("a transistor's dots run in at its collector and base and out at its emitter, and the other way for a PNP")
transistor_dots()
    val m = model("stage.amber", parse_schematic(STAGE).unwrap())
    val i = usize(m.sch.find("Q1").unwrap())

    m.flow(0.1)
    assert(m.part_flow[i] > 0.0 && m.base_flow[i] > 0.0 && m.emitter_flow[i] > 0.0)
    // The emitter carries the largest current, so it sets the dots' pace.
    assert((m.emitter_flow[i] - 0.3).abs() < 1e-9)
    assert(m.emitter_flow[i] > m.part_flow[i] && m.part_flow[i] > m.base_flow[i])

    val p = model("pnp.amber", parse_schematic(PNP_STAGE).unwrap())

    p.flow(0.1)
    assert(p.part_flow[i] < 0.0 && p.base_flow[i] < 0.0 && p.emitter_flow[i] < 0.0)

// A common-source stage, its source landing along the bottom rail, and the same for a PMOS.
val MOS_STAGE = """
    battery  B1  0 0  0 6  9
    wire         0 0  8 0
    resistor RD  4 0  4 2  1k
    nmos     M1  4 2  6 4  4 6
    resistor RG  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 6
    """

val PMOS_STAGE = """
    battery  B1  0 6  0 0  9
    wire         0 0  8 0
    resistor RD  4 0  4 2  1k
    pmos     M1  4 2  6 4  4 6
    resistor RG  8 0  8 4  470k
    wire         8 4  6 4
    wire         0 6  8 6
    ground       0 0
    """

@test("meters on a MOSFET's terminals read its gate–source and drain–source voltages")
mosfet_meters()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())
    val q = m.sch.elements[m.sch.find("M1").unwrap()].part

    assert(m.probe(6, 4))
    assert(m.probe(4, 6))
    assert(m.probe(4, 2))
    assert(m.probe(4, 6))
    assert(m.meters.len() == 2)
    // The gate sits at the supply, which the source is 9 V below.
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)
    assert((m.reading(m.meters[1]) - m.s.across(q)).abs() < 1e-12)

@test("the status line gives a clicked MOSFET's voltages and the drain current, into an NMOS and out of a PMOS")
status_of_a_mosfet()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())

    m.selected = m.sch.find("M1").unwrap()
    assert(status(m).contains("M1 2N7000 N-channel MOSFET: "))
    assert(status(m).contains("V drain to source, 9V gate to source, "))
    assert(status(m).ends_with("A into the drain"))

    val p = model("pmos.amber", parse_schematic(PMOS_STAGE).unwrap())

    p.selected = p.sch.find("M1").unwrap()
    assert(status(p).contains("M1 BS250 P-channel MOSFET: -"))
    assert(status(p).contains("V drain to source, -9V gate to source, "))
    assert(status(p).ends_with("A out of the drain"))

@test("a MOSFET's dots run through its channel from the drain to the source, and the other way for a PMOS, with none at its gate")
mosfet_dots()
    val m = model("mos.amber", parse_schematic(MOS_STAGE).unwrap())
    val i = usize(m.sch.find("M1").unwrap())

    m.flow(0.1)
    // Drain and source carry the one current, the largest in the circuit, so it sets the dots' pace.
    assert((m.part_flow[i] - 0.3).abs() < 1e-9)
    assert((m.emitter_flow[i] - 0.3).abs() < 1e-9)
    assert(m.base_flow[i] == 0.0)

    val p = model("pmos.amber", parse_schematic(PMOS_STAGE).unwrap())

    p.flow(0.1)
    assert((p.part_flow[i] + 0.3).abs() < 1e-9)
    assert((p.emitter_flow[i] + 0.3).abs() < 1e-9)
    assert(p.base_flow[i] == 0.0)

// --- Instrument panels ------------------------------------------------------------------------------

// A signal generator driving a low-pass filter, its output on a meter.
val BENCH = """
    speed 1m
    gen       G1  0 0  0 4  sine 1k 1
    resistor  R1  0 0  4 0  1k
    capacitor C1  4 0  4 4  100n
    wire          4 4  0 4
    ground        0 4
    meter     OUT 4 0  4 4
    """

private bench() -> &Model = model("bench.amber", parse_schematic(BENCH).unwrap())

private close(got: real, want: real) -> bool = (got - want).abs() <= 1e-9 * max(1.0, want.abs())

// The generator's oscillator as its panel last handed it to the circuit.
private osc(m: &Model) -> Oscillator = m.panels[0].instrument match
    SignalGenerator(o) -> o
    else oscillator(Waveform.Dc, 1.0, 0.0)

@test("clicking a generator opens its panel, set as its line says; clicking anything else closes it")
panel_opens_and_closes()
    val m = bench()
    val g1 = m.sch.find("G1").unwrap()

    assert(m.panels.len() == 1)
    assert(m.open_panel().is_none())
    m.select(g1)
    assert(m.open_panel() == Some(0))

    val p = m.panels[0]

    assert(p.title == "G1 signal generator")
    assert(p.choices[0].options.len() == 4 && p.choices[0].options[2] == "triangle")
    assert(p.choices[0].chosen.read() == 0)
    assert(close(p.knobs[0].value(), 1000.0))
    assert(close(p.knobs[1].value(), 1.0))
    assert(p.knobs[2].value() == 0.0)

    m.select(m.sch.find("R1").unwrap())
    assert(m.open_panel().is_none())
    m.select(g1)
    m.select(-1)
    assert(m.open_panel().is_none())

@test("a logarithmic knob slides along the value's logarithm, and a straight one along the value")
knob_scales()
    val m = bench()
    val f = m.panels[0].knobs[0]
    val offset = m.panels[0].knobs[2]

    assert(f.log && !offset.log)
    assert(f.ends() == ((0.1).log10(), 6.0))
    assert(close(f.position.read(), 3.0))
    f.position.set(4.5)
    assert(close(f.value(), 10.0.pow(4.5)))
    f.set(250.0)
    assert(close(f.position.read(), (250.0).log10()))
    offset.position.set(-2.5)
    assert(offset.value() == -2.5)
    assert(offset.ends() == (-10.0, 10.0))

@test("a turned knob reaches the circuit at once, while it runs: no restart, and the generator's cycle carries on")
knob_reaches_the_circuit()
    val m = bench()
    val part = m.panels[0].part

    m.run(2.3e-3, 23)

    val t = m.s.time
    val before = m.reading(m.meters[0])
    val wave_before = m.s.circuit.parts[usize(part)].kind.wave().unwrap()

    // Nothing turned: nothing is handed over, so the solver is not made to start a step afresh.
    assert(!m.sync())

    m.panels[0].knobs[0].set(2000.0)
    m.panels[0].knobs[1].set(3.0)
    assert(m.sync())
    assert(!m.sync())

    // The clock and the capacitor are where they were.
    assert(m.s.time == t)
    assert(m.reading(m.meters[0]) == before)

    val o = osc(m)

    assert(close(o.frequency, 2000.0) && close(o.amplitude, 3.0) && o.form == Waveform.Sine)
    assert(o.start == t)
    // Three tenths of the way through its cycle at 2.3 ms, and still there when the knob turned.
    assert(close(o.phase, 0.3))
    assert(m.s.circuit.parts[usize(part)].kind == Generator(o.wave(), 50.0))

    // The new sine is the old one's phase at three times the amplitude.
    val now = m.s.circuit.parts[usize(part)].kind.wave().unwrap()

    assert((now.at(t) - 3.0 * wave_before.at(t)).abs() < 1e-9)

    // And the clock runs on with it: a quarter of the new period later, the sine is at its peak's
    // phase plus a quarter.
    m.run(0.125e-3, 5)
    assert(close(osc(m).phase_at(m.s.time), 0.55))

@test("a new waveform chosen on the panel is what the generator puts out from then on")
waveform_choice_reaches_the_circuit()
    val m = bench()
    val part = m.panels[0].part

    m.run(1e-3, 10)
    m.panels[0].choices[0].chosen.set(1)
    assert(m.sync())
    assert(osc(m).form == Waveform.Square)
    assert(m.s.circuit.parts[usize(part)].kind == Generator(osc(m).wave(), 50.0))
    assert(m.waveform_of(part) == Some(Waveform.Square))

    m.panels[0].choices[0].chosen.set(3)
    m.panels[0].knobs[2].set(2.0)
    m.sync()
    assert(m.s.circuit.parts[usize(part)].kind == Generator(Dc(2.0), 50.0))

    // A dc generator charges the capacitor to its offset.
    m.run(5e-3, 10)
    assert((m.reading(m.meters[0]) - 2.0).abs() < 1e-3)

@test("a frame hands over a turned knob even with the clock paused, and the clock stays where it was")
paused_frame_syncs()
    val m = bench()
    val part = m.panels[0].part

    m.running = false
    m.panels[0].choices[0].chosen.set(2)
    tick(m, 0.1)
    assert(m.s.time == 0.0)
    assert(m.s.circuit.parts[usize(part)].kind == Generator(osc(m).wave(), 50.0))
    assert(osc(m).form == Waveform.Triangle)

@test("a restart keeps the panel's settings and starts the generator's cycle afresh")
restart_keeps_settings()
    val m = bench()
    val part = m.panels[0].part

    m.run(1.7e-3, 17)
    m.panels[0].choices[0].chosen.set(2)
    m.panels[0].knobs[0].set(500.0)
    m.sync()
    m.restart()

    val o = osc(m)

    assert(m.s.time == 0.0)
    assert(o.start == 0.0 && o.phase == 0.0)
    assert(o.form == Waveform.Triangle && close(o.frequency, 500.0))
    assert(m.s.circuit.parts[usize(part)].kind == Generator(o.wave(), 50.0))
    assert(!m.sync())

@test("the generator's label and the status line give its present settings")
generator_status()
    val m = bench()

    m.select(m.sch.find("G1").unwrap())
    assert(m.panels[0].summary() == "sine 1kHz 1V")
    assert(status(m).contains("G1 sine 1kHz 1V signal generator: "))

    m.panels[0].choices[0].chosen.set(1)
    m.panels[0].knobs[0].set(20e3)
    m.panels[0].knobs[2].set(-0.5)
    m.sync()
    assert(m.panels[0].summary() == "square 20kHz 1V -500mV offset")

    m.panels[0].choices[0].chosen.set(3)
    m.sync()
    assert(m.panels[0].summary() == "dc -500mV offset")

val SUPPLY = """
    supply   P1  0 0  0 6  12 1
    resistor RL  0 0  6 0  100
    wire         6 0  6 6
    wire         6 6  0 6
    ground       0 6
    """

private supply_bench() -> &Model = model("supply.amber", parse_schematic(SUPPLY).unwrap())

@test("a supply has a panel set as its line says, and its status line shows its mode")
supply_panel_as_its_line_says()
    val m = supply_bench()

    assert(m.panels.len() == 1)
    assert(m.panels[0].title == "P1 power supply")
    assert(m.panels[0].summary() == "12V 1A")
    assert(m.panels[0].choices[0].chosen.read() == 0)
    assert(close(m.panels[0].knobs[0].value(), 12.0))
    assert(close(m.panels[0].knobs[1].value(), 1.0))

    m.select(0)
    assert(m.open_panel() == Some(0))
    assert(status(m).contains("P1 12V 1A power supply in CV: 12V across"))

@test("turning a supply's limit below what the load draws puts it in CC while the clock runs")
supply_limit_turned_down()
    val m = supply_bench()
    val part = m.panels[0].part

    m.run(1e-3, 5)
    assert(!m.s.current_limited(part))

    // 12 V into 100 Ω would be 120 mA; limited to 50 mA it gives 5 V.
    m.panels[0].knobs[1].set(50e-3)
    assert(m.sync())
    m.run(1e-3, 5)
    assert(m.s.current_limited(part))
    assert((m.s.across(part) - 5.0).abs() < 1e-3)
    m.select(0)
    assert(status(m).contains("power supply in CC"))

@test("a supply switched to raw on its panel ripples at twice the mains it is set to")
supply_switched_to_raw()
    val m = supply_bench()
    val part = m.panels[0].part

    m.panels[0].choices[0].chosen.set(1)
    m.panels[0].choices[1].chosen.set(1)
    m.panels[0].knobs[2].set(2.0)
    assert(m.sync())
    assert(m.panels[0].summary() == "12V 1A raw 2V 120Hz")

    val w = m.s.circuit.parts[usize(part)].kind.wave().unwrap()

    assert(close(w.at(0.2 / 120.0), 13.0) && close(w.at(1.0 / 120.0), 11.0))

    // A ripple deeper than twice the voltage is held to it.
    m.panels[0].knobs[0].set(0.5)
    m.sync()
    assert(m.panels[0].summary() == "500mV 1A raw 1V 120Hz")

// --- Current that alternates ------------------------------------------------------------------------

// A generator driving a resistor, whose current is its sine and passes through zero every half
// millisecond; and beside it an open switch in front of a second resistor, which carries nothing.
val SWING = """
    speed 1m
    gen       G1  0 0  0 4  sine 1k 1
    resistor  R1  0 0  4 0  1k
    wire          4 0  4 4
    wire          4 4  0 4
    ground        0 4
    switch    S1  4 0  8 0
    resistor  R2  8 0  8 4  1k
    wire          8 4  4 4
    """

@test("a hold remembers a current each way, fading, and says an alternating one is carrying at zero")
hold_through_zero()
    var h = Hold(0.0, 0.0)

    h.see(2e-3, 1.0)
    assert(!h.alternating(2e-3))
    // A current that only goes one way moves exactly as it always did, and stops below a trickle.
    assert(h.speed(1e-3, 2e-3) == dot_speed(1e-3, 2e-3))
    assert(!h.carrying(1e-8, 2e-3) && h.speed(1e-8, 2e-3) == 0.0)

    h.see(-1e-3, 0.5)
    assert(h.forward == 1e-3 && h.back == 1e-3)
    assert(h.alternating(2e-3))

    // Through zero its speed passes smoothly: small, nothing, and small the other way.
    assert(h.carrying(0.0, 2e-3) && h.carrying(1e-9, 2e-3))
    assert(h.speed(0.0, 2e-3) == 0.0)
    assert(h.speed(1e-9, 2e-3) > 0.0 && h.speed(-1e-9, 2e-3) < 0.0)
    assert(h.speed(1e-9, 2e-3) == -h.speed(-1e-9, 2e-3))
    // Measured against the most it has carried lately, so its peak moves the dots at full speed.
    assert(h.speed(1e-3, 2e-3) == 3.0)

    // What was held fades away, and the current is then a one-way trickle again.
    for _ in 0..<40
        h.see(0.0, 0.5)

    assert(!h.alternating(2e-3) && !h.carrying(0.0, 2e-3))

@test("an alternating current stays drawn as carrying through its zero crossings, and its dots rock back and forth")
alternating_dots_rock()
    val m = model("swing.amber", parse_schematic(SWING).unwrap())
    val r1 = usize(m.sch.find("R1").unwrap())
    var moves: Buf[real] = buf()

    // A first cycle, to see the current go both ways: until it has, a current passing through zero is
    // not yet known to alternate.
    for _ in 0..<20
        tick(m, 0.05)

    // Twenty frames of fifty microseconds: one whole cycle of the sine.
    for k in 1..20
        val before = m.part_flow[r1]

        tick(m, 0.05)
        moves.push(m.part_flow[r1] - before)

        val amps = m.s.current(m.sch.elements[r1].part)
        val wires = m.sch.segment_currents(m.s)

        assert(m.part_hold[r1].carrying(amps, m.most_amps))

        for g in 0..<m.sch.segments.len()
            val e = m.sch.elements[usize(m.sch.segments[g].element)]

            if e.y1 == 4 && e.x1 == 4 && e.x2 == 0 then assert(m.segment_hold[g].carrying(wires[g], m.most_amps))

        // At the half cycle the current is next to nothing: once it would have vanished.
        if k == 10
            assert(amps.abs() < 1e-4 * m.most_amps)
            assert(dot_speed(amps, m.most_amps) == 0.0)

    // The dots go one way for the first half cycle and back the other way for the second.
    val first = if moves[0] > 0.0 then 1.0 else -1.0

    for k in 0..<9
        assert(moves[k] * first > 0.0)
        assert(moves[k + 10] * first < 0.0)

@test("a branch behind an open switch never carries, beside one that alternates")
open_branch_idle()
    val m = model("swing.amber", parse_schematic(SWING).unwrap())
    val s1 = usize(m.sch.find("S1").unwrap())
    val r2 = usize(m.sch.find("R2").unwrap())

    for _ in 0..<20
        tick(m, 0.05)

        for i in [s1, r2]
            assert(!m.part_hold[i].carrying(m.s.current(m.sch.elements[i].part), m.most_amps))
            assert(m.part_flow[i] == 0.0)

// --- Starting settled ---------------------------------------------------------------------------------

val CHARGE = """
    speed 1
    battery   B1  0 0  0 6  9V
    resistor  R1  0 0  7 0  10k
    capacitor C1  7 0  7 6  100u
    wire          7 6  0 6
    ground        0 6
    meter     M1  7 0  7 6
    """

@test("s starts the circuit again settled at its operating point; r starts it again as the file says")
settle_key()
    val m = model("charge.amber", parse_schematic(CHARGE).unwrap())

    assert(m.reading(m.meters[0]).abs() < 1e-9)
    tick(m, 0.1)
    assert(press(m, SCANCODE_S))
    assert(m.s.time == 0.0 && m.meters[0].times.len() == 1)
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)

    // Settled, it stays where it is.
    tick(m, 0.1)
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)

    assert(press(m, SCANCODE_R))
    assert(m.s.time == 0.0 && m.reading(m.meters[0]).abs() < 1e-9)

@test("a file that says start settled starts settled, and r starts it settled again")
settled_file()
    val m = model("charge.amber", parse_schematic(s"start settled\n${CHARGE}").unwrap())

    assert(m.sch.settled)
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)
    m.running = false
    m.restart()
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)
    assert(press(m, SCANCODE_R))
    assert((m.reading(m.meters[0]) - 9.0).abs() < 1e-6)

// --- The scope's scales -------------------------------------------------------------------------------

// Whether `x` is 1, 2 or 5 times a power of ten.
private one_two_five(x: real) -> bool
    val m = x / 10.0.pow(x.log10().floor())

    for want in [1.0, 2.0, 5.0, 10.0]
        if (m - want).abs() < 1e-9 then return true

    false

@test("a division's worth is the smallest step of 1, 2 and 5 times a power of ten that fits")
steps_one_two_five()
    assert(close(step_125(1.0), 1.0))
    assert(close(step_125(1.01), 2.0))
    assert(close(step_125(2.0), 2.0))
    assert(close(step_125(3.0), 5.0))
    assert(close(step_125(5.5), 10.0))
    assert(close(step_125(0.0042), 0.005))
    assert(close(step_125(0.001), 0.001))
    assert(close(step_125(170.0), 200.0))

@test("two channels of very different size each fill most of the scope's height, at 1-2-5 volts a division")
channels_scale_alone()
    for (lo, hi) in [(-10e-3, 10e-3), (-2.5, 2.5), (6.77, 7.23), (0.0, 9.0), (-0.3, 0.05), (1.0, 1.0), (0.0, 0.0)]
        val (centre, per_div) = channel_scale(lo, hi)
        val height = 5.0 * per_div

        assert(one_two_five(per_div))
        // Nothing runs off the top or the bottom.
        assert(hi <= centre + height / 2.0 && lo >= centre - height / 2.0)

    // A 10 mV sine and a 2.5 V one, the amplifier's input and something two hundred times larger.
    val (small_centre, small) = channel_scale(-10e-3, 10e-3)
    val (_, large) = channel_scale(-2.5, 2.5)

    assert(small_centre == 0.0)
    assert(close(small, 5e-3) && close(large, 2.0))
    assert(20e-3 / (5.0 * small) > 0.75 && 5.0 / (5.0 * large) >= 0.5)

    // The amplifier's collector, a swing on a bias: centred on the swing, not on zero.
    val (centre, per_div) = channel_scale(6.77, 7.23)

    assert(close(per_div, 0.1) && (centre - 7.0).abs() < 0.02)

    // A steady 9 V is a flat line in the middle rather than its rounding errors blown up.
    assert(close(channel_scale(9.0, 9.0).1, 0.1))

@test("a drawing too crowded for every label keeps the names of what a person clicks or looks for")
crowded_labels()
    for shape in [Shape.Switch, Shape.Led, Shape.Battery, Shape.Source, Shape.Generator, Shape.Supply, Shape.Winding]
        assert(labelled_when_crowded(shape))

    for shape in [Shape.Resistor, Shape.Capacitor, Shape.Inductor, Shape.Diode, Shape.Zener, Shape.Npn, Shape.Pmos]
        assert(!labelled_when_crowded(shape))

@test("the legend gives a swinging channel's swing from top to bottom, so two channels' sizes compare, and a steady one's voltage")
legend_swing()
    // The amplifier's input and output: drawn the same size, told apart by the legend.
    assert(legend_value(-10e-3, 10e-3, 3e-3) == "20mV p-p")
    assert(legend_value(-0.68, 0.66, -0.2) == "1.34V p-p")
    // A swing on a bias is still a swing.
    assert(legend_value(6.0, 7.3, 6.5) == "1.3V p-p")
    // A small swing on a large bias, a first stage's output on its base's 2 V, is a swing.
    assert(legend_value(2.04, 2.12, 2.08) == "80mV p-p")
    // A steady 9 V, its rounding, a regulated 5 V's ripple, and a channel reading nothing give the
    // voltage.
    assert(legend_value(9.0, 9.0, 9.0) == "9V")
    assert(legend_value(8.99, 9.01, 9.0) == "9V")
    assert(legend_value(5.165, 5.175, 5.17) == "5.17V")
    assert(legend_value(0.0, 0.5e-3, 0.2e-3) == "200µV")
    // A millivolt's swing about zero is the least that counts.
    assert(legend_value(-0.5e-3, 0.6e-3, 0.0) == "1.1mV p-p")

@test("a channel's reach is what its meter read within the window")
channel_reach()
    val m = bench()

    m.run(2e-3, 200)

    val mt = m.meters[0]
    val (lo, hi) = reach(mt, 1e-3)

    assert(lo < 0.0 && hi > 0.0)
    assert(reach(mt, 1.0) == (0.0, 0.0))

    for j in 0..<mt.times.len()
        if mt.times[j] >= 1e-3 then assert(mt.readings[j] >= lo && mt.readings[j] <= hi)

// --- The Bode plot ----------------------------------------------------------------------------------

// The bench's R1 and C1 behind the generator's 50 Ω: a low-pass with its corner at 1/(2π · 1050 Ω ·
// 100 nF), about 1.5 kHz.
private bench_response(f: real) -> (real, real)
    val x = 2.0 * real.pi() * f * 1050.0 * 100e-9

    (-10.0 * (1.0 + x * x).log10(), -x.atan().to_degrees())

@test("the Bode plot is each meter's gain and phase from the generator, at every frequency and at its own")
bode_of_the_bench()
    val m = bench()

    m.refresh_bode()

    val b = m.bode

    assert(b.trouble == "" && b.source == "G1" && b.marker == 1e3)
    // From 1 Hz to 10 MHz, twenty a decade, both ends included.
    assert(b.hertz.len() == 141 && b.hertz[0] == 1.0 && (b.hertz[140] - 1e7).abs() < 1e-3)
    assert(b.curves.len() == 1)

    val c = b.curves[0]

    for k in [0, 60, 66, 80, 140]
        val (gain, phase) = bench_response(b.hertz[k])

        assert((c.gain[k] - gain).abs() < 1e-6)
        assert((c.phase[k] - phase).abs() < 1e-6)

    val (gain, phase) = bench_response(1e3)

    assert((c.marked_gain - gain).abs() < 1e-6 && (c.marked_phase - phase).abs() < 1e-6)
    assert(c.colour == m.meters[0].colour)

@test("b shows the Bode plot in place of the scope, and it is worked out again when the circuit or its meters change")
bode_follows_changes()
    val m = bench()

    assert(!m.showing_bode)
    assert(press(m, SCANCODE_B))
    assert(m.showing_bode)
    m.refresh_bode()
    assert(!m.bode_stale && m.bode.marker == 1e3)

    // The generator turned to 2 kHz: the plot marks it there.
    m.panels[0].knobs[0].set(2e3)
    tick(m, 0.01)
    assert(m.bode_stale)
    m.refresh_bode()
    assert(close(m.bode.marker, 2e3) && m.bode.marker == osc(m).frequency)

    // A second meter, across the resistor, is a second curve: a high-pass, reaching the 1000/1050 of the
    // generator's volt its 50 Ω leaves, 0.42 dB down.
    m.add_meter(0, 0, 4, 0)
    m.refresh_bode()
    assert(m.bode.curves.len() == 2)
    assert((m.bode.curves[1].gain[140] - 20.0 * (1000.0 / 1050.0).log10()).abs() < 1e-3)
    assert(m.bode.curves[1].gain[0] < -60.0)

    // Cleared, there is nothing to plot, and the plot says so.
    press(m, SCANCODE_C)
    m.refresh_bode()
    assert(m.bode.trouble == "put a meter across two points to see its gain and phase here")
    assert(press(m, SCANCODE_B) && !m.showing_bode)

@test("a square wave's frequency is marked and the operating point is found at its middle; a circuit with nothing to drive it says so")
bode_square_and_undriven()
    val m = bench()

    m.panels[0].choices[0].chosen.set(1)
    m.panels[0].knobs[2].set(1.0)
    m.sync()
    m.refresh_bode()
    assert(m.bode.marker == 1e3 && m.bode.trouble == "")
    // A dc generator repeats at no frequency: nothing is marked.
    m.panels[0].choices[0].chosen.set(3)
    m.sync()
    m.refresh_bode()
    assert(m.bode.marker == 0.0 && m.bode.curves.len() == 1)

    val led = led_model()

    led.refresh_bode()
    assert(led.bode.trouble == "a Bode plot needs a signal generator or a source to drive the circuit")

@test("the gain axis reaches 60 dB below the top at 1-2-5 decibels a division, and figures read as a person writes them")
bode_axis_and_figures()
    val flat = Curve(0, buf(), buf(), 0.0, 0.0)

    flat.gain.push(27.1)
    flat.gain.push(-200.0)
    // 60 dB below 27.1 needs 20 dB a division over four; the top clears the highest point.
    assert(bode_scale([flat][..]) == (40.0, 20.0))

    val narrow = Curve(0, buf(), buf(), 0.0, 0.0)

    narrow.gain.push(-0.2)
    narrow.gain.push(-3.0)
    assert(bode_scale([narrow][..]) == (0.0, 1.0))
    assert(bode_scale([][..]) == (20.0, 10.0))

    assert(figure(27.14) == "27.1")
    assert(figure(-0.04) == "0.0")
    assert(figure(-166.83) == "−166.8")
    assert(figure(-40.0, whole = true) == "−40")
    assert(figure(180.0, whole = true) == "180")

// --- The speaker ------------------------------------------------------------------------------------

private phase_shift() -> &Model = model("oscillator.amber", parse_schematic(str_cast(embed("../examples/oscillator.amber"))).unwrap())

// How many times the samples `heard` cross from below zero to above it, from sample `from` on.
private rises(heard: Buf[f32], from: usize) -> int
    var n = 0

    for k in from + 1..<heard.len()
        if heard[k - 1] < 0.0 && heard[k] >= 0.0 then n += 1

    n

@test("the oscillator example starts from nothing and plays about 530 Hz through its speaker, a sample every 1/48000 s")
oscillator_sounds()
    val m = phase_shift()

    assert(m.ear.speaker >= 0 && m.hearing())

    // Three seconds, a frame at a time: the thump of switching on has faded from the levelling by then.
    for _ in 0..<180
        m.run(1.0 / 60.0, 8)

    // Three seconds at 48 kHz.
    assert(m.ear.heard.len() >= 143990 && m.ear.heard.len() <= 144010)

    // Over its last quarter second, settled: a tone of about 530 Hz, filling the levelled range.
    val from = m.ear.heard.len() - 12000
    val hz = real(rises(m.ear.heard, from)) * 4.0
    var loudest = 0.0

    for k in from..<m.ear.heard.len()
        loudest = max(loudest, real(m.ear.heard[k]).abs())

    assert(hz > 480.0 && hz < 580.0)
    assert(loudest > 0.4 && loudest <= 1.0)

@test("the speaker is silent at any speed but a second a second, when muted, and when paused")
speaker_only_in_real_time()
    val m = phase_shift()

    press(m, SCANCODE_M)
    assert(!m.hearing() && m.ear.muted)
    m.run(0.01, 8)
    assert(m.ear.heard.len() == 0)
    assert(status(m).contains("speaker muted"))

    press(m, SCANCODE_M)
    assert(m.hearing())
    press(m, SCANCODE_MINUS)
    assert(!m.hearing())
    assert(status(m).contains("speaker plays at 1s a second"))
    m.run(0.01, 8)
    assert(m.ear.heard.len() == 0)

    press(m, SCANCODE_EQUALS)
    press(m, SCANCODE_SPACE)
    assert(!m.hearing())

    // A circuit with no speaker has nothing to hear.
    assert(!led_model().hearing() && led_model().ear.speaker == -1)

@test("the speaker's levelling: DC taken off, a swing scaled to half of full scale, and rounding left silent")
speaker_levels()
    var e = ear(0)

    // A 1 kHz sine of 2 V on 5 V of DC, a second of it: its last cycle swings about ±0.5.
    var hi = -1.0
    var lo = 1.0

    for k in 0..<48000
        val v = 5.0 + 2.0 * (tau * 1000.0 * real(k) / 48000.0).sin()
        val x = real(e.hear(v))

        if k >= 47952
            hi = max(hi, x)
            lo = min(lo, x)

    assert(hi > 0.45 && hi < 0.55 && lo < -0.45 && lo > -0.55)

    // A wobble of a microvolt is all but silent.
    var quiet = ear(0)
    var most = 0.0

    for k in 0..<4800
        most = max(most, real(quiet.hear(1.0 + 1e-6 * (tau * 440.0 * real(k) / 48000.0).sin())).abs())

    assert(most < 1e-4)
