// What the viewer knows: the circuit and its simulation, the clock, the meters and what they have read.

import sh.sysl.amber.{Schematic, Element, Shape, Sim, Colour, Switch, Waveform, sim, engineering, parse_generator}
import sh.sysl.ui_sdl.stop
import sh.sysl.sdl3.{Event, EventKind, SCANCODE_ESCAPE, SCANCODE_C, SCANCODE_V, SCANCODE_SPACE, SCANCODE_R, SCANCODE_S,
                     SCANCODE_EQUALS, SCANCODE_MINUS, SCANCODE_KP_PLUS, SCANCODE_KP_MINUS}
import sh.sysl.plutovg
import sh.sysl.ui.Rect
import sysl.buf.{Buf, buf}
import sysl.math.{max, min}
import sysl.text.fields

// Seconds of the circuit's time a second of the window's may show, slowest first; `+` and `-` move
// along them.
val SPEEDS = [1e-6, 2e-6, 5e-6, 1e-5, 2e-5, 5e-5, 1e-4, 2e-4, 5e-4, 1e-3, 2e-3, 5e-3, 1e-2, 2e-2, 5e-2,
              0.1, 0.2, 0.5, 1.0, 2.0, 5.0, 10.0]

// How many solutions a frame samples for the meters: the scope's resolution.
const SAMPLES_PER_FRAME: int = 8

// How many seconds of the window's time the scope shows.
const SCOPE_SECONDS: real = 5.0

// How many seconds of the window's time what a branch has carried takes to fade by a factor of e.
const HOLD_SECONDS: real = 1.0

// The colours meters are drawn in, one each, in the order they were placed.
val METER_COLOURS = [0xFFB030, 0x4FD1E8, 0xE86FD8, 0x9BE15D, 0xFF6B6B, 0xB79CFF]

// A voltmeter: its red lead on one grid point and its black lead on another, and what it has read.
struct Meter
    name: string
    x1: int
    y1: int
    x2: int
    y2: int
    colour: u32
    // Times and readings, oldest first.
    times: Buf[real]
    readings: Buf[real]

    // Remember a reading at time `t`, dropping the older half once there are many.
    record(*self, t: real, v: real)
        if self.times.len() >= 8192
            var times: Buf[real] = buf()
            var readings: Buf[real] = buf()

            for k in 4096..<self.times.len()
                times.push(self.times[k])
                readings.push(self.readings[k])

            self.times = times
            self.readings = readings

        self.times.push(t)
        self.readings.push(v)

    forget(*self)
        self.times.clear()
        self.readings.clear()

// A picture drawn with PlutoVG and handed to the canvas, kept from frame to frame and remade when its
// size changes.
struct Picture
    surface: Option[&plutovg.Surface]
    pen: Option[&plutovg.Canvas]

    // The canvas to draw into for a rectangle `r` at `scale` device pixels a point, cleared.
    fit(*self, r: Rect, scale: real) -> Option[&plutovg.Canvas]
        val w = max(1, int(real(r.w) * scale))
        val h = max(1, int(real(r.h) * scale))
        val fits = self.surface match
            Some(p) -> p.width() == w && p.height() == h
            None -> false

        if !fits
            self.pen = None
            self.surface = plutovg.surface(w, h)

            if self.surface is Some(p) then self.pen = plutovg.canvas(p)

        self.surface match
            Some(p) -> p.clear(0.0, 0.0, 0.0, 0.0)
            None -> ()

        self.pen

struct Model
    file: string
    sch: Schematic
    s: Sim
    // Why the circuit could not be solved, or "".
    trouble: string
    meters: Buf[Meter]
    // Where the red lead of the meter being placed is, while it waits for its black one.
    probing: bool
    px: int
    py: int
    // The element clicked, or -1.
    selected: int
    // Whether every part is labelled with the voltage across it.
    values: bool
    running: bool
    // Which of `SPEEDS` the clock runs at.
    speed: int
    // How far along its length the current dots on each wire segment and each part have moved, in grid
    // squares. A transistor's `part_flow` is its collector's, and its base's and emitter's are beside
    // it.
    segment_flow: Buf[real]
    part_flow: Buf[real]
    base_flow: Buf[real]
    emitter_flow: Buf[real]
    // What each of those has carried lately, each way, so a current that alternates is still drawn as
    // flowing while it passes through zero.
    segment_hold: Buf[Hold]
    part_hold: Buf[Hold]
    base_hold: Buf[Hold]
    emitter_hold: Buf[Hold]
    // The circuit's time the holds were last brought up to.
    held_at: real
    // The largest current any part has carried since the circuit was switched on: the dots move at a
    // speed in proportion to it, so a current dying away is seen to slow.
    most_amps: real
    board: Picture
    scope: Picture
    // The controls of every part that has settings to turn, one panel each, kept while the circuit
    // runs and across a restart.
    panels: Buf[Panel]

    // A click on element `i`, or on nothing for -1: it is selected, a switch flips, and a part with
    // settings shows its panel.
    select(*self, i: int)
        self.selected = i

        if i >= 0 then self.toggle(i)

    // The panel of element `i`, if it has one.
    panel_of(self, i: int) -> Option[usize]
        for k in 0..<self.panels.len()
            if self.panels[k].element == i then return Some(k)

        None

    // The panel showing: the selected element's, if it has one.
    open_panel(self) -> Option[usize] = if self.selected < 0 then None else self.panel_of(self.selected)

    // Hand any setting turned since the last frame to the circuit, from its present time; whether
    // one was.
    sync(*self) -> bool
        var any = false

        for k in 0..<self.panels.len()
            if self.panels[k].sync(&self.s) then any = true

        any

    // The waveform part `part` is putting out, if it is a signal generator.
    waveform_of(self, part: int) -> Option[Waveform]
        for k in 0..<self.panels.len()
            if self.panels[k].part == part
                return self.panels[k].instrument match
                    SignalGenerator(o) -> Some(o.form)

        None

    // A click at grid point (`x`, `y`): a meter's lead if a node is there.
    probe(*self, x: int, y: int) -> bool
        if self.sch.node_at(x, y).is_none() then return false

        if !self.probing
            self.probing = true
            self.px = x
            self.py = y
        else
            self.probing = false

            if x != self.px || y != self.py then self.add_meter(self.px, self.py, x, y)

        true

    // Put a meter across two grid points, called `name`, or `M` and the next free number for "".
    add_meter(*self, x1: int, y1: int, x2: int, y2: int, name: string = "")
        val colour = u32(METER_COLOURS[self.meters.len() % METER_COLOURS.len])
        var called = name
        var n = 0

        while called == "" || self.meter_named(called)
            n += 1
            called = s"M${n}"

        self.meters.push(Meter(called, x1, y1, x2, y2, colour, buf(), buf()))

    private meter_named(self, name: string) -> bool
        for k in 0..<self.meters.len()
            if self.meters[k].name == name then return true

        false

    // The voltage at grid point (`x`, `y`).
    volts_at(self, x: int, y: int) -> real = self.sch.node_at(x, y) match
        Some(n) -> self.s.voltage(n)
        None -> 0.0

    reading(self, m: Meter) -> real = self.volts_at(m.x1, m.y1) - self.volts_at(m.x2, m.y2)

    // The circuit's time a second of the window's shows.
    pace(self) -> real = SPEEDS[usize(self.speed)]

    // The span of the circuit's time the scope shows.
    window(self) -> real = SCOPE_SECONDS * self.pace()

    // Open or close the switch that element `i` is.
    toggle(*self, i: int)
        val e = self.sch.elements[usize(i)]

        if e.shape != Shape.Switch then return

        val closed = self.s.circuit.parts[usize(e.part)].kind == Switch(true)

        self.s.set_switch(e.part, !closed)

    // Start the circuit again the way its file says, forgetting what the meters read.
    restart(*self) = self.start(self.sch.settled)

    // Start the circuit again, forgetting what the meters read: `settled` at its DC operating point,
    // every capacitor charged and every inductor's current steady, or else switched on from empty.
    start(*self, settled: bool)
        self.s = sim(self.sch.circuit)
        self.trouble = ""
        self.most_amps = 0.0
        self.held_at = 0.0

        forget(&self.segment_hold)
        forget(&self.part_hold)
        forget(&self.base_hold)
        forget(&self.emitter_hold)

        for k in 0..<self.meters.len()
            self.meters[k].forget()

        // The instruments keep their settings: the circuit is started again with them as they are.
        for k in 0..<self.panels.len()
            self.panels[k].apply(&self.s, true)

        if (if settled then self.s.operating_point() else self.s.power_on()) is Err(why)
            self.trouble = why
            return

        self.sample()

    // Run the circuit's clock forward by `span`, sampling the meters `samples` times on the way.
    run(*self, span: real, samples: int)
        if self.trouble != "" then return

        val start = self.s.time

        for k in 1..samples
            if self.s.advance_to(start + span * real(k) / real(samples)) is Err(why)
                self.trouble = why
                self.running = false
                return

            self.sample()

    // Record every meter's reading now.
    private sample(*self)
        for k in 0..<self.meters.len()
            val v = self.reading(self.meters[k])

            self.meters[k].record(self.s.time, v)

        for i in 0..<self.sch.elements.len()
            val e = self.sch.elements[i]

            if e.part >= 0 then self.most_amps = max(self.most_amps, self.s.current(e.part).abs())

            // A transistor's emitter carries the most: its collector's current and its base's.
            if e.part >= 0 && e.shape.points() == 3
                self.most_amps = max(self.most_amps, self.s.terminal_current(e.part, 2).abs())

        // What was held fades by a factor of e in HOLD_SECONDS of the window's time.
        val keep = (-(self.s.time - self.held_at) / (HOLD_SECONDS * self.pace())).exp()
        val amps = self.sch.segment_currents(self.s)

        self.held_at = self.s.time

        for k in 0..<amps.len()
            self.segment_hold[k].see(amps[k], keep)

        for i in 0..<self.sch.elements.len()
            val e = self.sch.elements[i]

            if e.part >= 0 then self.part_hold[i].see(self.s.current(e.part), keep)

            if e.part >= 0 && e.shape.points() == 3
                self.base_hold[i].see(self.s.terminal_current(e.part, 1), keep)
                self.emitter_hold[i].see(self.s.terminal_current(e.part, 2), keep)

    // Move the current dots on by `dt` seconds of the window's time.
    flow(*self, dt: real)
        if self.trouble != "" then return

        val most = self.most_amps
        val amps = self.sch.segment_currents(self.s)

        for k in 0..<amps.len()
            self.segment_flow[k] += dt * self.segment_hold[k].speed(amps[k], most)

        for i in 0..<self.sch.elements.len()
            val e = self.sch.elements[i]

            if e.part >= 0 then self.part_flow[i] += dt * self.part_hold[i].speed(self.s.current(e.part), most)

            // The base's current flows in toward the bar, and the emitter's out of it: the current into
            // the emitter, turned round.
            if e.part >= 0 && e.shape.points() == 3
                self.base_flow[i] += dt * self.base_hold[i].speed(self.s.terminal_current(e.part, 1), most)
                self.emitter_flow[i] -= dt * self.emitter_hold[i].speed(self.s.terminal_current(e.part, 2), most)
end Model

// What a branch has carried lately: the largest current it has carried each way, each fading as time
// goes on. A current that alternates passes through zero twice a cycle; what it carried a moment ago
// says it is still flowing, and its dots slow, stop and come back the other way rather than vanish.
struct Hold
    forward: real
    back: real

    // Take in a current of `amps`, after what was held has faded to `keep` of itself.
    see(*self, amps: real, keep: real)
        self.forward = max(amps, self.forward * keep)
        self.back = max(-amps, self.back * keep)

    // Whether the current has lately gone both ways, each more than a trickle beside `most`.
    alternating(self, most: real) -> bool = self.forward >= trickle(most) && self.back >= trickle(most)

    // Whether a branch now carrying `amps` is drawn as carrying current: a current more than a trickle,
    // or one that alternates.
    carrying(self, amps: real, most: real) -> bool = amps.abs() >= trickle(most) || self.alternating(most)

    // How fast its dots move for a current of `amps`, in grid squares a second. A current that only
    // goes one way moves them as `dot_speed` says. One that alternates passes through zero smoothly,
    // and is measured against the most it has carried lately rather than the most the circuit has, so
    // a small signal beside a large bias still rocks its dots to and fro where they can be seen.
    speed(self, amps: real, most: real) -> real
        if !self.alternating(most) then return dot_speed(amps, most)

        3.0 * amps / min(most, max(self.forward, self.back))

// Every hold in `holds` emptied.
private forget(holds: *Buf[Hold])
    for k in 0..<holds.len()
        holds[k] = Hold(0.0, 0.0)

// The smallest current that moves dots: a ten-thousandth of the largest the circuit has carried, and
// never less than a nanoamp.
private trickle(most: real) -> real = max(1e-9, 1e-4 * most)

// How fast dots move for a current of `amps`, in grid squares a second: three at the largest current
// the circuit has carried, and none for a current too small to matter.
dot_speed(amps: real, most: real) -> real
    if amps.abs() < trickle(most) then return 0.0

    3.0 * amps / most

model(file: string, sch: Schematic) -> &Model
    var flows: Buf[real] = buf()
    var parts: Buf[real] = buf()
    var bases: Buf[real] = buf()
    var emitters: Buf[real] = buf()
    var held_segments: Buf[Hold] = buf()
    var held_parts: Buf[Hold] = buf()
    var held_bases: Buf[Hold] = buf()
    var held_emitters: Buf[Hold] = buf()

    for _ in 0..<sch.segments.len()
        flows.push(0.0)
        held_segments.push(Hold(0.0, 0.0))

    for _ in 0..<sch.elements.len()
        parts.push(0.0)
        bases.push(0.0)
        emitters.push(0.0)
        held_parts.push(Hold(0.0, 0.0))
        held_bases.push(Hold(0.0, 0.0))
        held_emitters.push(Hold(0.0, 0.0))

    val m: &Model = Model(file, sch, sim(sch.circuit), "", buf(), false, 0, 0, -1, true, true, speed_index(sch.speed), flows,
                  parts, bases, emitters, held_segments, held_parts, held_bases, held_emitters, 0.0, 0.0,
                  Picture(None, None), Picture(None, None), panels(sch))

    // The meters the file places are the first ones.
    for i in 0..<sch.elements.len()
        val e = sch.elements[i]

        if e.shape == Shape.Meter then m.add_meter(e.x1, e.y1, e.x2, e.y2, e.name)

    m.restart()
    m

// A panel for every part of `sch` with settings to turn: each signal generator, set as its line says.
private panels(sch: Schematic) -> Buf[Panel]
    var out: Buf[Panel] = buf()

    for i in 0..<sch.elements.len()
        val e = sch.elements[i]

        if e.shape == Shape.Generator
            // The line was read when the schematic was, so it reads again.
            val (osc, _) = parse_generator(fields(e.value)).unwrap()

            out.push(generator_panel(e.name, int(i), e.part, osc))

    out

// The speed nearest `seconds` a second, real time if the file does not say.
private speed_index(seconds: real) -> int
    val want = if seconds > 0.0 then seconds else 1.0
    var best = 0

    for k in 0..<SPEEDS.len
        if (SPEEDS[k] / want).ln().abs() < (SPEEDS[usize(best)] / want).ln().abs() then best = int(k)

    best

// What a frame does on its own: run the clock by the frame's share of the speed.
tick(m: &Model, dt: real)
    m.sync()

    if !m.running then return

    // A frame late by more than a tenth of a second does not owe the time it lost.
    val step = min(dt, 0.1)

    m.run(step * m.pace(), SAMPLES_PER_FRAME)
    m.flow(step)

// The keyboard's shortcuts.
shortcut(m: &Model, e: Event) -> bool
    if e.kind() != EventKind.KeyDown then return false

    press(m, e.key_scancode())

// The key with scancode `key` pressed: whether it is one of the shortcuts.
press(m: &Model, key: i32) -> bool
    if key == SCANCODE_ESCAPE
        if m.probing then m.probing = false else stop()
    elif key == SCANCODE_C
        m.meters.clear()
        m.probing = false
    elif key == SCANCODE_V
        m.values = !m.values
    elif key == SCANCODE_SPACE
        m.running = !m.running
    elif key == SCANCODE_R
        m.restart()
    elif key == SCANCODE_S
        m.start(true)
    elif key == SCANCODE_EQUALS || key == SCANCODE_KP_PLUS
        m.speed = min(int(SPEEDS.len) - 1, m.speed + 1)
    elif key == SCANCODE_MINUS || key == SCANCODE_KP_MINUS
        m.speed = max(0, m.speed - 1)
    else
        return false

    true

// The line under the board: the clock, and what was clicked or why nothing could be solved.
status(m: &Model) -> string
    val clock = s"t = ${engineering(m.s.time)}s · ${engineering(m.pace())}s a second · ${if m.running then "running" else "paused"}"

    if m.trouble != "" then return s"${clock} · cannot solve: ${m.trouble}"

    if m.probing then return s"${clock} · red lead at ${m.px}, ${m.py} (${volts(m.volts_at(m.px, m.py))}) — click where the black lead goes"

    if m.selected < 0 then return clock

    val e = m.sch.elements[usize(m.selected)]

    if e.part < 0 then return s"${clock} · ${e.name}"

    if e.shape == Shape.Nmos || e.shape == Shape.Pmos
        val vgs = m.s.voltage(e.b) - m.s.voltage(e.c)
        val id = m.s.terminal_current(e.part, 0)

        return s"${clock} · ${e.name} ${described(m, e)}: ${volts(m.s.across(e.part))} drain to source, ${volts(vgs)} gate to source, ${engineering(id.abs())}A ${into(id)} the drain"

    if e.shape.points() == 3
        val vbe = m.s.voltage(e.b) - m.s.voltage(e.c)
        val ic = m.s.terminal_current(e.part, 0)
        val ib = m.s.terminal_current(e.part, 1)

        return s"${clock} · ${e.name} ${described(m, e)}: ${volts(m.s.across(e.part))} collector to emitter, ${volts(vbe)} base to emitter, ${engineering(ic.abs())}A ${into(ic)} the collector, ${engineering(ib.abs())}A ${into(ib)} the base"

    val v = m.s.across(e.part)
    val i = m.s.current(e.part)
    val p = m.s.power(e.part)

    s"${clock} · ${e.name} ${described(m, e)}: ${volts(v)} across, ${engineering(i.abs())}A through, ${engineering(p.abs())}W ${if p < 0.0 then "delivered" else "taken"}"

private described(m: &Model, e: Element) -> string = e.shape match
    Resistor -> s"${e.value}Ω resistor"
    Capacitor -> s"${e.value}F capacitor"
    Inductor -> s"${e.value}H inductor"
    Battery -> s"${e.value} battery"
    Source -> s"${e.value} source"
    CurrentSource -> s"${e.value} current source"
    Generator -> m.panel_of(m.selected) match
        Some(k) -> s"${m.panels[k].summary()} signal generator"
        None -> "signal generator"
    Switch -> if m.s.circuit.parts[usize(e.part)].kind == Switch(true) then "closed switch" else "open switch"
    Diode -> "diode"
    Led -> s"${colour_name(e.colour)} LED"
    Npn -> s"${e.value} NPN transistor"
    Pnp -> s"${e.value} PNP transistor"
    Nmos -> s"${e.value} N-channel MOSFET"
    Pmos -> s"${e.value} P-channel MOSFET"
    _ -> ""

// Which way a current into a terminal goes, by its sign.
private into(amps: real) -> string = if amps < 0.0 then "out of" else "into"

colour_name(c: Colour) -> string = c match
    Red -> "red"
    Yellow -> "yellow"
    Green -> "green"
    Blue -> "blue"

volts(v: real) -> string = s"${engineering(v)}V"
