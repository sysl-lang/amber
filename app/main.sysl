// amber's viewer: a schematic in a window, its wires coloured by their voltage, and voltmeters that
// can be put across anything.
//
//     amber <file.amber>
//     amber <file.amber> --shot <out.png> [--time <seconds>] [--meter <x1>,<y1>,<x2>,<y2>]... [--select <name>] [--bode]
//
// The circuit is switched on when the window opens and its clock runs at the file's speed. Click a grid
// point to put a meter's red lead there, and a second one for its black lead; the meter reads the first
// point's voltage less the second's, and the scope under the circuit draws what it has read. Click a
// part to see the voltage across it and the current through it, a switch to flip it, and a signal
// generator to open its panel and turn its knobs while the circuit runs. `b` swaps the scope for a
// Bode plot: each meter's gain and phase against frequency, driven from the signal generator.
//
// `--shot` draws one frame with no window and writes it to a PNG, after running the circuit for
// `--time` seconds of its own, with any meters `--meter` places, the element `--select` names
// clicked, and the Bode plot showing for `--bode`, so the picture a person would see is one a machine
// can check.

import sh.sysl.amber.{parse_schematic, parse_value, engineering}
import sh.sysl.ui.{Rect, render, pluto_canvas, fraction}
import sh.sysl.ui_sdl.{app, run, system_font}
import sh.sysl.plutovg
import sysl.buf.{Buf, buf}
import sysl.fs.read_text
import sysl.text.{parse_int, split}
import sysl.sync.Atomic
import sysl.threads.Mutex
import sysl.time.monotonic

const USAGE: string = "amber <file.amber> [--shot <out.png> [--time <seconds>]] [--meter x1,y1,x2,y2]... [--select <name>] [--bode] [--bench <seconds>]"

const WIDTH: int = 1000
const HEIGHT: int = 720

main(args: []string) -> Result[unit, string]
    var file = ""
    var shot = ""
    var time = 0.0
    var chosen = ""
    var bode = false
    var bench = 0.0
    var placed: Buf[(int, int, int, int)] = buf()
    var i: usize = 1

    while i < args.len
        val a = args[i]

        if a == "--shot" && i + 1 < args.len
            shot = args[i + 1]
            i += 2
        elif a == "--time" && i + 1 < args.len
            time = parse_value(args[i + 1]).map_err(e -> s"--time: ${e}")?
            i += 2
        elif a == "--meter" && i + 1 < args.len
            placed.push(meter_option(args[i + 1])?)
            i += 2
        elif a == "--select" && i + 1 < args.len
            chosen = args[i + 1]
            i += 2
        elif a == "--bode"
            bode = true
            i += 1
        elif a == "--bench" && i + 1 < args.len
            bench = parse_value(args[i + 1]).map_err(e -> s"--bench: ${e}")?
            i += 2
        elif file == "" && !a.starts_with("--")
            file = a
            i += 1
        else
            return Err(s"usage: ${USAGE} ('${a}' is not one of these)")

    if file == "" then return Err(s"usage: ${USAGE}")

    val text = read_text(file).map_err(e -> s"${file}: ${e}")?
    val sch = parse_schematic(text).map_err(e -> s"${file}: ${e}")?
    val m = model(file, sch)

    // In the window the circuit runs on a thread of its own, from a second reading of its file, and
    // `m` is what the window draws; a picture or a measurement runs it here.
    val windowed = shot == "" && bench == 0.0

    m.remote = windowed

    for k in 0..<placed.len()
        val (x1, y1, x2, y2) = placed[k]

        m.add_meter(x1, y1, x2, y2)

    if chosen != ""
        m.select(sch.find(chosen).ok_or(s"--select: ${file} has no element called '${chosen}'")?)

    m.showing_bode = bode

    // Work out `bench` seconds of the circuit as the viewer does a frame at a time at a second a
    // second, its speaker heard, and say how many times faster than it plays that went: no window and
    // no sound, so nothing but the circuit is measured.
    if bench > 0.0
        val began = monotonic()
        var frames = 0

        m.speed = speed_index(1.0)
        m.running = true

        while m.s.time < bench && m.trouble == ""
            m.run(1.0 / 60.0, 8)
            frames += 1

        val took = real((monotonic() - began).us) * 1e-6

        print(s"${file}: ${engineering(m.s.time)}s of its sound in ${engineering(took)}s, ${m.s.time / took}× real time; ${m.s.size} unknowns, ${m.s.accepted} steps")

        if m.trouble != "" then print(s"cannot solve: ${m.trouble}")

        return Ok(())

    if windowed
        val link: &sync Link = Link(Mutex.new(model(file.copy(), parse_schematic(text).map_err(e -> s"${file}: ${e}")?)), Atomic(0))

        link.engine.with((p) -> as_engine(*p))

        val thread = start_thread(link).ok_or("the circuit's own thread would not start")?
        val shown = run(app(s"amber — ${file}", () -> screen(m), () -> GROUND, WIDTH, HEIGHT,
                            on_event = e -> shortcut(m, e), on_frame = dt -> frame(m, link, dt)))

        link.quit.store(1)
        thread.join()
        return shown

    m.running = false

    if time > 0.0
        m.run(time, 600)
        m.flow(0.1)

    val font = system_font()

    if font == "" then return Err("no font this program knows about is on this machine")

    val surf = plutovg.surface(WIDTH, HEIGHT).expect("a drawing surface")
    val vg = plutovg.canvas(surf).expect("a drawing canvas")
    val face = plutovg.font(font).expect(s"the font at ${font} opened")
    var c = pluto_canvas(vg, face, 15.0)

    surf.clear(fraction(GROUND, 16), fraction(GROUND, 8), fraction(GROUND, 0))
    render(screen(m), &c, Rect(0, 0, WIDTH, HEIGHT))

    if !surf.write_png(shot) then return Err(s"${shot} could not be written")

    print(s"wrote ${shot}: ${status(m)}")
    Ok(())
end main

// A meter from `--meter x1,y1,x2,y2`.
private meter_option(arg: string) -> Result[(int, int, int, int), string]
    val parts = split(arg, ",")

    if parts.len != 4 then return Err(s"--meter takes x1,y1,x2,y2, not '${arg}'")

    var xy: [4]int = [0, 0, 0, 0]

    for k in 0..<4
        xy[k] = parse_int(parts[k]).map_err(e -> s"--meter takes x1,y1,x2,y2, not '${arg}'")?

    Ok((xy[0], xy[1], xy[2], xy[3]))
