// The window: the schematic, drawn with its voltages, and a line about whatever was clicked.
//
// **The schematic is drawn into a picture of its own and the picture is put on the canvas.** syslUI's
// canvas is rectangles and text on purpose, so that it can run where there is no vector rasterizer,
// and a schematic is zigzags, triangles and circles. The view keeps a PlutoVG surface the size of the
// board, draws the lines into it, hands it to the canvas as an image, and writes the labels over it
// through the canvas, in the window's own font.

import sh.sysl.amber.{Element, Shape, Colour, Wave, Waveform, Pulse, Sine, Switch}
import sh.sysl.ui.{View, Canvas, Size, Rect, Image, column, row, text, spacer}
import sh.sysl.plutovg
import sysl.buf.{Buf, buf}
import sysl.math.{max, min, pi, tau}

const GROUND: u32 = 0x15171C
const BOARD: u32 = 0x0F1115
const DOT: u32 = 0x262A33
const INK: u32 = 0xE8E6E0
const DIM: u32 = 0x8A8F99
const RED_LEAD: u32 = 0xE0483E
const BLACK_LEAD: u32 = 0x9AA0AA
const SELECTED: u32 = 0x6CB4FF
const CURRENT: u32 = 0xFFE680

// A transistor's symbol, in squares: the base's bar stands BAR off the line from collector to emitter,
// the slants leave it SLANT either side of its middle, and they meet the line BEND either side of the
// middle of the collector and emitter. Its circle, RING across, is centred HUB toward the base.
const BAR: real = 0.45
const SLANT: real = 0.15
const BEND: real = 0.55
const HUB: real = 0.2
const RING: real = 0.64

// A MOSFET's symbol, in squares, in the same frame and circle: its channel runs CHANNEL toward the gate
// from the line between drain and source, reaching REACH either side of the middle, where the drain's
// and source's stubs meet it; the gate's plate stands PLATE off the line and PLATE_HALF either side.
const CHANNEL: real = 0.36
const REACH: real = 0.5
const PLATE: real = 0.6
const PLATE_HALF: real = 0.42

// The whole window: the board, the scope under it with the clicked instrument's panel beside it, and
// the status line.
screen(m: &Model) -> &View =
    column([
        board(m).flex(),
        m.open_panel() match
            Some(k) -> row([scope(m).flex(), panel_view(m.panels[k], () -> m.select(-1))])
            None -> scope(m),
        row([text(status(m)), spacer(), text(if m.panels.len() > 0 then INSTRUMENT_HINT else HINT)], 10).padding(8),
    ])

const HINT: string = "click two points: a meter · click a switch to flip it · space pause · +/- speed · r restart · v values · c clear"
const INSTRUMENT_HINT: string = "click two points: a meter · click a generator to tune it · space pause · +/- speed · r restart · v values · c clear"

// --- The board --------------------------------------------------------------------------------------

private struct Board
    m: &Model

private board(m: &Model) -> &View = Board(m)

// Where the grid lands: grid point (x, y) is at (`ox` + x·`unit`, `oy` + y·`unit`) in the window.
private struct Place
    ox: real
    oy: real
    unit: real

    x(self, gx: real) -> real = self.ox + gx * self.unit
    y(self, gy: real) -> real = self.oy + gy * self.unit

    // The grid point nearest a window point, if it is within a third of a square of it.
    snap(self, wx: int, wy: int) -> Option[(int, int)]
        val gx = (real(wx) - self.ox) / self.unit
        val gy = (real(wy) - self.oy) / self.unit
        val nx = gx.round()
        val ny = gy.round()

        if (gx - nx).abs() > 0.34 || (gy - ny).abs() > 0.34 then return None

        Some((int(nx), int(ny)))

impl View for Board
    measure(&self, c: *Canvas, avail: Size) -> Size = avail

    paint(&self, c: *Canvas, r: Rect)
        val m = self.m
        val at = place(m, r)

        c.fill(r, BOARD)
        c.clip(r)

        if m.board.fit(r, c.pixel_scale()) is Some(vg)
            draw(m, vg, at, r, c.pixel_scale())
            c.draw_image(r, Image(m.board.surface.unwrap()))

        labels(m, c, at)
        c.unclip()

        if c.tapped(r)
            val (tx, ty) = c.tap_point()

            if at.snap(tx, ty) is Some((gx, gy))
                if m.probe(gx, gy) then return

            m.select(hit(m, at, tx, ty))

// Fit the drawing to the board at no more than 90 points a square, with four squares round it: room
// for a meter's dial, which stands three squares off the circuit.
private place(m: &Model, r: Rect) -> Place
    var x0 = 1 << 30
    var y0 = 1 << 30
    var x1 = -(1 << 30)
    var y1 = -(1 << 30)

    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        x0 = min(x0, min(e.x1, min(e.x2, e.x3)))
        y0 = min(y0, min(e.y1, min(e.y2, e.y3)))
        x1 = max(x1, max(e.x1, max(e.x2, e.x3)))
        y1 = max(y1, max(e.y1, max(e.y2, e.y3)))

    if x0 > x1
        x0 = 0
        y0 = 0
        x1 = 1
        y1 = 1

    val span_x = real(x1 - x0) + 8.0
    val span_y = real(y1 - y0) + 8.0
    val unit = min(90.0, min(real(r.w) / span_x, real(r.h) / span_y))

    Place(real(r.x) + (real(r.w) - unit * real(x1 - x0)) / 2.0 - unit * real(x0),
          real(r.y) + (real(r.h) - unit * real(y1 - y0)) / 2.0 - unit * real(y0), unit)

// The element under a window point, or -1: a part's body, or a wire's line.
private hit(m: &Model, at: Place, wx: int, wy: int) -> int
    val px = real(wx)
    val py = real(wy)

    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        // A transistor is hit anywhere in its circle.
        if e.shape.points() == 3
            val g = transistor_frame(e)
            val (cx, cy) = (at.x(g.gx(0.0, HUB)), at.y(g.gy(0.0, HUB)))

            if (px - cx) * (px - cx) + (py - cy) * (py - cy) < (RING * at.unit) * (RING * at.unit) then return int(i)

            continue

        if e.shape.points() != 2 || e.shape == Meter then continue

        val ax = at.x(real(e.x1))
        val ay = at.y(real(e.y1))
        val bx = at.x(real(e.x2))
        val by = at.y(real(e.y2))
        val dx = bx - ax
        val dy = by - ay
        val t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)

        if t < 0.0 || t > 1.0 then continue

        val qx = ax + t * dx - px
        val qy = ay + t * dy - py

        if qx * qx + qy * qy < (0.3 * at.unit) * (0.3 * at.unit) then return int(i)

    -1

// --- Drawing ----------------------------------------------------------------------------------------

// The colour a voltage is drawn in: grey at ground, warming to amber as it rises and cooling to blue
// as it falls, full at the largest voltage anywhere in the circuit.
private wire_colour(v: real, most: real) -> u32
    val t = min(1.0, v.abs() / max(most, 1e-9))
    val (r, g, b) = if v >= 0.0 then (0xFF, 0xB0, 0x30) else (0x4A, 0x9C, 0xFF)

    mix(0x70, r, t) << 16 | mix(0x76, g, t) << 8 | mix(0x80, b, t)

private mix(a: int, b: int, t: real) -> u32 = u32(int(real(a) + (real(b) - real(a)) * t))

private set(vg: &plutovg.Canvas, colour: u32) =
    vg.rgb(f32(int((colour >> 16) & 0xFF)) / 255.0, f32(int((colour >> 8) & 0xFF)) / 255.0, f32(int(colour & 0xFF)) / 255.0)

// The highest voltage magnitude at any node, which the wire colours are scaled to.
private most_volts(m: &Model) -> real
    var most = 0.0

    for n in 0..<m.sch.circuit.node_count()
        most = max(most, m.s.voltage(int(n)).abs())

    most

// Draw every element's lines. Coordinates go through `at` into window points, then shift by the
// board's corner and scale to the surface's device pixels.
private draw(m: &Model, vg: &plutovg.Canvas, at: Place, r: Rect, scale: real)
    val most = most_volts(m)
    val pen = Pen(vg, at, real(r.x), real(r.y), scale, m)

    vg.line_cap(plutovg.LineCap.Round)
    vg.line_join(plutovg.LineJoin.Round)

    // The grid's dots, faintly, so a point to click is somewhere to aim.
    set(vg, DOT)

    val g0x = int(((real(r.x) - at.ox) / at.unit).floor())
    val g1x = int(((real(r.right()) - at.ox) / at.unit).ceil())
    val g0y = int(((real(r.y) - at.oy) / at.unit).floor())
    val g1y = int(((real(r.bottom()) - at.oy) / at.unit).ceil())

    for gy in g0y..g1y
        for gx in g0x..g1x
            pen.dot(real(gx), real(gy), 1.6)

    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]
        val hot = int(i) == m.selected

        e.shape match
            Wire -> pen.wire(e, m.s.voltage(e.a), most, hot)
            Ground -> pen.ground(e)
            Label -> ()
            Meter -> ()
            Npn | Pnp -> pen.transistor(e, most, hot)
            Nmos | Pmos -> pen.mosfet(e, most, hot)
            _ -> pen.part(e, most, hot)

    // A dot wherever three or more ends meet, as a draughtsman marks a junction.
    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        for end in 0..<e.shape.points()
            val (x, y) = e.point(end)

            if ends_at(m, x, y) >= 3
                set(vg, wire_colour(m.volts_at(x, y), most))
                pen.dot(real(x), real(y), 4.0)

    // The current, as dots moving along the wires and through the parts the way it flows.
    // A current too small to move them shows none.
    set(vg, CURRENT)

    if m.trouble == ""
        val amps = m.sch.segment_currents(m.s)

        for k in 0..<m.sch.segments.len()
            val g = m.sch.segments[k]

            if dot_speed(amps[k], m.most_amps) != 0.0
                pen.dots(real(g.x1), real(g.y1), real(g.x2), real(g.y2), m.segment_flow[k])

        for i in 0..<m.sch.elements.len()
            val e = m.sch.elements[i]

            if e.part >= 0 && (e.shape == Nmos || e.shape == Pmos)
                pen.mosfet_dots(e, m.part_flow[i])
            elif e.part >= 0 && e.shape.points() == 3
                pen.transistor_dots(e, m.part_flow[i], m.base_flow[i], m.emitter_flow[i])
            elif e.part >= 0 && dot_speed(m.s.current(e.part), m.most_amps) != 0.0
                pen.dots(real(e.x1), real(e.y1), real(e.x2), real(e.y2), m.part_flow[i])

    for k in 0..<m.meters.len()
        pen.meter(m.meters[k])

    if m.probing
        set(vg, RED_LEAD)
        pen.ring(real(m.px), real(m.py), 7.0)

// How many element ends, and points along wires, are at grid point (`x`, `y`).
private ends_at(m: &Model, x: int, y: int) -> int
    var n = 0

    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        if e.shape == Meter || e.shape == Label then continue

        if e.x1 == x && e.y1 == y then n += 1

        if e.shape.points() == 2
            if e.x2 == x && e.y2 == y
                n += 1
            elif e.shape == Wire && between(x, y, e)
                n += 2
        elif e.shape.points() == 3
            if e.x2 == x && e.y2 == y then n += 1

            if e.x3 == x && e.y3 == y then n += 1

    n

// Whether (`x`, `y`) is strictly inside wire `e`.
private between(x: int, y: int, e: Element) -> bool
    if (e.x2 - e.x1) * (y - e.y1) != (e.y2 - e.y1) * (x - e.x1) then return false

    val inside_x = (x - e.x1) * (x - e.x2) <= 0
    val inside_y = (y - e.y1) * (y - e.y2) <= 0

    inside_x && inside_y && !(x == e.x1 && y == e.y1) && !(x == e.x2 && y == e.y2)

// What draws into the picture: grid coordinates in, device pixels out.
private struct Pen
    vg: &plutovg.Canvas
    at: Place
    left: real
    top: real
    scale: real
    m: &Model

    px(self, gx: real) -> f32 = f32((self.at.x(gx) - self.left) * self.scale)
    py(self, gy: real) -> f32 = f32((self.at.y(gy) - self.top) * self.scale)

    // A length in grid squares, in device pixels.
    len(self, g: real) -> f32 = f32(g * self.at.unit * self.scale)

    width(self, points: real) = self.vg.line_width(f32(points * self.scale))

    dot(self, gx: real, gy: real, radius: real)
        self.vg.begin()
        self.vg.circle(self.px(gx), self.py(gy), f32(radius * self.scale))
        self.vg.fill()

    ring(self, gx: real, gy: real, radius: real)
        self.width(2.0)
        self.vg.begin()
        self.vg.circle(self.px(gx), self.py(gy), f32(radius * self.scale))
        self.vg.stroke()

    line(self, x1: real, y1: real, x2: real, y2: real)
        self.vg.begin()
        self.vg.move_to(self.px(x1), self.py(y1))
        self.vg.line_to(self.px(x2), self.py(y2))
        self.vg.stroke()

    wire(self, e: Element, v: real, most: real, hot: bool)
        set(self.vg, if hot then SELECTED else wire_colour(v, most))
        self.width(3.0)
        self.line(real(e.x1), real(e.y1), real(e.x2), real(e.y2))

    ground(self, e: Element)
        val x = real(e.x1)
        val y = real(e.y1)

        set(self.vg, wire_colour(0.0, 1.0))
        self.width(3.0)
        self.line(x, y, x, y + 0.35)
        self.line(x - 0.35, y + 0.35, x + 0.35, y + 0.35)
        self.line(x - 0.22, y + 0.5, x + 0.22, y + 0.5)
        self.line(x - 0.09, y + 0.65, x + 0.09, y + 0.65)

    // A two-ended part: a lead from each end in its end's colour, and the symbol in the middle, drawn
    // in a frame where the part runs along +u from its first end and +n is to its left.
    part(self, e: Element, most: real, hot: bool)
        val m = self.m
        val ax = real(e.x1)
        val ay = real(e.y1)
        val dx = real(e.x2 - e.x1)
        val dy = real(e.y2 - e.y1)
        val length = (dx * dx + dy * dy).sqrt()
        val ux = dx / length
        val uy = dy / length
        // The symbol takes the middle of the part, at most a square and a half of it.
        val body = min(1.5, length)
        val s0 = (length - body) / 2.0
        val s1 = s0 + body
        val va = m.s.voltage(e.a)
        val vb = m.s.voltage(e.b)
        val f = Frame(self, ax, ay, ux, uy)

        self.width(3.0)
        set(self.vg, wire_colour(va, most))
        f.line(0.0, 0.0, s0, 0.0)
        set(self.vg, wire_colour(vb, most))
        f.line(s1, 0.0, length, 0.0)

        set(self.vg, if hot then SELECTED else INK)
        self.width(2.5)

        e.shape match
            Resistor ->
                // Three zigzags, peak to peak, in a square of the middle, as a schematic draws one.
                val zigzag = min(1.0, body)
                val r0 = (length - zigzag) / 2.0
                val step = zigzag / 6.0

                self.vg.begin()
                f.move(s0, 0.0)
                f.to(r0, 0.0)

                for k in 0..<6
                    f.to(r0 + (real(k) + 0.5) * step, if k % 2 == 0 then 0.2 else -0.2)

                f.to(r0 + zigzag, 0.0)
                f.to(s1, 0.0)
                self.vg.stroke()
            Capacitor ->
                val mid = (s0 + s1) / 2.0

                f.line(s0, 0.0, mid - 0.1, 0.0)
                f.line(mid + 0.1, 0.0, s1, 0.0)
                self.width(3.5)
                f.line(mid - 0.1, -0.4, mid - 0.1, 0.4)
                f.line(mid + 0.1, -0.4, mid + 0.1, 0.4)
            Inductor ->
                // Four loops of wire, each a half circle standing on the line.
                val turn = body / 4.0

                self.vg.begin()
                f.move(s0, 0.0)

                for k in 0..<4
                    val c = s0 + turn * (real(k) + 0.5)

                    for j in 1..12
                        val a = pi * real(j) / 12.0

                        f.to(c - turn / 2.0 * a.cos(), turn / 2.0 * a.sin())

                self.vg.stroke()
            Switch ->
                val closed = m.s.circuit.parts[usize(e.part)].kind == Switch(true)

                f.line(s0, 0.0, s0 + 0.15, 0.0)
                f.line(s1 - 0.15, 0.0, s1, 0.0)
                // The lever pivots at its first contact and lies on the second when closed.
                if closed then f.line(s0 + 0.15, 0.0, s1 - 0.15, 0.0) else f.line(s0 + 0.15, 0.0, s1 - 0.25, 0.55)
                self.dot(f.gx(s0 + 0.15, 0.0), f.gy(s0 + 0.15, 0.0), 3.5)
                self.dot(f.gx(s1 - 0.15, 0.0), f.gy(s1 - 0.15, 0.0), 3.5)
            Source ->
                val mid = (s0 + s1) / 2.0
                val radius = min(0.5, body / 2.0)

                f.line(s0, 0.0, mid - radius, 0.0)
                f.line(mid + radius, 0.0, s1, 0.0)
                self.vg.begin()
                self.vg.circle(f.x(mid, 0.0), f.y(mid, 0.0), self.len(radius))
                self.vg.stroke()
                // What it puts out, drawn small inside it: a sine's curve or a pulse's steps.
                self.width(2.0)
                self.vg.begin()

                val w = radius * 0.55

                if m.s.circuit.parts[usize(e.part)].kind.wave() is Some(Sine(_, _, _, _, _, _))
                    for j in 0..24
                        val u = real(j) / 24.0

                        val dx = -w + 2.0 * w * u
                        val dy = 0.6 * w * (tau * u).sin()

                        if j == 0 then f.move_across(mid, dx, dy) else f.to_across(mid, dx, dy)
                else
                    f.move_across(mid, -w, -0.5 * w)
                    f.to_across(mid, -w, 0.5 * w)
                    f.to_across(mid, 0.0, 0.5 * w)
                    f.to_across(mid, 0.0, -0.5 * w)
                    f.to_across(mid, w, -0.5 * w)
                    f.to_across(mid, w, 0.5 * w)

                self.vg.stroke()
                // `+` beside the first end.
                f.line(mid - radius - 0.3, 0.32, mid - radius - 0.1, 0.32)
                f.line(mid - radius - 0.2, 0.22, mid - radius - 0.2, 0.42)
            Generator -> self.generator(f, (s0 + s1) / 2.0, s0, s1, m.waveform_of(e.part), hot)
            Battery ->
                val mid = (s0 + s1) / 2.0

                f.line(s0, 0.0, mid - 0.12, 0.0)
                f.line(mid + 0.12, 0.0, s1, 0.0)
                // The long plate is `+`, the first end; the short, thick one is `−`.
                f.line(mid - 0.12, -0.45, mid - 0.12, 0.45)
                self.width(5.0)
                f.line(mid + 0.12, -0.22, mid + 0.12, 0.22)
                self.width(2.0)
                f.line(mid - 0.45, 0.42, mid - 0.25, 0.42)
                f.line(mid - 0.35, 0.32, mid - 0.35, 0.52)
            CurrentSource ->
                val mid = (s0 + s1) / 2.0
                val radius = min(0.5, body / 2.0)

                f.line(s0, 0.0, mid - radius, 0.0)
                f.line(mid + radius, 0.0, s1, 0.0)
                self.vg.begin()
                self.vg.circle(f.x(mid, 0.0), f.y(mid, 0.0), self.len(radius))
                self.vg.stroke()
                // The arrow points the way the current leaves: out of the second end.
                f.line(mid - radius * 0.6, 0.0, mid + radius * 0.6, 0.0)
                self.vg.begin()
                f.move(mid + radius * 0.6, 0.0)
                f.to(mid + radius * 0.2, 0.18)
                f.to(mid + radius * 0.2, -0.18)
                self.vg.close_path()
                self.vg.fill()
            Diode | Led ->
                val mid = (s0 + s1) / 2.0

                if e.shape == Led then self.glow(f, mid, e)

                set(self.vg, if hot then SELECTED else INK)
                self.width(2.5)
                f.line(s0, 0.0, mid - 0.3, 0.0)
                f.line(mid + 0.3, 0.0, s1, 0.0)
                self.vg.begin()
                f.move(mid - 0.3, -0.32)
                f.to(mid + 0.3, 0.0)
                f.to(mid - 0.3, 0.32)
                self.vg.close_path()
                self.vg.stroke()
                f.line(mid + 0.3, -0.32, mid + 0.3, 0.32)

                if e.shape == Led
                    // Two arrows leaving it: light.
                    self.width(1.8)

                    for k in 0..<2
                        val o = real(k) * 0.24

                        f.line(mid - 0.05 + o, 0.42, mid + 0.15 + o, 0.68)
                        f.line(mid + 0.15 + o, 0.68, mid + 0.03 + o, 0.65)
                        f.line(mid + 0.15 + o, 0.68, mid + 0.14 + o, 0.56)
            _ -> ()

    // A signal generator: a small instrument's case standing upright on its lead whichever way the part
    // runs, with the waveform it is putting out on its screen, a knob under the screen, and `+` beside
    // its output, the first end.
    generator(self, f: Frame, mid: real, s0: real, s1: real, form: Option[Waveform], hot: bool)
        val w = 0.62
        val h = 0.46

        f.line(s0, 0.0, s1, 0.0)

        // The case, filled with the board's colour over the lead running through it.
        set(self.vg, BOARD)
        self.outline(f, mid, w, h)
        self.vg.fill()
        set(self.vg, if hot then SELECTED else INK)
        self.width(2.5)
        self.outline(f, mid, w, h)
        self.vg.stroke()

        // The screen, and the waveform on it.
        val sx = 0.42
        val sy = 0.2
        val cy = 0.1

        self.width(1.5)
        self.vg.begin()
        f.move_across(mid, -sx, cy - sy)
        f.to_across(mid, sx, cy - sy)
        f.to_across(mid, sx, cy + sy)
        f.to_across(mid, -sx, cy + sy)
        self.vg.close_path()
        self.vg.stroke()

        val gw = sx * 0.75
        val gh = sy * 0.6

        self.width(2.0)
        self.vg.begin()

        form match
            Some(Waveform.Square) ->
                f.move_across(mid, -gw, cy - gh)
                f.to_across(mid, -gw, cy + gh)
                f.to_across(mid, 0.0, cy + gh)
                f.to_across(mid, 0.0, cy - gh)
                f.to_across(mid, gw, cy - gh)
                f.to_across(mid, gw, cy + gh)
            Some(Waveform.Triangle) ->
                f.move_across(mid, -gw, cy)
                f.to_across(mid, -gw / 2.0, cy + gh)
                f.to_across(mid, gw / 2.0, cy - gh)
                f.to_across(mid, gw, cy)
            Some(Waveform.Dc) ->
                f.move_across(mid, -gw, cy + gh / 2.0)
                f.to_across(mid, gw, cy + gh / 2.0)
            _ ->
                for j in 0..24
                    val u = real(j) / 24.0
                    val dx = -gw + 2.0 * gw * u
                    val dy = cy + gh * (tau * u).sin()

                    if j == 0 then f.move_across(mid, dx, dy) else f.to_across(mid, dx, dy)

        self.vg.stroke()

        // A knob under the screen, and a terminal either side of it.
        self.width(1.5)
        self.vg.begin()
        self.vg.circle(self.px(f.gx(mid, 0.0)), self.py(f.gy(mid, 0.0) + 0.29), self.len(0.08))
        self.vg.stroke()
        self.dot(f.gx(mid, 0.0) - 0.4, f.gy(mid, 0.0) + 0.29, 2.5)
        self.dot(f.gx(mid, 0.0) + 0.4, f.gy(mid, 0.0) + 0.29, 2.5)

        // `+` beside the output.
        self.width(2.0)
        f.line(s0 - 0.05, 0.32, s0 + 0.15, 0.32)
        f.line(s0 + 0.05, 0.22, s0 + 0.05, 0.42)

    // The outline of an instrument's case, `w` either side of the middle of a part and `h` above and
    // below it, upright on the screen.
    outline(self, f: Frame, mid: real, w: real, h: real)
        self.vg.begin()
        f.move_across(mid, -w, -h)
        f.to_across(mid, w, -h)
        f.to_across(mid, w, h)
        f.to_across(mid, -w, h)
        self.vg.close_path()

    // An LED's light: a halo in its colour, as bright as its current is near 20 mA.
    glow(self, f: Frame, mid: real, e: Element)
        val i = self.m.s.current(e.part)
        val t = min(1.0, max(0.0, i / 20e-3))

        if t < 0.02 then return

        val c = led_colour(e.colour)

        self.vg.rgba(f32(int((c >> 16) & 0xFF)) / 255.0, f32(int((c >> 8) & 0xFF)) / 255.0, f32(int(c & 0xFF)) / 255.0,
                     f32(0.15 + 0.6 * t))
        self.vg.begin()
        self.vg.circle(f.x(mid, 0.0), f.y(mid, 0.0), self.len(0.35 + 0.35 * t))
        self.vg.fill()

    // A transistor: a lead from each of its three points in its node's colour, and the symbol in a
    // circle between them — the base's bar, the collector's and emitter's slants to it, and the
    // emitter's arrow, pointing out of an NPN and into a PNP.
    transistor(self, e: Element, most: real, hot: bool)
        val g = transistor_frame(e)
        val m = self.m

        self.width(3.0)
        set(self.vg, wire_colour(m.s.voltage(e.a), most))
        self.line(real(e.x1), real(e.y1), g.gx(BEND, 0.0), g.gy(BEND, 0.0))
        set(self.vg, wire_colour(m.s.voltage(e.b), most))
        self.line(real(e.x2), real(e.y2), g.gx(0.0, BAR), g.gy(0.0, BAR))
        set(self.vg, wire_colour(m.s.voltage(e.c), most))
        self.line(real(e.x3), real(e.y3), g.gx(-BEND, 0.0), g.gy(-BEND, 0.0))

        set(self.vg, if hot then SELECTED else INK)
        self.width(2.5)
        self.vg.begin()
        self.vg.circle(self.px(g.gx(0.0, HUB)), self.py(g.gy(0.0, HUB)), self.len(RING))
        self.vg.stroke()
        self.line(g.gx(SLANT, BAR), g.gy(SLANT, BAR), g.gx(BEND, 0.0), g.gy(BEND, 0.0))
        self.line(g.gx(-SLANT, BAR), g.gy(-SLANT, BAR), g.gx(-BEND, 0.0), g.gy(-BEND, 0.0))
        self.width(4.0)
        self.line(g.gx(-0.4, BAR), g.gy(-0.4, BAR), g.gx(0.4, BAR), g.gy(0.4, BAR))

        // The arrow on the emitter's slant: its tip near the lead for an NPN, near the bar for a PNP.
        val (s0, t0, s1, t1) = if e.shape == Npn then (-SLANT, BAR, -BEND, 0.0) else (-BEND, 0.0, -SLANT, BAR)
        val ds = s1 - s0
        val dt = t1 - t0
        val length = (ds * ds + dt * dt).sqrt()
        val (ws, wt) = (ds / length, dt / length)
        val at = if e.shape == Npn then 0.8 else 0.75
        val (ts, tt) = (s0 + ds * at, t0 + dt * at)

        self.vg.begin()
        self.vg.move_to(self.px(g.gx(ts, tt)), self.py(g.gy(ts, tt)))
        self.vg.line_to(self.px(g.gx(ts - 0.26 * ws - 0.12 * wt, tt - 0.26 * wt + 0.12 * ws)),
                        self.py(g.gy(ts - 0.26 * ws - 0.12 * wt, tt - 0.26 * wt + 0.12 * ws)))
        self.vg.line_to(self.px(g.gx(ts - 0.26 * ws + 0.12 * wt, tt - 0.26 * wt - 0.12 * ws)),
                        self.py(g.gy(ts - 0.26 * ws + 0.12 * wt, tt - 0.26 * wt - 0.12 * ws)))
        self.vg.close_path()
        self.vg.fill()

    // A transistor's current dots: along the collector's lead and slant to the bar, from the base to
    // the bar, and from the bar down the emitter's slant and lead, each moved its own `flow` squares.
    transistor_dots(self, e: Element, collector: real, base: real, emitter: real)
        val g = transistor_frame(e)
        val m = self.m
        val (bx, by) = (g.gx(BEND, 0.0), g.gy(BEND, 0.0))
        val (ex, ey) = (g.gx(-BEND, 0.0), g.gy(-BEND, 0.0))

        if dot_speed(m.s.terminal_current(e.part, 0), m.most_amps) != 0.0
            self.dots(real(e.x1), real(e.y1), bx, by, collector)
            self.dots(bx, by, g.gx(SLANT, BAR), g.gy(SLANT, BAR), collector - distance(real(e.x1), real(e.y1), bx, by))

        if dot_speed(m.s.terminal_current(e.part, 1), m.most_amps) != 0.0
            self.dots(real(e.x2), real(e.y2), g.gx(0.0, BAR), g.gy(0.0, BAR), base)

        if dot_speed(m.s.terminal_current(e.part, 2), m.most_amps) != 0.0
            val (sx, sy) = (g.gx(-SLANT, BAR), g.gy(-SLANT, BAR))

            self.dots(sx, sy, ex, ey, emitter)
            self.dots(ex, ey, real(e.x3), real(e.y3), emitter - distance(sx, sy, ex, ey))

    // A MOSFET: a lead from each of its three points in its node's colour, the gate's plate, the channel
    // in three pieces with the drain's and source's stubs, and the body's line from the channel's middle
    // down to the source with its arrow, pointing in for an N-channel and out for a P-channel.
    mosfet(self, e: Element, most: real, hot: bool)
        val g = transistor_frame(e)
        val m = self.m
        val (dx, dy) = (g.gx(REACH, 0.0), g.gy(REACH, 0.0))
        val (sx, sy) = (g.gx(-REACH, 0.0), g.gy(-REACH, 0.0))
        val (bx, by) = (g.gx(0.0, 0.0), g.gy(0.0, 0.0))

        self.width(3.0)
        set(self.vg, wire_colour(m.s.voltage(e.a), most))
        self.line(real(e.x1), real(e.y1), dx, dy)
        self.line(dx, dy, g.gx(REACH, CHANNEL), g.gy(REACH, CHANNEL))
        set(self.vg, wire_colour(m.s.voltage(e.b), most))
        self.line(real(e.x2), real(e.y2), g.gx(0.0, PLATE), g.gy(0.0, PLATE))
        set(self.vg, wire_colour(m.s.voltage(e.c), most))
        self.line(real(e.x3), real(e.y3), sx, sy)
        self.line(sx, sy, bx, by)
        self.line(sx, sy, g.gx(-REACH, CHANNEL), g.gy(-REACH, CHANNEL))
        self.line(bx, by, g.gx(0.0, CHANNEL), g.gy(0.0, CHANNEL))

        set(self.vg, if hot then SELECTED else INK)
        self.width(2.5)
        self.vg.begin()
        self.vg.circle(self.px(g.gx(0.0, HUB)), self.py(g.gy(0.0, HUB)), self.len(RING))
        self.vg.stroke()
        self.line(g.gx(-REACH, CHANNEL), g.gy(-REACH, CHANNEL), g.gx(-0.34, CHANNEL), g.gy(-0.34, CHANNEL))
        self.line(g.gx(-0.14, CHANNEL), g.gy(-0.14, CHANNEL), g.gx(0.14, CHANNEL), g.gy(0.14, CHANNEL))
        self.line(g.gx(0.34, CHANNEL), g.gy(0.34, CHANNEL), g.gx(REACH, CHANNEL), g.gy(REACH, CHANNEL))
        self.width(4.0)
        self.line(g.gx(-PLATE_HALF, PLATE), g.gy(-PLATE_HALF, PLATE), g.gx(PLATE_HALF, PLATE), g.gy(PLATE_HALF, PLATE))

        // The arrow on the body's line, across the line toward the channel for N, away from it for P.
        val (tip, back) = if e.shape == Nmos then (CHANNEL - 0.02, CHANNEL - 0.26) else (0.1, 0.34)

        self.vg.begin()
        self.vg.move_to(self.px(g.gx(0.0, tip)), self.py(g.gy(0.0, tip)))
        self.vg.line_to(self.px(g.gx(-0.12, back)), self.py(g.gy(-0.12, back)))
        self.vg.line_to(self.px(g.gx(0.12, back)), self.py(g.gy(0.12, back)))
        self.vg.close_path()
        self.vg.fill()

    // A MOSFET's current dots, along its drain's lead and stub, its channel, and its source's stub and
    // lead, moved `flow` squares along the way from the drain.
    mosfet_dots(self, e: Element, flow: real)
        if dot_speed(self.m.s.terminal_current(e.part, 0), self.m.most_amps) == 0.0 then return

        val g = transistor_frame(e)
        val xs = [real(e.x1), g.gx(REACH, 0.0), g.gx(REACH, CHANNEL), g.gx(-REACH, CHANNEL), g.gx(-REACH, 0.0), real(e.x3)]
        val ys = [real(e.y1), g.gy(REACH, 0.0), g.gy(REACH, CHANNEL), g.gy(-REACH, CHANNEL), g.gy(-REACH, 0.0), real(e.y3)]
        var behind = 0.0

        for k in 0..<5
            self.dots(xs[k], ys[k], xs[k + 1], ys[k + 1], flow - behind)
            behind += distance(xs[k], ys[k], xs[k + 1], ys[k + 1])

    // Current dots along the line from (`x1`, `y1`) to (`x2`, `y2`), half a square apart, moved `flow`
    // squares along it.
    dots(self, x1: real, y1: real, x2: real, y2: real, flow: real)
        val dx = x2 - x1
        val dy = y2 - y1
        val length = (dx * dx + dy * dy).sqrt()
        var s = flow.fmod(0.5)

        if s < 0.0 then s += 0.5

        while s < length
            self.dot(x1 + dx * s / length, y1 + dy * s / length, 2.6)
            s += 0.5

    // A voltmeter: a dial a square off to the side, and its red and black leads.
    meter(self, mt: Meter)
        val x1 = mt.x1
        val y1 = mt.y1
        val x2 = mt.x2
        val y2 = mt.y2
        val (cx, cy) = meter_centre(self.m, x1, y1, x2, y2)

        self.vg.save()
        self.width(2.0)

        val dash: [2]f32 = [f32(6.0 * self.scale), f32(4.0 * self.scale)]

        self.vg.dash(dash[..])
        set(self.vg, RED_LEAD)
        self.line(real(x1), real(y1), cx, cy)
        set(self.vg, BLACK_LEAD)
        self.line(real(x2), real(y2), cx, cy)
        self.vg.restore()

        set(self.vg, RED_LEAD)
        self.dot(real(x1), real(y1), 5.0)
        set(self.vg, BLACK_LEAD)
        self.dot(real(x2), real(y2), 5.0)

        set(self.vg, 0x1E2128)
        self.vg.begin()
        self.vg.round_rect(self.px(cx - 0.75), self.py(cy - 0.3), self.len(1.5), self.len(0.6), self.len(0.12), self.len(0.12))
        self.vg.fill()
        set(self.vg, mt.colour)
        self.width(2.0)
        self.vg.begin()
        self.vg.round_rect(self.px(cx - 0.75), self.py(cy - 0.3), self.len(1.5), self.len(0.6), self.len(0.12), self.len(0.12))
        self.vg.stroke()

// Where a meter's dial sits: off the middle of its two leads, three squares out from the line between
// them on the side away from the middle of the drawing, so it stands clear of the circuit.
private meter_centre(m: &Model, x1: int, y1: int, x2: int, y2: int) -> (real, real)
    val mx = (real(x1) + real(x2)) / 2.0
    val my = (real(y1) + real(y2)) / 2.0
    val dx = real(x2 - x1)
    val dy = real(y2 - y1)
    val length = (dx * dx + dy * dy).sqrt()

    if length == 0.0 then return (mx, my - 1.5)

    var nx = dy / length
    var ny = -dx / length
    val (gx, gy) = middle(m)

    if (mx - gx) * nx + (my - gy) * ny < 0.0
        nx = -nx
        ny = -ny

    (mx + 3.0 * nx, my + 3.0 * ny)

// The middle of the drawing: the average of every part's and wire's ends.
private middle(m: &Model) -> (real, real)
    var sx = 0.0
    var sy = 0.0
    var n = 0.0

    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        if e.shape == Meter then continue

        sx += real(e.x1 + e.x2)
        sy += real(e.y1 + e.y2)
        n += 2.0

        if e.shape.points() == 3
            sx += real(e.x3)
            sy += real(e.y3)
            n += 1.0

    if n == 0.0 then (0.0, 0.0) else (sx / n, sy / n)

private led_colour(c: Colour) -> u32 = c match
    Red -> 0xFF3B30
    Yellow -> 0xFFD60A
    Green -> 0x30D158
    Blue -> 0x409CFF

// A part's own frame: `s` along it from its first end, `t` across it to the left.
private struct Frame
    pen: Pen
    ax: real
    ay: real
    ux: real
    uy: real

    // The grid point `s` along and `t` across.
    gx(self, s: real, t: real) -> real = self.ax + s * self.ux + t * self.uy
    gy(self, s: real, t: real) -> real = self.ay + s * self.uy - t * self.ux

    x(self, s: real, t: real) -> f32 = self.pen.px(self.gx(s, t))
    y(self, s: real, t: real) -> f32 = self.pen.py(self.gy(s, t))

    // A path drawn upright on the screen whichever way the part runs: `dx` squares right of and `dy`
    // squares above the point `mid` along it.
    move_across(self, mid: real, dx: real, dy: real) =
        self.pen.vg.move_to(self.pen.px(self.gx(mid, 0.0) + dx), self.pen.py(self.gy(mid, 0.0) - dy))
    to_across(self, mid: real, dx: real, dy: real) =
        self.pen.vg.line_to(self.pen.px(self.gx(mid, 0.0) + dx), self.pen.py(self.gy(mid, 0.0) - dy))

    move(self, s: real, t: real) = self.pen.vg.move_to(self.x(s, t), self.y(s, t))
    to(self, s: real, t: real) = self.pen.vg.line_to(self.x(s, t), self.y(s, t))

    line(self, s0: real, t0: real, s1: real, t1: real)
        self.pen.vg.begin()
        self.move(s0, t0)
        self.to(s1, t1)
        self.pen.vg.stroke()

// A transistor's own frame, in grid squares: centred midway between its collector and emitter, `s`
// along the line from the middle toward the collector and `t` across it toward the base.
private struct TransistorFrame
    mx: real
    my: real
    ux: real
    uy: real
    nx: real
    ny: real

    gx(self, s: real, t: real) -> real = self.mx + s * self.ux + t * self.nx
    gy(self, s: real, t: real) -> real = self.my + s * self.uy + t * self.ny

private transistor_frame(e: Element) -> TransistorFrame
    val mx = (real(e.x1) + real(e.x3)) / 2.0
    val my = (real(e.y1) + real(e.y3)) / 2.0
    val length = distance(real(e.x3), real(e.y3), real(e.x1), real(e.y1))
    val ux = real(e.x1 - e.x3) / length
    val uy = real(e.y1 - e.y3) / length
    // Across the line, turned whichever way puts the base on the positive side.
    val toward = (real(e.x2) - mx) * -uy + (real(e.y2) - my) * ux
    val side = if toward < 0.0 then -1.0 else 1.0

    TransistorFrame(mx, my, ux, uy, -uy * side, ux * side)

private distance(x1: real, y1: real, x2: real, y2: real) -> real = ((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)).sqrt()

// --- Labels -----------------------------------------------------------------------------------------

// The text over the picture: each part's name and value, the voltage across it when values are on,
// each label, and each meter's reading.
private labels(m: &Model, c: *Canvas, at: Place)
    for i in 0..<m.sch.elements.len()
        val e = m.sch.elements[i]

        if e.shape == Label
            put(c, at.x(real(e.x1)) + 6.0, at.y(real(e.y1)) - 22.0, e.name, DIM, false)
            continue

        if !e.shape.is_part() then continue

        if e.shape.points() == 3
            transistor_label(m, c, at, e)
            continue

        val mx = at.x((real(e.x1) + real(e.x2)) / 2.0)
        val my = at.y((real(e.y1) + real(e.y2)) / 2.0)
        val across = e.y1 == e.y2
        // Beside a vertical part, under a horizontal one.
        val (lx, ly) = if across then (mx, my + 0.5 * at.unit) else (mx + 0.75 * at.unit, my - 18.0)
        val value = e.shape match
            Resistor -> s"${e.value}Ω"
            Capacitor -> s"${e.value}F"
            Inductor -> s"${e.value}H"
            Led -> colour_name(e.colour)
            Switch -> ""
            // What it is set to now, which its panel may have changed.
            Generator -> m.panel_of(int(i)) match
                Some(k) -> m.panels[k].summary()
                None -> e.value
            _ -> e.value

        put(c, lx, ly, s"${e.name} ${value}", INK, across)

        if m.values && m.trouble == "" && e.shape != Battery
            put(c, lx, ly + 18.0, volts(m.s.across(e.part)), 0xFFB030, across)

    for k in 0..<m.meters.len()
        dial(m, c, at, m.meters[k])

// A transistor's name and model on the side of its circle away from the base, and with values on, the
// voltage from its collector to its emitter under them.
private transistor_label(m: &Model, c: *Canvas, at: Place, e: Element)
    val g = transistor_frame(e)
    val x = at.x(g.gx(0.0, -0.75))
    val y = at.y(g.gy(0.0, -0.75))
    val name = s"${e.name} ${e.value}"
    // Beside an upright one, flush against the circle; above or below one lying down, centred.
    val upright = g.nx.abs() >= g.ny.abs()
    val left = if upright && g.nx > 0.0 then x - real(c.text_size(name).w) else x
    val top = if upright then y - 18.0 elif g.ny > 0.0 then y - 36.0 else y

    put(c, left, top, name, INK, !upright)

    if m.values && m.trouble == ""
        put(c, left, top + 18.0, volts(m.s.across(e.part)), 0xFFB030, !upright)

private dial(m: &Model, c: *Canvas, at: Place, mt: Meter)
    val (cx, cy) = meter_centre(m, mt.x1, mt.y1, mt.x2, mt.y2)
    val reading = if m.trouble == "" then volts(m.reading(mt)) else "—"

    put(c, at.x(cx), at.y(cy) - 9.0, reading, INK, true)

// Text at a window point: its left edge there, or its middle when `centred`.
private put(c: *Canvas, x: real, y: real, t: string, colour: u32, centred: bool)
    val size = c.text_size(t)
    val left = if centred then int(x) - size.w / 2 else int(x)

    c.ink(colour)
    c.text(Rect(left, int(y), size.w + 2, size.h), t)
    c.unink()
