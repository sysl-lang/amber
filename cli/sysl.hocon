// amber on the command line: read a SPICE netlist, run its analyses, print what they answer.
//
//     sysl run cli -- oracle/rc_pulse.cir
package { name = "amber-cli", version = "0.1.0", sysl = "0.9.0" }

optimization = "2"

// `os` to read the netlist.
requires {
  os   = true
  heap = true
}

dependencies {
  amber { workspace = true }
}
