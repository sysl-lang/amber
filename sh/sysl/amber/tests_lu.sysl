module sh.sysl.amber
@tests

import sysl.buf.{Buf, buf}

// The system solver: kept dense, eliminated sparse, cleared only where it was written.

// A system of `n` unknowns written from `entries` (row, column, value) and `rhs`, solved.
private solved(n: int, entries: []const (int, int, real), rhs: []const real) -> Buf[real]
    var s: System[real] = system(n)

    write(&s, entries, rhs)
    s.solve().unwrap()

    var x: Buf[real] = buf()

    for i in 0..<n
        x.push(s.z[usize(i)])

    x

private write(s: *System[real], entries: []const (int, int, real), rhs: []const real)
    s.clear()

    for (r, c, v) in entries
        s.at(r, c, v)

    for i in 0..<rhs.len
        s.rhs(int(i), rhs[i])

@test("a system needing its rows swapped solves to the answer, and solves again rightly when written afresh")
lu_swaps_and_rewrites()
    // A voltage source's row has nothing on its diagonal, so the first pivot needs a swap; the second
    // writing puts its entries elsewhere, where the first's swaps left values, which clearing must find.
    val first = [(0, 2, 1.0), (1, 1, 2.0), (1, 2, -1.0), (2, 0, 1.0), (2, 1, -1.0), (3, 3, 4.0), (0, 3, 1.0), (3, 0, 1.0)]
    val second = [(0, 0, 3.0), (1, 1, 1.0), (2, 2, 5.0), (3, 3, 2.0), (1, 3, 1.0), (3, 1, 1.0)]
    var s: System[real] = system(4)

    write(&s, first, [1.0, 2.0, 3.0, 4.0])
    s.solve().unwrap()

    val fresh_first = solved(4, first, [1.0, 2.0, 3.0, 4.0])

    for i in 0..<4
        assert(s.z[i] == fresh_first[i])

    // A·x = z holds for the first.
    write(&s, first, [1.0, 2.0, 3.0, 4.0])

    var check: System[real] = system(4)

    write(&check, first, [1.0, 2.0, 3.0, 4.0])

    for r in 0..<4
        var sum = 0.0

        for c in 0..<4
            sum += check.a[usize(r * 4 + c)] * fresh_first[usize(c)]

        assert((sum - check.z[usize(r)]).abs() < 1e-12)

    // Written afresh with other entries in other places, it solves as a system new to them would.
    write(&s, second, [1.0, 1.0, 1.0, 1.0])
    s.solve().unwrap()

    val fresh_second = solved(4, second, [1.0, 1.0, 1.0, 1.0])

    for i in 0..<4
        assert(s.z[i] == fresh_second[i])

@test("only the entries ever written are cleared, and every one of them is")
lu_clears_what_was_written()
    var s: System[real] = system(5)

    s.at(0, 1, 2.0)
    s.at(4, 4, 1.0)
    s.at(0, 1, 3.0)

    // Two places, each once.
    assert(s.touched.len() == 2 && s.a[1] == 5.0)

    s.clear()

    for i in 0..<s.a.len()
        assert(s.a[i] == 0.0)

    // Ground's row and column land nowhere.
    s.at(-1, 2, 1.0)
    s.at(2, -1, 1.0)
    assert(s.touched.len() == 2)

@test("a singular system says so")
lu_singular()
    var s: System[real] = system(3)

    s.at(0, 0, 1.0)
    s.at(1, 1, 1.0)
    // Row 2 is nothing at all: a node no part fixes.
    assert(s.solve().is_none())
