module sh.sysl.amber
@tests

import sysl.buf.{Buf, buf}
import sysl.math.{max, min, tau}
import sysl.raw.str_cast

// The Moog ladder example: a 110 Hz square through four transistor poles whose corner follows P1, the
// cutoff voltage.

// The amplitude of `v`, `dt` apart, at `hz`.
private at(v: Buf[real], dt: real, hz: real) -> real
    var re = 0.0
    var im = 0.0

    for k in 0..<v.len()
        val a = tau * hz * real(k) * dt

        re += v[k] * a.cos()
        im += v[k] * a.sin()

    2.0 * (re * re + im * im).sqrt() / real(v.len())

// The voice with P1 at `cutoff` volts, settled a quarter of a second, then a tenth of a second of it,
// sampled as the speaker plays it: its odd harmonics 1, 3, 5 … 15, as fractions of the first.
private voice(cutoff: real) -> Buf[real]
    val sch = parse_schematic(str_cast(embed("../../../examples/moog.amber"))).unwrap()
    var s = sim(sch.circuit)
    val p1 = sch.elements[usize(sch.find("P1").unwrap())].part
    val dt = 1.0 / 48000.0
    var v: Buf[real] = buf()

    s.set_supply(p1, regulated(cutoff, 10e-3))
    s.operating_point().unwrap()

    for k in 1..12000
        s.advance_to(real(k) * dt).unwrap()

    // Eleven whole cycles of 110 Hz.
    for k in 0..<4800
        s.advance_to(real(12000 + k) * dt).unwrap()
        v.push(s.voltage_at("voice"))

    val first = at(v, dt, 110.0)
    var out: Buf[real] = buf()

    out.push(first)

    for h in [3.0, 5.0, 7.0, 9.0, 11.0, 13.0, 15.0]
        out.push(at(v, dt, 110.0 * h) / first)

    out

// The speaker's voltage from `from` for `seconds`, `dt` apart, run on from where `s` is.
private span(s: *Sim, speaker: int, from: real, seconds: real, dt: real) -> Buf[real]
    var v: Buf[real] = buf()
    val count = int(seconds / dt)

    for k in 0..<count
        s.advance_to(from + real(k) * dt).unwrap()
        v.push(s.across(speaker))

    v

@test("a press of S1 plays a note: silent before, bright and loud at once, then darker and quieter as it fades")
moog_note()
    val sch = parse_schematic(str_cast(embed("../../../examples/moog.amber"))).unwrap()
    var s = sim(sch.circuit)
    val speaker = sch.elements[usize(sch.find("SPK").unwrap())].part
    val button = sch.elements[usize(sch.find("S1").unwrap())].part
    val dt = 1.0 / 24000.0

    s.operating_point().unwrap()

    val before = span(&s, speaker, dt, 0.2, dt)

    // A 10 ms tap, as a click gives.
    s.set_switch(button, true)
    span(&s, speaker, 0.2, 0.01, dt)
    s.set_switch(button, false)

    val early = span(&s, speaker, 0.21, 0.1, dt)
    val late = span(&s, speaker, 0.51, 0.3, dt)
    val loud = at(early, dt, 110.0)

    // Silent until struck: P1's 0.5 V leaves QT off and the ladder closed.
    assert(at(before, dt, 110.0) < loud / 1000.0)
    // Loud at once, fading to under half in half a second.
    assert(at(late, dt, 110.0) < 0.5 * loud)
    // Bright at once — the 9th harmonic most of a square's, which is a ninth of its first — and dark
    // as it fades.
    assert(at(early, dt, 990.0) / loud > 0.08)
    assert(at(late, dt, 990.0) / at(late, dt, 110.0) < 0.02)

// How far `v` swings above its average and how far below.
private swings(v: Buf[real]) -> (real, real)
    var sum = 0.0
    var hi = v[0]
    var lo = v[0]

    for k in 0..<v.len()
        sum += v[k]
        hi = max(hi, v[k])
        lo = min(lo, v[k])

    val mean = sum / real(v.len())

    (hi - mean, mean - lo)

@test("a struck note rings at its corner on both edges alike: the resonance does not slam the input pair from side to side")
moog_resonance_symmetric()
    val sch = parse_schematic(str_cast(embed("../../../examples/moog.amber"))).unwrap()
    var s = sim(sch.circuit)
    val button = sch.elements[usize(sch.find("S1").unwrap())].part
    val dt = 1.0 / 24000.0
    var v: Buf[real] = buf()

    s.operating_point().unwrap()
    s.set_switch(button, true)

    // Eleven cycles of the bright start, at the follower's output, the ladder's top.
    for k in 1..4800
        s.advance_to(real(k) * dt).unwrap()

        if k > 2400 then v.push(s.voltage_at("voice"))

    val (up, down) = swings(v)

    // A loop gain past the ladder's four sent each falling edge down two and a half times as far as
    // the rising edges went up, with the pair driven from one side to the other and back.
    assert(up > 0.1)
    assert(down < 1.25 * up && up < 1.25 * down)

    // And near its corner, around 1.6 kHz while struck, the ringing lifts a harmonic above where a
    // square has it, its nth at 1/n of its first.
    val first = at(v, dt, 110.0)
    var lifted = false

    for n in [11.0, 13.0, 15.0, 17.0, 19.0]
        if at(v, dt, 110.0 * n) / first > 1.0 / n then lifted = true

    assert(lifted)

@test("a struck note starts without a thump, and the speaker holds each half of the square level")
moog_no_thump_no_droop()
    val sch = parse_schematic(str_cast(embed("../../../examples/moog.amber"))).unwrap()
    var s = sim(sch.circuit)
    val speaker = sch.elements[usize(sch.find("SPK").unwrap())].part
    val button = sch.elements[usize(sch.find("S1").unwrap())].part
    val dt = 1.0 / 24000.0

    s.operating_point().unwrap()
    s.set_switch(button, true)

    val start = span(&s, speaker, dt, 0.03, dt)
    val note = span(&s, speaker, 0.03, 0.12, dt)
    val (up, down) = swings(note)
    var loudest = 0.0

    for k in 0..<start.len()
        loudest = max(loudest, start[k].abs())

    // Struck, the ladder's two columns both fall by volts as its current comes on. Heard from one
    // column, that fall was a thump twice the note's own swing; heard as their difference, it cancels.
    assert(loudest < 1.5 * max(up, down))

    // A square's half holds level: half way through a half-period and just before its end, the
    // speaker reads within a twentieth of the note's swing. Coupled to it through 2.2 µF, 2.2 ms against
    // a half-period of 4.5, each half sagged most of the way back.
    val half = 1.0 / 220.0
    var worst = 0.0

    for edge in 12..24
        val t = real(edge) * half
        val middle = s_at(note, 0.03, dt, t + 0.5 * half)
        val end = s_at(note, 0.03, dt, t + 0.95 * half)

        worst = max(worst, (end - middle).abs())

    assert(worst < 0.05 * (up + down))

// The reading of `v`, which starts at `from` and is `dt` apart, nearest time `t`.
private s_at(v: Buf[real], from: real, dt: real, t: real) -> real = v[usize(((t - from) / dt).round())]

// How much of the square's top end gets through: its 9th to 15th harmonics against its first.
private bright(h: Buf[real]) -> real = h[4] + h[5] + h[6] + h[7]

// P1's voltage reaches QT's base through RCV against REM to the emptied envelope, 47k / 57k of it:
// these are the voltages that put 0.9, 1.6 and 2.5 V on the base.
@test("the ladder's cutoff follows P1: dark at 1.1 V, its upper harmonics almost gone; bright at 3 V")
moog_cutoff()
    val dark = voice(1.1)
    val middle = voice(1.95)
    val open = voice(3.0)

    // A square's 9th harmonic is a ninth of its first; four poles below it take nearly all of it.
    assert(dark[4] < 0.02)
    assert(open[4] > 0.1)
    assert(bright(dark) < bright(middle) && bright(middle) < bright(open))
    // The fundamental gets through whatever the cutoff.
    assert(dark[0] > 0.08 && open[0] > 0.2)

@test("the ladder's tail transistor stays out of saturation across P1's range")
moog_tail()
    val sch = parse_schematic(str_cast(embed("../../../examples/moog.amber"))).unwrap()
    val qt = sch.elements[usize(sch.find("QT").unwrap())]
    val p1 = sch.elements[usize(sch.find("P1").unwrap())].part

    for cv in [1.1, 1.95, 3.0]
        var s = sim(sch.circuit)

        s.set_supply(p1, regulated(cv, 10e-3))
        s.operating_point().unwrap()

        // Its collector stays above its base.
        assert(s.voltage(qt.a) - s.voltage(qt.b) > 0.3)
