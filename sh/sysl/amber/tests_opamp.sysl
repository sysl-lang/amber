module sh.sysl.amber
@tests

import sysl.buf.{Buf, buf}
import sysl.math.{max, min, tau}
import sysl.raw.str_cast

// The op-amp macromodel against what an op-amp does: the gain feedback sets, the rails it stops short
// of, its bandwidth shrinking as its gain grows, how fast its output can move, the current it can give,
// and the supply current it takes.

private near(got: real, want: real, tol: real) -> bool = (got - want).abs() <= tol

// An op-amp on ±15 V, `input` at its non-inverting input, its output fed back to its inverting input
// through `rf` with `rg` from there to ground — a gain of 1 + rf / rg — and `load` from its output to
// ground. `rg` of 0 makes it a follower.
private non_inverting(m: OpAmpModel, input: Wave, rf: real, rg: real, load: real) -> Circuit
    var c = circuit()

    c.connect("VP", VoltageSource(Dc(15.0)), "vp", "0")
    c.connect("VN", VoltageSource(Dc(-15.0)), "vn", "0")
    c.connect("VIN", VoltageSource(input), "in", "0")

    val (a, b, o, p, n) = (c.node("in"), c.node("minus"), c.node("out"), c.node("vp"), c.node("vn"))

    c.add5("U1", OpAmp(m), a, b, o, p, n)

    if rg > 0.0
        c.connect("RF", Resistor(rf), "out", "minus")
        c.connect("RG", Resistor(rg), "minus", "0")
    else
        c.connect("RF", Resistor(1.0), "out", "minus")

    c.connect("RL", Resistor(load), "out", "0")
    c

@test("feedback sets an op-amp's gain: 1 + rf / rg the right way up, and −rf / rin upside down")
opamp_gain()
    var s = sim(non_inverting(OPAMP_741, Dc(0.1), 10e3, 1e3, 10e3))

    s.operating_point().unwrap()

    // The loop's own gain, 200,000 over 11, leaves the closed loop short by a part in 18,000.
    assert(near(s.voltage_at("out"), 1.1, 1.1 / 10000.0))
    assert(near(s.voltage_at("minus"), 0.1, 1e-4))

    // Inverting: the input through 1k to the inverting input, 10k back from the output.
    var c = circuit()

    c.connect("VP", VoltageSource(Dc(15.0)), "vp", "0")
    c.connect("VN", VoltageSource(Dc(-15.0)), "vn", "0")
    c.connect("VIN", VoltageSource(Dc(0.3)), "in", "0")
    c.connect("RIN", Resistor(1e3), "in", "minus")
    c.connect("RF", Resistor(10e3), "minus", "out")
    c.add5("U1", OpAmp(OPAMP_741), 0, c.node("minus"), c.node("out"), c.node("vp"), c.node("vn"))

    var t = sim(c)

    t.operating_point().unwrap()
    assert(near(t.voltage_at("out"), -3.0, 3.0 / 10000.0))
    assert(t.voltage_at("minus").abs() < 1e-3)

@test("an op-amp asked for more than its supplies allow stops a volt and a half short of each")
opamp_rails()
    // Short by its headroom, and by what its load's 2.5 mA drops across its 75 Ω besides.
    for (input, want) in [(2.0, 13.5 - 0.19), (-2.0, -13.5 + 0.19)]
        var s = sim(non_inverting(OPAMP_741, Dc(input), 10e3, 1e3, 10e3))

        s.operating_point().unwrap()
        assert(near(s.voltage_at("out"), want, 0.05))

    // On a single 5 V supply, it reaches neither 0 nor 5.
    var c = circuit()

    c.connect("VP", VoltageSource(Dc(5.0)), "vp", "0")
    c.connect("VIN", VoltageSource(Dc(1.0)), "in", "0")
    c.add5("U1", OpAmp(OPAMP_741), c.node("in"), 0, c.node("out"), c.node("vp"), 0)
    c.connect("RL", Resistor(10e3), "out", "0")

    var s = sim(c)

    s.operating_point().unwrap()
    assert(near(s.voltage_at("out"), 3.5, 0.05))

@test("an op-amp's gain falls as its gain-bandwidth over the frequency: a gain of 11 is 3 dB down at GBW / 11")
opamp_bandwidth()
    for m in [OPAMP_741, OPAMP_TL072]
        val c = non_inverting(m, Dc(0.0), 10e3, 1e3, 10e3)
        var s = sim(c)
        val out = c.find_node("out").unwrap()

        for (hz, want) in [(m.gbw / 1000.0, 11.0), (m.gbw / 11.0, 11.0 / 2.0.sqrt()), (m.gbw, 1.0)]
            val r = s.response(hz, [drive(2, 1.0, 0.0)]).unwrap()

            assert((r.voltage(out).abs() - want).abs() < 0.03 * want)

    // Open loop, its own gain, and its corner at GBW / gain.
    var c = circuit()

    c.connect("VP", VoltageSource(Dc(15.0)), "vp", "0")
    c.connect("VN", VoltageSource(Dc(-15.0)), "vn", "0")
    c.connect("VIN", VoltageSource(Dc(0.0)), "in", "0")
    c.add5("U1", OpAmp(OPAMP_741), c.node("in"), 0, c.node("out"), c.node("vp"), c.node("vn"))

    var s = sim(c)
    val out = c.find_node("out").unwrap()

    assert((s.response(0.1, [drive(2, 1.0, 0.0)]).unwrap().voltage(out).abs() - 2e5).abs() < 0.01 * 2e5)
    assert((s.response(5.0, [drive(2, 1.0, 0.0)]).unwrap().voltage(out).abs() - 2e5 / 2.0.sqrt()).abs() < 0.02 * 2e5)

@test("a follower given a step moves at its slew rate: half a volt a microsecond for the 741, 13 for the TL072")
opamp_slew()
    for m in [OPAMP_741, OPAMP_TL072]
        var s = sim(non_inverting(m, Pulse(-5.0, 5.0, 1e-6, 1e-9, 1e-9, 1.0, 2.0), 0.0, 0.0, 10e3))

        s.operating_point().unwrap()

        // When it passes −2.5 V and +2.5 V on its way up.
        var t_lo = 0.0
        var t_hi = 0.0
        var t = 1e-6

        while t < 1e-6 + 40e-6 && t_hi == 0.0
            t += 2e-9
            s.advance_to(t).unwrap()

            val v = s.voltage_at("out")

            if t_lo == 0.0 && v > -2.5 then t_lo = t
            if v > 2.5 then t_hi = t

        val rate = 5.0 / (t_hi - t_lo)

        assert(rate > 0.9 * m.slew && rate < 1.1 * m.slew)

@test("an op-amp gives no more than 25 mA: into 8 Ω its output stops near 0.2 V, and it says so by clipping")
opamp_current_limit()
    var s = sim(non_inverting(OPAMP_741, Dc(1.0), 0.0, 0.0, 8.0))

    s.operating_point().unwrap()

    val out = s.voltage_at("out")

    // 25 mA into 8 Ω, and the few microvolts the input's 0.4 µA through its 2 MΩ adds.
    assert(out > 0.15 && out < 0.2 + 1e-5)
    // The op-amp gives no more than its 25 mA (its current is what flows out of its output), and the
    // load, RL, carries that and the input's 0.4 µA.
    assert(s.current(3) < 25e-3 && s.current(3) > 24.9e-3)
    assert(near(s.current(5), s.current(3) + 0.4e-6, 1e-8))

    // A light load is no trouble: 1 V into 1k is 1 V.
    var light = sim(non_inverting(OPAMP_741, Dc(1.0), 0.0, 0.0, 1e3))

    light.operating_point().unwrap()
    assert(near(light.voltage_at("out"), 1.0, 1e-3))

@test("an op-amp's supplies carry its own current and its load's: sourced from the positive, sunk to the negative")
opamp_supply_current()
    for (input, sourcing) in [(1.0, true), (-1.0, false)]
        var s = sim(non_inverting(OPAMP_741, Dc(input), 0.0, 0.0, 100.0))

        s.operating_point().unwrap()

        // 10 mA into the load.
        val load = s.voltage_at("out") / 100.0
        // A battery's current is negative while it delivers.
        val positive = -s.current(0)
        val negative = s.current(1)

        assert(near(load.abs(), 10e-3, 1e-4))

        if sourcing
            assert(near(positive, 1.7e-3 + load, 1e-5) && near(negative, 1.7e-3, 1e-5))
        else
            assert(near(positive, 1.7e-3, 1e-5) && near(negative, 1.7e-3 - load, 1e-5))

        // And every terminal's current sums to nothing.
        var sum = 0.0

        for k in 0..<5
            sum += s.terminal_current(3, k)

        assert(sum.abs() < 1e-12)

// --- In a schematic ---------------------------------------------------------------------------------

@test("a schematic's op-amp is placed by its middle, its five pins around it, the 741 unless it says")
opamp_schematic()
    val sch = parse_schematic("opamp U1 10 8\nopamp U2 20 8 TL072").unwrap()
    val u1 = sch.elements[0]

    assert(u1.shape == OpAmp && u1.value == "741")
    assert(u1.point(0) == (8, 9) && u1.point(1) == (8, 7) && u1.point(2) == (12, 8))
    assert(u1.point(3) == (10, 6) && u1.point(4) == (10, 10))
    assert(sch.circuit.parts[0].kind == OpAmp(OPAMP_741))
    assert(sch.circuit.parts[1].kind == OpAmp(OPAMP_TL072))

    // Each pin is its own node, joined to whatever reaches its point.
    val wired = parse_schematic("opamp U1 10 8\nresistor R1 12 8 14 8 1k\nwire 10 6 10 2\nground 10 10").unwrap()
    val p = wired.circuit.parts[0]

    assert(p.c == wired.circuit.parts[1].a)
    assert(p.e == 0)
    assert(p.d > 0 && p.a != p.b && p.a != p.d)

    assert(parse_schematic("opamp").unwrap_err() == "line 1: an opamp needs a name")
    assert(parse_schematic("opamp U1 3").unwrap_err() == "line 1: an opamp is placed by 1 point, its middle")
    assert(parse_schematic("opamp U1 3 4 LM358").unwrap_err() == "line 1: 'LM358' is not an op-amp model: 741 or TL072")
    assert(parse_schematic("opamp U1 3 4 741 fast").unwrap_err() == "line 1: 'fast' is more than an opamp takes")

// The amplitude of `v`, `dt` apart, at `hz`, and its harmonics' total against it.
private tone_of(v: Buf[real], dt: real, hz: real) -> (real, real)
    val at = (f: real) ->
        var re = 0.0
        var im = 0.0

        for k in 0..<v.len()
            val a = tau * f * real(k) * dt

            re += v[k] * a.cos()
            im += v[k] * a.sin()

        2.0 * (re * re + im * im).sqrt() / real(v.len())

    var sum = 0.0

    for h in 2..5
        sum += at(hz * real(h)) * at(hz * real(h))

    (at(hz), sum.sqrt() / at(hz))

@test("the op-amp example: eleven times the generator's 50 mV into the speaker, a clean sine, while U1 jumps the push-pull pair's gap")
opamp_example()
    var s = sim(parse_schematic(str_cast(embed("../../../examples/opamp.amber"))).unwrap().circuit)
    var out: Buf[real] = buf()
    var drive: Buf[real] = buf()
    val dt = 1.0 / 48000.0

    s.operating_point().unwrap()

    // Ten cycles of 440 Hz in, then ten to measure, a sample at a time as the viewer plays it.
    for k in 1..2400
        s.advance_to(real(k) * dt).unwrap()

    for k in 0..<1091
        s.advance_to(real(2400 + k) * dt).unwrap()
        out.push(s.voltage_at("out"))
        drive.push(s.voltage(s.circuit.parts[3].c))

    val (swing, thd) = tone_of(out, dt, 440.0)
    val (_, notched) = tone_of(drive, dt, 440.0)

    assert(swing > 0.53 && swing < 0.56)
    assert(thd < 0.01)
    // U1's own output is far from a sine: it carries the gap the pair would leave.
    assert(notched > 5.0 * thd)

    // And the push-pull pair, not U1, carries the speaker's current: U1 gives a few hundredths of it.
    var most_speaker = 0.0
    var most_u1 = 0.0

    for k in 0..<480
        s.advance_to(real(3491 + k) * dt).unwrap()
        most_speaker = most_speaker.max(s.voltage_at("out").abs() / 8.0)
        most_u1 = most_u1.max(s.current(3).abs())

    assert(most_speaker > 0.06 && most_u1 < 0.05 * most_speaker)
