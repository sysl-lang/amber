module sh.sysl.amber

import sysl.buf.{Buf, buf}
import sysl.math.{max, min}

// The thermal voltage kT/q at 27 °C, 300.15 K, the temperature SPICE assumes, from the exact SI values of
// Boltzmann's constant and the electron's charge.
const VT: real = 1.380649e-23 * 300.15 / 1.602176634e-19

// A conductance put across every junction, so a reverse-biased diode is a very large resistor rather
// than an open circuit that leaves its node floating. A capacitor is one too while the circuit is
// solved for DC, where it is otherwise no connection at all.
const GMIN: real = 1e-12

const MOST_ITERATIONS: int = 150

// A closed switch's resistance. An open one is no connection at all: each side is held to ground by
// GMIN alone, so a node the switch was the only way to is left at nothing rather than floating, and
// nothing leaks across it.
const CLOSED_OHMS: real = 0.01

// How closely a step must follow the circuit: a node's error may be a ten-thousandth of its voltage, or
// a microvolt, whichever is larger. The errors of a run's steps add up, so this keeps a decay a few
// hundred steps long within a few parts in ten thousand of the formula, below the third figure a meter
// shows.
const REL_TOL: real = 1e-4
const ABS_TOL: real = 1e-6

// The first step after the start and after a corner, a nanosecond, and the shortest step the solver
// will take before giving up.
const FIRST_STEP: real = 1e-9
const SHORTEST_STEP: real = 1e-18

// How the parts that remember are written into the system: not at all (DC, where a capacitor is open
// and an inductor a wire), by backward Euler, or by the trapezoidal rule.
enum Method: u8
    Steady
    Euler
    Trapezoid

// The circuit's solution, found by modified nodal analysis, at a moment in time.
//
// **The unknowns are the node voltages and some currents.** Kirchhoff's current law at every node but
// ground gives one equation per voltage. A voltage source fixes the difference between two nodes
// rather than a current, so it adds the current through itself as an unknown and its own voltage as
// the equation for it; an inductor does the same. A diode's series resistance puts a node inside the
// diode, between the resistance and the junction, which is an unknown the circuit never names.
//
// **A diode is not linear**, so the system is solved by Newton–Raphson: the diode is replaced by the
// straight line touching its curve at the voltage it has now, the linear system is solved, and the
// voltage moves to the answer; repeated until nothing moves. A transistor is two junctions, base to
// emitter and base to collector, and each terminal's current is linearised against both. The step a junction may take is limited,
// since the exponential sends an unlimited step to infinity. A MOSFET's drain current is linearised
// against its gate–source and drain–source voltages, and their steps are limited too, as SPICE limits
// them, since a square law far from where it was linearised overshoots as badly.
//
// **Time moves in steps.** Over a step of length h a capacitor's dv/dt is written as a difference, so
// it becomes a conductance in parallel with a current source, both fixed by the voltage and current it
// had at the step's start — its *companion*. The trapezoidal rule averages the slopes at both ends and
// is accurate; backward Euler takes the slope at the end and is crude but cannot ring, so it takes the
// first step after the start and after every corner, where the trapezoidal rule would oscillate. Each
// step's answer is compared with where the last three put it; a step that strayed too far is thrown
// away and taken again shorter, and a step that followed closely lets the next be longer.
struct Sim
    circuit: Circuit
    // The unknown each part adds, by part: the current through a voltage source or an inductor, or a
    // diode's inner node. -1 where the part adds none.
    extra: Buf[int]
    // The junction voltages each part was last linearised at, two by part: at `2i` a diode's junction or
    // a transistor's base–emitter one, at `2i + 1` a transistor's base–collector one. A MOSFET's are its
    // gate–source voltage at `2i` and its drain–source voltage at `2i + 1`.
    junction: Buf[real]
    size: int
    x: Buf[real]
    sys: System
    // A conductance from every node to ground while the solution is approached by steps; 0 otherwise.
    shunt: real
    // The time the solution is at, in seconds.
    time: real
    method: Method
    // The length of the step being solved, and the one the next step will try.
    step: real
    next_step: real
    // The longest step the caller allows; the waves may ask for less.
    longest_step: real
    // What each capacitor and inductor had at the last accepted time: the voltage across it and the
    // current through it.
    held_v: Buf[real]
    held_i: Buf[real]
    // The two accepted solutions before the present one, and their times, for judging a step's error;
    // `history` counts how many of them are since the last corner.
    back1: Buf[real]
    back2: Buf[real]
    time1: real
    time2: real
    history: int
    // Whether the operating point has been found, which time starts from.
    started: bool
    // A copy of the solution and junctions to go back to when a step is thrown away.
    saved_x: Buf[real]
    saved_junction: Buf[real]
    // Steps taken and steps thrown away, for anyone curious how hard the circuit was.
    accepted: int
    rejected: int
    // What each capacitor holds (volts) and each inductor carries (amps) when the circuit is switched
    // on; zero unless `set_initial` says otherwise.
    initial: Buf[real]

    // The voltage at node `node` against ground.
    voltage(self, node: int) -> real = if node <= 0 then 0.0 else self.x[usize(node - 1)]

    // The voltage at the node called `name`; 0 for a name the circuit does not have.
    voltage_at(self, name: string) -> real = self.circuit.find_node(name) match
        Some(n) -> self.voltage(n)
        None -> 0.0

    // The voltage across part `i`: its first terminal's less its second's. A transistor's is from its
    // collector to its emitter, and a MOSFET's from its drain to its source.
    across(self, i: int) -> real
        val p = self.circuit.parts[usize(i)]

        if p.kind.terminals() == 3 then return self.voltage(p.a) - self.voltage(p.c)

        self.voltage(p.a) - self.voltage(p.b)

    // The current through part `i`, from its first terminal to its second. A battery delivering power
    // has current flowing out of its first terminal, `+`, so its current here is negative. A
    // transistor's is the current into its collector, and a MOSFET's the current into its drain.
    current(self, i: int) -> real
        val p = self.circuit.parts[usize(i)]

        p.kind match
            Resistor(r) -> self.across(i) / r
            Capacitor(_) -> self.held_i[usize(i)]
            Inductor(_) -> self.x[usize(self.extra[usize(i)])]
            VoltageSource(_) -> self.x[usize(self.extra[usize(i)])]
            CurrentSource(w) -> w.at(self.time)
            Generator(w, ohms) -> (self.across(i) - w.at(self.time)) / ohms
            Supply(s) ->
                val v = self.junction[usize(2 * i)]
                val (amps, slope) = supply_line(s, s.wave().at(self.time), v)

                GMIN * self.across(i) - amps - slope * (self.across(i) - v)
            Diode(m) ->
                val v = self.junction[usize(2 * i)]

                diode_current(m, v) + GMIN * v + (diode_conductance(m, v) + GMIN) * (self.junction_now(i) - v)
            Switch(closed) -> if closed then self.across(i) / CLOSED_OHMS else 0.0
            Transistor(_) | Mosfet(_, _, _) -> self.terminal_current(i, 0)

    // The current flowing into part `i` at terminal `k`, counting from 0. The currents into a part's
    // terminals sum to zero: a two-terminal part's second is the first's negative, a transistor's
    // emitter carries what its collector and base do, back out, and a MOSFET's gate carries nothing,
    // so its source carries its drain's current back out.
    //
    // A transistor's currents, like a diode's, are read off the lines its junctions were linearised
    // on, at the voltages the solution puts across them, so they are the currents the system balanced
    // and every node's sum to zero exactly. A MOSFET's are read the same way.
    terminal_current(self, i: int, k: int) -> real
        val p = self.circuit.parts[usize(i)]

        if p.kind is Mosfet(m, w, l)
            val t = if m.pmos then -1.0 else 1.0
            val vgs = self.junction[usize(2 * i)]
            val vds = self.junction[usize(2 * i + 1)]
            val line = mosfet_line(m, w, l, vgs, vds)
            val (now_gs, now_ds) = self.mosfet_now(i)
            val id = t * (line.id + line.gm * (now_gs - vgs) + line.gds * (now_ds - vds))

            return k match
                0 -> id
                1 -> 0.0
                _ -> -id

        if p.kind is Transistor(m)
            val t = if m.pnp then -1.0 else 1.0
            val vbe = self.junction[usize(2 * i)]
            val vbc = self.junction[usize(2 * i + 1)]
            val l = transistor_line(m, vbe, vbc)
            val (now_be, now_bc) = self.transistor_now(i)
            val ic = t * (l.ic + l.ic_be * (now_be - vbe) + l.ic_bc * (now_bc - vbc))
            val ib = t * (l.ib + l.ib_be * (now_be - vbe) + l.ib_bc * (now_bc - vbc))

            return k match
                0 -> ic
                1 -> ib
                _ -> -ic - ib

        if k == 0 then self.current(i) else -self.current(i)

    // The power part `i` takes from the circuit, in watts; negative for a part delivering it. A
    // transistor's or a MOSFET's is what flows into each terminal times the terminal's voltage, summed.
    power(self, i: int) -> real
        val p = self.circuit.parts[usize(i)]

        if p.kind.terminals() == 3
            var w = 0.0

            for k in 0..<3
                w += self.voltage(p.terminal(k)) * self.terminal_current(i, k)

            return w

        self.across(i) * self.current(i)

    // The voltage across diode `i`'s junction in the present solution.
    private junction_now(self, i: int) -> real
        val p = self.circuit.parts[usize(i)]
        val inner = self.extra[usize(i)]
        val anode = if inner >= 0 then self.x[usize(inner)] else self.voltage(p.a)

        anode - self.voltage(p.b)

    // The voltages across transistor `i`'s base–emitter and base–collector junctions in the present
    // solution, each positive when it forward-biases the junction, whichever polarity the transistor is.
    private transistor_now(self, i: int) -> (real, real)
        val p = self.circuit.parts[usize(i)]
        val t = if p.kind is Transistor(m) && m.pnp then -1.0 else 1.0
        val vb = self.voltage(p.b)

        (t * (vb - self.voltage(p.c)), t * (vb - self.voltage(p.a)))

    // MOSFET `i`'s gate–source and drain–source voltages in the present solution, reversed for a
    // p-channel one, so either polarity is on when they are positive.
    private mosfet_now(self, i: int) -> (real, real)
        val p = self.circuit.parts[usize(i)]
        val t = if p.kind is Mosfet(m, _, _) && m.pmos then -1.0 else 1.0
        val vs = self.voltage(p.c)

        (t * (self.voltage(p.b) - vs), t * (self.voltage(p.a) - vs))

    // Open or close switch `i`. The circuit changes abruptly, which is a corner: the next step is short
    // and taken by backward Euler.
    set_switch(*self, i: int, closed: bool)
        self.circuit.parts[usize(i)].kind = Switch(closed)
        self.corner()

    // Give source `i` a new wave from now on; a corner, as `set_switch` is.
    set_wave(*self, i: int, w: Wave)
        self.circuit.parts[usize(i)].kind match
            VoltageSource(_) -> self.circuit.parts[usize(i)].kind = VoltageSource(w)
            CurrentSource(_) -> self.circuit.parts[usize(i)].kind = CurrentSource(w)
            Generator(_, ohms) -> self.circuit.parts[usize(i)].kind = Generator(w, ohms)
            _ -> return

        self.corner()

    // Give supply `i` new settings from now on; a corner, as `set_switch` is. A raw supply's ripple
    // keeps its timing, which runs from the start of time as the mains does.
    set_supply(*self, i: int, s: PowerSupply)
        if !(self.circuit.parts[usize(i)].kind is Supply(_)) then return

        self.circuit.parts[usize(i)].kind = Supply(s)
        self.corner()

    // Whether supply `i` is holding its current limit, its voltage given up to the load: a bench
    // supply's CC lamp. False for a supply holding its voltage, and for any other part.
    current_limited(self, i: int) -> bool = self.circuit.parts[usize(i)].kind match
        Supply(s) -> (s.wave().at(self.time) - self.across(i)) / s.resistance() > s.amps
        _ -> false

    // Find the DC operating point at the present time: every voltage and current with the circuit
    // settled, capacitors charged and inductors' currents steady. Time starts from here.
    //
    // Newton–Raphson from the last solution; if that does not converge, the circuit is first solved
    // with a conductance from every node to ground, which makes it easy, and the conductance is taken
    // away a decade at a time, each solution starting the next.
    operating_point(*self) -> Result[unit, string]
        self.method = Steady
        self.shunt = 0.0

        if self.newton().is_err()
            self.reset()

            var g = 1e-2

            while g > 1e-13
                self.shunt = g

                if self.newton() is Err(why)
                    self.shunt = 0.0
                    return Err(why)

                g /= 10.0

            self.shunt = 0.0
            self.newton()?

        for i in 0..<self.circuit.parts.len()
            self.held_v[i] = self.across(int(i))
            self.held_i[i] = self.circuit.parts[i].kind match
                Inductor(_) -> self.x[usize(self.extra[i])]
                _ -> 0.0

        self.started = true
        self.corner()
        Ok(())

    // Have capacitor `i` hold `value` volts, or inductor `i` carry `value` amps, when the circuit is
    // switched on, rather than nothing.
    set_initial(*self, i: int, value: real) = self.initial[usize(i)] = value

    // Switch the circuit on at the present time with every capacitor empty and no current in any
    // inductor (or holding what `set_initial` gave it), rather than settled as `operating_point` finds
    // it. This is a circuit just built and
    // connected to its battery: it starts where it is and moves from there.
    //
    // The solution at the instant of switching on is found with each capacitor a short circuit holding
    // zero volts and each inductor an open one carrying nothing: a backward Euler step a femtosecond
    // long, from all of them empty.
    power_on(*self) -> Result[unit, string]
        for i in 0..<self.circuit.parts.len()
            self.held_v[i] = 0.0
            self.held_i[i] = 0.0

            self.circuit.parts[i].kind match
                Capacitor(_) -> self.held_v[i] = self.initial[i]
                Inductor(_) -> self.held_i[i] = self.initial[i]
                _ -> ()

        self.method = Euler
        self.step = 1e-15
        self.shunt = 0.0
        self.newton()?

        for i in 0..<self.circuit.parts.len()
            self.circuit.parts[i].kind match
                Capacitor(farads) ->
                    val (g, owed) = self.capacitor_companion(farads, int(i))

                    self.held_i[i] = g * self.across(int(i)) - owed
                    self.held_v[i] = self.initial[i]
                _ -> ()

        self.started = true
        self.corner()
        Ok(())

    // Run the circuit forward to time `until`, landing on it exactly. The operating point is found
    // first if it has not been.
    advance_to(*self, until: real) -> Result[unit, string]
        if !self.started then self.operating_point()?

        while self.time < until
            // A time a rounding error past where a step landed — a corner at 0.1 ms, asked for as
            // 5 × 20 µs = 0.10000000000000002 ms — is where the solution already is.
            if until - self.time <= 1e-12 * until.abs()
                self.time = until
                break

            val target = self.step_end(until)

            // Likewise a corner a rounding error ahead, where a step of 20 µs from 80 µs landed at
            // 99.99999999999999 µs: the solution is moved onto it, and starts afresh from it.
            if target - self.time <= 1e-12 * target.abs()
                self.time = target
                self.corner()
                continue

            self.take_step(target)?

        Ok(())

    // Where the next step should end: no further than the step the error allows, the longest step the
    // caller and the waves allow, the next corner of any wave, or `until`.
    private step_end(self, until: real) -> real
        var h = min(self.next_step, self.longest_step)

        for i in 0..<self.circuit.parts.len()
            if self.circuit.parts[i].kind.wave() is Some(w) then h = min(h, w.longest_step())

        var end = min(until, self.time + h)

        for i in 0..<self.circuit.parts.len()
            if self.circuit.parts[i].kind.wave() is Some(w)
                if w.next_corner(self.time) is Some(c) then end = min(end, c)

        // A step ending a rounding error short of `until` would leave a remainder too short to take:
        // 2.5 ms + 0.5 ms is 2.9999999999999996 ms. It ends on `until` instead.
        if end < until && until - end <= 1e-6 * (end - self.time) then end = until

        end

    // Take one step to `target`, shortening it and trying again while it fails to converge or strays
    // too far.
    private take_step(*self, target: real) -> Result[unit, string]
        var end = target

        copy(&self.x, &self.saved_x)
        copy(&self.junction, &self.saved_junction)

        loop
            val h = end - self.time

            if h < SHORTEST_STEP then return Err(s"the step needed at t = ${engineering(self.time)}s is too short: the circuit changes faster than it can be followed")

            self.step = h

            val solved = self.newton_at(end)

            if solved.is_ok()
                val err = self.step_error(end)

                if err <= 1.0
                    self.accept(end, err)
                    return Ok(())

                self.rejected += 1
                end = self.time + h * max(0.2, 0.9 * (1.0 / err).cbrt())
            else
                self.rejected += 1
                end = self.time + h / 8.0

            copy(&self.saved_x, &self.x)
            copy(&self.saved_junction, &self.junction)

    // Solve the system for the time `end`, the step length already set.
    private newton_at(*self, end: real) -> Result[unit, string]
        val now = self.time

        self.time = end

        val result = self.newton()

        self.time = now
        result

    // How far the step's solution strayed from where the last three solutions point, as a multiple of
    // what the tolerances allow. Until three solutions since the last corner are known, nothing can be
    // judged and the step is taken as good.
    private step_error(self, end: real) -> real
        if self.history < 2 || self.method != Trapezoid then return 0.5

        val t0 = self.time
        val t1 = self.time1
        val t2 = self.time2
        var worst = 0.0

        for k in 0..<self.size
            val x0 = self.saved_x[usize(k)]
            val x1 = self.back1[usize(k)]
            val x2 = self.back2[usize(k)]
            // The parabola through the last three solutions, read at `end`.
            val predicted = x0 * (end - t1) * (end - t2) / ((t0 - t1) * (t0 - t2)) +
                x1 * (end - t0) * (end - t2) / ((t1 - t0) * (t1 - t2)) +
                x2 * (end - t0) * (end - t1) / ((t2 - t0) * (t2 - t1))
            val got = self.x[usize(k)]
            // The trapezoidal rule's own error is about a twelfth of the parabola's miss.
            val err = (got - predicted).abs() / 12.0 / (REL_TOL * max(got.abs(), x0.abs()) + ABS_TOL)

            worst = max(worst, err)

        worst

    // Make the step to `end` the present: remember what the capacitors and inductors now hold, shift
    // the history, and choose the next step's length from how well this one went.
    private accept(*self, end: real, err: real)
        val h = end - self.time

        for i in 0..<self.circuit.parts.len()
            self.circuit.parts[i].kind match
                Capacitor(farads) ->
                    val v = self.across(int(i))
                    val (g, owed) = self.capacitor_companion(farads, int(i))

                    self.held_i[i] = g * v - owed
                    self.held_v[i] = v
                Inductor(_) ->
                    self.held_i[i] = self.x[usize(self.extra[i])]
                    self.held_v[i] = self.across(int(i))
                _ -> ()

        copy(&self.back1, &self.back2)
        copy(&self.saved_x, &self.back1)
        self.time2 = self.time1
        self.time1 = self.time
        self.time = end
        self.history += 1
        self.accepted += 1

        // A step landing on a corner makes the next one a fresh start.
        var on_corner = false

        for i in 0..<self.circuit.parts.len()
            if self.circuit.parts[i].kind.wave() is Some(w)
                if w.next_corner(self.time1) is Some(c)
                    if (c - end).abs() <= 1e-15 * max(1.0, end.abs()) then on_corner = true

        val grown = if err > 0.0 then h * min(2.0, 0.9 * (1.0 / err).cbrt()) else h * 2.0

        self.next_step = max(grown, FIRST_STEP)

        if on_corner
            self.corner()
        else
            self.method = Trapezoid

    // Something changed abruptly: start again with a short step by backward Euler, with no history to
    // judge it by.
    private corner(*self)
        self.method = Euler
        self.next_step = FIRST_STEP
        self.history = 0

    // A capacitor's companion for the present step: the conductance, and the current it is offset by,
    // so that the current through it is `g · v − owed`.
    private capacitor_companion(self, farads: real, i: int) -> (real, real) = self.method match
        Steady -> (GMIN, 0.0)
        Euler ->
            val g = farads / self.step

            (g, g * self.held_v[usize(i)])
        Trapezoid ->
            val g = 2.0 * farads / self.step

            (g, g * self.held_v[usize(i)] + self.held_i[usize(i)])

    // Forget the solution and start the next one from zero.
    private reset(*self)
        for i in 0..<self.x.len()
            self.x[i] = 0.0

        for i in 0..<self.junction.len()
            self.junction[i] = 0.0

    private newton(*self) -> Result[unit, string]
        for _ in 0..<MOST_ITERATIONS
            self.stamp()

            if self.sys.solve().is_none() then return Err(self.singular())

            var settled = true

            for i in 0..<self.size
                val was = self.x[usize(i)]
                val now = self.sys.z[usize(i)]

                if (now - was).abs() > 1e-6 * max(now.abs(), was.abs()) + 1e-9 then settled = false

                self.x[usize(i)] = now

            // A junction is settled when the solution puts it where it was linearised. It is then left
            // at that voltage, so a diode's current is read off the same line the system obeyed and the
            // currents at every node sum to zero exactly.
            for i in 0..<self.circuit.parts.len()
                self.circuit.parts[i].kind match
                    Diode(_) ->
                        if !close(self.junction[2 * i], self.junction_now(int(i))) then settled = false
                    Supply(_) ->
                        if !close(self.junction[2 * i], self.across(int(i))) then settled = false
                    Transistor(_) ->
                        val (be, bc) = self.transistor_now(int(i))

                        if !close(self.junction[2 * i], be) || !close(self.junction[2 * i + 1], bc) then settled = false
                    Mosfet(_, _, _) ->
                        val (gs, ds) = self.mosfet_now(int(i))

                        if !close(self.junction[2 * i], gs) || !close(self.junction[2 * i + 1], ds) then settled = false
                    _ -> ()

            if settled then return Ok(())

            self.limit_junctions()

        Err("the solution did not settle")

    // Move each junction's voltage toward the new solution, limiting the step.
    private limit_junctions(*self)
        for i in 0..<self.circuit.parts.len()
            self.circuit.parts[i].kind match
                Diode(m) ->
                    val nvt = m.n * VT
                    val now = self.junction_now(int(i))
                    val was = self.junction[2 * i]
                    val vcrit = critical(nvt, m.is)

                    // Reversed near its breakdown, a zener's step is limited on the breakdown's own
                    // exponential, measured back from its knee, as SPICE limits it.
                    if m.bv > 0.0
                        val k = knee(m)

                        if now < min(0.0, -k + 10.0 * nvt)
                            self.junction[2 * i] = -limit(-(now + k), -(was + k), nvt, vcrit) - k
                            continue

                    self.junction[2 * i] = limit(now, was, nvt, vcrit)
                Supply(_) -> self.junction[2 * i] = self.across(int(i))
                Transistor(m) ->
                    // SPICE limits a transistor's junctions on the bare thermal voltage, whatever their
                    // emission coefficients.
                    val (be, bc) = self.transistor_now(int(i))
                    val vcrit = critical(VT, m.is)

                    self.junction[2 * i] = limit(be, self.junction[2 * i], VT, vcrit)
                    self.junction[2 * i + 1] = limit(bc, self.junction[2 * i + 1], VT, vcrit)
                Mosfet(m, _, _) ->
                    // SPICE's way: the gate's step is limited against the threshold, on whichever
                    // terminal is the source now, and the drain's step after it.
                    val (gs, ds) = self.mosfet_now(int(i))
                    val was_gs = self.junction[2 * i]
                    val was_ds = self.junction[2 * i + 1]
                    val vt = threshold(m)

                    if was_ds >= 0.0
                        val vgs = fetlim(gs, was_gs, vt)
                        val vds = limvds(vgs - (gs - ds), was_ds)

                        self.junction[2 * i] = vgs
                        self.junction[2 * i + 1] = vds
                    else
                        val vgd = fetlim(gs - ds, was_gs - was_ds, vt)
                        val vds = -limvds(vgd - gs, -was_ds)

                        self.junction[2 * i] = vgd + vds
                        self.junction[2 * i + 1] = vds
                _ -> ()

    // Write the linearised system for the present solution at the present time.
    private stamp(*self)
        self.sys.clear()

        val nodes = self.circuit.node_count() - 1

        if self.shunt > 0.0
            for k in 0..<nodes
                self.sys.at(k, k, self.shunt)

        for i in 0..<self.circuit.parts.len()
            val p = self.circuit.parts[i]
            val a = p.a - 1
            val b = p.b - 1

            p.kind match
                Resistor(r) -> self.conductance(a, b, 1.0 / r)
                Switch(closed) ->
                    if closed
                        self.conductance(a, b, 1.0 / CLOSED_OHMS)
                    else
                        self.sys.at(a, a, GMIN)
                        self.sys.at(b, b, GMIN)
                Capacitor(farads) ->
                    val (g, owed) = self.capacitor_companion(farads, int(i))

                    self.conductance(a, b, g)
                    self.sys.rhs(a, owed)
                    self.sys.rhs(b, -owed)
                Inductor(henries) ->
                    // The branch equation v_a − v_b − r · i = e, where the companion's resistance `r`
                    // and voltage `e` come from the current and voltage at the step's start.
                    val k = self.extra[i]
                    val (r, e) = self.method match
                        Steady -> (0.0, 0.0)
                        Euler ->
                            val r = henries / self.step

                            (r, -r * self.held_i[i])
                        Trapezoid ->
                            val r = 2.0 * henries / self.step

                            (r, -r * self.held_i[i] - self.held_v[i])

                    self.sys.at(a, k, 1.0)
                    self.sys.at(b, k, -1.0)
                    self.sys.at(k, a, 1.0)
                    self.sys.at(k, b, -1.0)
                    self.sys.at(k, k, -r)
                    self.sys.rhs(k, e)
                VoltageSource(w) ->
                    val k = self.extra[i]

                    self.sys.at(a, k, 1.0)
                    self.sys.at(b, k, -1.0)
                    self.sys.at(k, a, 1.0)
                    self.sys.at(k, b, -1.0)
                    self.sys.rhs(k, w.at(self.time))
                CurrentSource(w) ->
                    val amps = w.at(self.time)

                    self.sys.rhs(a, -amps)
                    self.sys.rhs(b, amps)
                Generator(w, ohms) ->
                    // The wave behind its resistance, as the current it would drive into a short
                    // circuit with the resistance across it.
                    val amps = w.at(self.time) / ohms

                    self.conductance(a, b, 1.0 / ohms)
                    self.sys.rhs(a, amps)
                    self.sys.rhs(b, -amps)
                Supply(s) ->
                    // The current it delivers on the line touching its curve at `v`: a conductance
                    // of the line's slope, and the current that line drives into a short circuit.
                    val v = self.junction[i * 2]
                    val (amps, slope) = supply_line(s, s.wave().at(self.time), v)
                    val drive = amps - slope * v

                    self.conductance(a, b, GMIN - slope)
                    self.sys.rhs(a, drive)
                    self.sys.rhs(b, -drive)
                Diode(m) ->
                    val inner = self.extra[i]
                    val anode = if inner >= 0 then inner else a

                    if inner >= 0 then self.conductance(a, inner, 1.0 / m.rs)

                    val v = self.junction[2 * i]
                    val g = diode_conductance(m, v) + GMIN
                    val owed = diode_current(m, v) + GMIN * v - g * v

                    self.conductance(anode, b, g)
                    self.sys.rhs(anode, -owed)
                    self.sys.rhs(b, owed)
                Transistor(m) ->
                    val vbe = self.junction[2 * i]
                    val vbc = self.junction[2 * i + 1]
                    val l = transistor_line(m, vbe, vbc)
                    val t = if m.pnp then -1.0 else 1.0
                    val e = p.c - 1

                    // The collector's current, the base's, and the emitter's, which is both back out.
                    self.flow(a, 1.0, t, p, l.ic, l.ic_be, l.ic_bc, vbe, vbc)
                    self.flow(b, 1.0, t, p, l.ib, l.ib_be, l.ib_bc, vbe, vbc)
                    self.flow(e, -1.0, t, p, l.ic, l.ic_be, l.ic_bc, vbe, vbc)
                    self.flow(e, -1.0, t, p, l.ib, l.ib_be, l.ib_bc, vbe, vbc)
                Mosfet(m, w, l) ->
                    // The drain's current, which leaves by the source; the gate carries none. On the
                    // line touching the curve at `vgs0` and `vds0`, the current into the drain is
                    // `t · (id − gm · vgs0 − gds · vds0) + gm · (v(gate) − v(source)) + gds · (v(drain) − v(source))`.
                    val vgs = self.junction[2 * i]
                    val vds = self.junction[2 * i + 1]
                    val line = mosfet_line(m, w, l, vgs, vds)
                    val t = if m.pmos then -1.0 else 1.0
                    val g = p.b - 1
                    val s = p.c - 1
                    val owed = t * (line.id - line.gm * vgs - line.gds * vds)

                    for (row, sign) in [(a, 1.0), (s, -1.0)]
                        self.sys.at(row, a, sign * line.gds)
                        self.sys.at(row, g, sign * line.gm)
                        self.sys.at(row, s, -sign * (line.gm + line.gds))
                        self.sys.rhs(row, -sign * owed)

    // Into the equation of unknown `row`, `s` times a current into transistor `p` of
    // `t · (i0 + gbe · (vbe − vbe0) + gbc · (vbc − vbc0))`, where `vbe = t · (v(base) − v(emitter))` and
    // `vbc = t · (v(base) − v(collector))`: one terminal's current on the line touching its curve at
    // `vbe0` and `vbc0`. `t` is 1 for an NPN transistor and -1 for a PNP one.
    private flow(*self, row: int, s: real, t: real, p: Part, i0: real, gbe: real, gbc: real, vbe0: real, vbc0: real)
        self.sys.at(row, p.b - 1, s * (gbe + gbc))
        self.sys.at(row, p.c - 1, -s * gbe)
        self.sys.at(row, p.a - 1, -s * gbc)
        self.sys.rhs(row, -s * t * (i0 - gbe * vbe0 - gbc * vbc0))

    // A conductance `g` between two unknowns' nodes.
    private conductance(*self, a: int, b: int, g: real)
        self.sys.at(a, a, g)
        self.sys.at(b, b, g)
        self.sys.at(a, b, -g)
        self.sys.at(b, a, -g)

    // Why the matrix could not be solved, as a person would put it.
    private singular(self) -> string
        "the circuit has a node no part fixes the voltage of, or a loop of voltage sources and inductors"
end Sim

// A simulator for `c`, not yet solved. It works on its own copy of the parts, so flipping a switch or
// changing a wave in it leaves `c` as it was.
sim(given: Circuit) -> Sim
    var own: Buf[Part] = buf()

    for i in 0..<given.parts.len()
        own.push(given.parts[i])

    val c = Circuit(given.nodes, own)
    var extra: Buf[int] = buf()
    var size = c.node_count() - 1

    for i in 0..<c.parts.len()
        c.parts[i].kind match
            VoltageSource(_) | Inductor(_) ->
                extra.push(size)
                size += 1
            Diode(m) ->
                if m.rs > 0.0
                    extra.push(size)
                    size += 1
                else
                    extra.push(-1)
            _ -> extra.push(-1)

    val parts = int(c.parts.len())

    Sim(c, extra, zeros(2 * parts), size, zeros(size), system(size), 0.0, 0.0, Steady, 0.0, FIRST_STEP, 1e300,
        zeros(parts), zeros(parts), zeros(size), zeros(size), 0.0, 0.0, 0, false, zeros(size), zeros(2 * parts), 0, 0, zeros(parts))

private zeros(n: int) -> Buf[real]
    var b: Buf[real] = buf()

    for _ in 0..<n
        b.push(0.0)

    b

// Copy `from` into `to`, which is as long.
private copy(from: *Buf[real], to: *Buf[real])
    for k in 0..<from.len()
        to[k] = from[k]

// The current through a junction at `v`: forward conduction, and for a zener its breakdown reversed,
// which is nothing at zero volts.
diode_current(m: DiodeModel, v: real) -> real
    val nvt = m.n * VT
    val forward = m.is * ((v / nvt).exp() - 1.0)

    if m.bv <= 0.0 then return forward

    val k = knee(m)

    forward - m.is * ((-(v + k) / nvt).exp() - (-k / nvt).exp())

// The slope of the junction's curve at `v`.
private diode_conductance(m: DiodeModel, v: real) -> real
    val nvt = m.n * VT
    val forward = m.is / nvt * (v / nvt).exp()

    if m.bv <= 0.0 then return forward

    forward + m.is / nvt * (-(v + knee(m)) / nvt).exp()

// Where a zener's breakdown exponential is centred: the reversed voltage at which it would carry the
// saturation current, found as SPICE finds it, so that at `bv` reversed it carries `ibv`. Where `ibv`
// is too small to reach, the knee is `bv` itself.
private[amber] knee(m: DiodeModel) -> real
    val nvt = m.n * VT

    if m.ibv < m.is * m.bv / VT then return m.bv

    var k = m.bv - nvt * (1.0 + m.ibv / m.is).ln()

    for _ in 0..<4
        k = m.bv - nvt * (m.ibv / m.is + 1.0 - k / VT).ln()

    k

// The current a supply delivers out of its `+` terminal with `v` across it, when it would put out
// `open` with nothing connected, and the slope of that current against `v`.
//
// **It is the smaller of what its voltage would drive through its resistance and its current limit,
// with the corner between them rounded** over a thousandth of the limit, so the curve and its slope are
// continuous. Delivered current against voltage is then falling and bent only one way, and Newton's
// method on such a curve cannot circle: from its second step on it closes on the answer from one side.
// A hard corner would leave the slope jumping between the two modes, and the solution could swap
// between them for ever without settling.
private[amber] supply_line(s: PowerSupply, open: real, v: real) -> (real, real)
    val r = s.resistance()
    val drive = (open - v) / r
    val round = SUPPLY_ROUNDING * s.amps
    val z = (s.amps - drive) / round

    // The smaller of `drive` and the limit, less `round · ln(1 + e^−|z|)`, and the slope through
    // the logistic function, each written so the exponential cannot overflow.
    if z >= 0.0
        val e = (-z).exp()

        return (drive - round * (1.0 + e).ln(), -1.0 / (r * (1.0 + e)))

    val e = z.exp()

    (s.amps - round * (1.0 + e).ln(), -e / (r * (1.0 + e)))

// How far round a supply's corner between holding its voltage and holding its current is, as a part of
// its current limit.
const SUPPLY_ROUNDING: real = 1e-3

// Whether a junction voltage moved so little between linearising and solving that it is settled.
private close(was: real, now: real) -> bool = (now - was).abs() <= 1e-6 * max(now.abs(), was.abs()) + 1e-9

// A transistor's collector and base currents on the lines touching their curves at one pair of
// junction voltages: the currents there, and their slopes against each junction's voltage. Both flow
// into the transistor as an NPN has them; a PNP's are the same with the signs reversed.
private struct TransistorLine
    ic: real
    ib: real
    ic_be: real
    ic_bc: real
    ib_be: real
    ib_bc: real

// The lines for model `m` at `vbe` and `vbc`, with GMIN across each junction as SPICE puts it, in the
// base current's share.
private transistor_line(m: TransistorModel, vbe: real, vbc: real) -> TransistorLine
    val vtf = m.nf * VT
    val vtr = m.nr * VT
    val ef = (vbe / vtf).exp()
    val er = (vbc / vtr).exp()
    // The forward and reverse transport currents and their slopes.
    val cf = m.is * (ef - 1.0)
    val gf = m.is * ef / vtf
    val cr = m.is * (er - 1.0)
    val gr = m.is * er / vtr
    // The base's width, widened by the Early effect, and its slopes.
    val inv_vaf = if m.early_f > 0.0 then 1.0 / m.early_f else 0.0
    val inv_var = if m.early_r > 0.0 then 1.0 / m.early_r else 0.0
    val qb = 1.0 / (1.0 - inv_vaf * vbc - inv_var * vbe)
    val dqb_be = qb * qb * inv_var
    val dqb_bc = qb * qb * inv_vaf
    val ct = cf - cr

    TransistorLine(
        ct / qb - cr / m.br - GMIN * vbc,
        cf / m.bf + cr / m.br + GMIN * (vbe + vbc),
        (gf - ct * dqb_be / qb) / qb,
        (-gr - ct * dqb_bc / qb) / qb - gr / m.br - GMIN,
        gf / m.bf + GMIN,
        gr / m.br + GMIN)

// A MOSFET's drain current on the line touching its curve at one gate–source and drain–source
// voltage: the current there, and its slopes against each voltage. All are as an n-channel MOSFET has
// them; a p-channel one's are the same with the voltages and the current reversed.
private struct MosfetLine
    id: real
    gm: real
    gds: real

// The threshold of model `m` on the voltages `mosfet_line` takes: SPICE writes a p-channel MOSFET's
// reversed, as its gate–source voltage is.
private threshold(m: MosfetModel) -> real = if m.pmos then -m.vto else m.vto

// The line for model `m` with a channel `w` by `l` at `vgs` and `vds`, with GMIN from drain to
// source, where SPICE puts it across the drain's junction with the bulk. With `vds` below zero the
// source is the higher terminal and the two change places: the current is the square law's at the
// gate–drain voltage and `−vds`, flowing the other way.
private mosfet_line(m: MosfetModel, w: real, l: real, vgs: real, vds: real) -> MosfetLine
    if vds >= 0.0
        val c = channel(m, w, l, vgs, vds)

        return MosfetLine(c.id + GMIN * vds, c.gm, c.gds + GMIN)

    val c = channel(m, w, l, vgs - vds, -vds)

    MosfetLine(-c.id + GMIN * vds, -c.gm, c.gm + c.gds + GMIN)

// The square law with the drain the higher terminal, `vds` not below zero: off below the threshold,
// a resistor shrinking toward pinch-off in the linear region, and a current the gate sets beyond it,
// each raised by `lambda · vds`.
private channel(m: MosfetModel, w: real, l: real, vgs: real, vds: real) -> MosfetLine
    val vgst = vgs - threshold(m)

    if vgst <= 0.0 then return MosfetLine(0.0, 0.0, 0.0)

    val beta = m.kp * w / l
    val widened = 1.0 + m.lambda * vds

    if vgst <= vds
        return MosfetLine(0.5 * beta * vgst * vgst * widened, beta * vgst * widened, 0.5 * m.lambda * beta * vgst * vgst)

    MosfetLine(
        beta * vds * (vgst - 0.5 * vds) * widened,
        beta * vds * widened,
        beta * (vgst - vds) * widened + m.lambda * beta * vds * (vgst - 0.5 * vds))

// SPICE's limit on a step of a MOSFET's gate–source voltage from `was` toward `want`, against its
// threshold `vto`: a device that is off may come on only to just above the threshold, one that is
// barely on may move only a few volts, one well on may rise by steps that grow with how far on it is
// and may turn off only as far as 2 V above the threshold, and one off may fall by steps that grow
// with how far off it is.
//
// SPICE also limits a step down that stays well on, and a step up that stays off, to |was − vto| + 1;
// neither can be that long, so neither is written here.
private[amber] fetlim(want: real, was: real, vto: real) -> real
    val hi = (2.0 * (was - vto)).abs() + 2.0
    val on = vto + 3.5
    val step = want - was

    if was >= on
        if step > 0.0 then return if step >= hi then was + hi else want

        return if want >= on then want else max(want, vto + 2.0)

    if was >= vto then return if step <= 0.0 then max(want, vto - 0.5) else min(want, vto + 4.0)

    if step <= 0.0 then return if -step > hi then was - hi else want

    min(want, vto + 0.5)

// SPICE's limit on a step of a MOSFET's drain–source voltage: no more than about tripling it at a time
// above 3.5 V, and within −0.5 V and 4 V below.
private[amber] limvds(want: real, was: real) -> real
    if was >= 3.5
        if want > was then return min(want, 3.0 * was + 2.0)
        if want < 3.5 then return max(want, 2.0)

        return want

    if want > was then min(want, 4.0) else max(want, -0.5)

// The voltage above which a junction of saturation current `is`, on thermal voltage `nvt`, has its
// steps limited: where its curve bends hardest.
private critical(nvt: real, is: real) -> real = nvt * (nvt / (1.4142135623730951 * is)).ln()

// SPICE's junction limiting: a step above the knee is taken logarithmically, since the current it
// would mean grows exponentially.
private limit(want: real, was: real, nvt: real, critical: real) -> real
    if want > critical && (want - was).abs() > 2.0 * nvt
        if was > 0.0
            val arg = 1.0 + (want - was) / nvt

            return if arg > 0.0 then was + nvt * arg.ln() else critical

        return nvt * (want / nvt).ln()

    want
