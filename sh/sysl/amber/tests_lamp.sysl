module sh.sysl.amber
@tests

import sysl.text.replace_all

private near(got: real, want: real, tol: real) -> bool = (got - want).abs() <= tol * want.abs().max(1.0)

// A 12 V battery lighting a 12 V 5 W lamp, read through an ammeter.
val TORCH = """
    battery  B1  0 0  0 6  12V
    ammeter  A1  0 0  4 0
    lamp     L1  4 0  4 6  12V 5W
    wire         4 6  0 6
    ground       0 6
    """

// Its rated current, 5 W at 12 V.
const RATED_AMPS: real = 5.0 / 12.0

private part(sch: Schematic, name: string) -> int = sch.elements[sch.find(name).unwrap()].part

// ## In a schematic

@test
private a_lamp_line_gives_its_rating_in_volts_and_watts()
    val sch = parse_schematic(TORCH).unwrap()
    val l = sch.elements[sch.find("L1").unwrap()]

    assert_eq(l.shape, Shape.Lamp)
    assert_eq(l.value, "12V 5W")
    assert_eq(sch.circuit.parts[usize(l.part)].kind, Lamp(12.0, 5.0))
    assert(l.a != l.b)

@test
private a_lamp_line_says_what_is_wrong_with_it()
    val rating = "a lamp needs its rating, volts then watts: 12V 5W"

    assert_eq(parse_schematic("lamp L1  0 0  0 4\n").err(), Some(s"line 1: ${rating}"))
    assert_eq(parse_schematic("lamp L1  0 0  0 4  12V\n").err(), Some(s"line 1: ${rating}"), "the watts are needed too")
    assert_eq(parse_schematic("lamp L1  0 0  0 4  bright 5W\n").err(), Some("line 1: 'bright' is not a number"))
    assert_eq(parse_schematic("lamp L1  0 0  0 4  12V dim\n").err(), Some("line 1: 'dim' is not a number"))
    assert_eq(parse_schematic("lamp L1  0 0  0 4  0V 5W\n").err(), Some("line 1: a lamp's voltage is more than zero"))
    assert_eq(parse_schematic("lamp L1  0 0  0 4  12V -5W\n").err(), Some("line 1: a lamp's power is more than zero"))
    assert_eq(parse_schematic("lamp L1  0 0  0 4  12V 5W 3\n").err(), Some("line 1: '3' is more than a lamp takes"))
    assert_eq(parse_schematic("lamp L1  0 0  0 0  12V 5W\n").err(), Some("line 1: a lamp needs two different points"))
    assert_eq(parse_schematic("lamp L1  0 0  0\n").err(), Some("line 1: a lamp is placed by 2 points"))
    assert_eq(parse_schematic("lamp\n").err(), Some("line 1: a lamp needs a name"))

@test
private a_document_adds_a_lamp_line()
    var doc = document("battery  B1  0 0  0 6  12V\n")

    assert_eq(doc.add("lamp", "L1", [(4, 0), (4, 6)], "12V 5W"), 2)
    assert_eq(doc.text(), "battery  B1  0 0  0 6  12V\nlamp      L1    4 0   4 6   12V 5W\n")
    assert_eq(doc.schematic().unwrap().circuit.parts[1].kind, Lamp(12.0, 5.0))

// ## Its filament

@test
private hot_it_is_its_rated_resistance_and_cold_a_tenth_of_it()
    assert(near(lamp_hot_ohms(12.0, 5.0), 28.8, 1e-12), "V²/P")
    assert(near(lamp_ohms(12.0, 5.0, LAMP_RISE), 28.8, 1e-12))
    assert(near(lamp_ohms(12.0, 5.0, 0.0), 2.88, 1e-12), "a tenth of it at the room's temperature")
    assert(lamp_ohms(12.0, 5.0, 1000.0) > lamp_ohms(12.0, 5.0, 500.0), "rising with its temperature")

@test
private hot_it_radiates_its_rated_power_and_cold_nothing()
    assert(near(lamp_loss(5.0, LAMP_RISE).0, 5.0, 1e-12))
    assert_eq(lamp_loss(5.0, 0.0).0, 0.0)
    // Half as hot above absolute zero radiates a sixteenth as much, less the room's share.
    assert(lamp_loss(5.0, 850.0).0 < 5.0 / 16.0)
    assert(near(lamp_loss(60.0, LAMP_RISE).0, 60.0, 1e-12), "whatever its rating")

@test
private its_heat_capacity_cools_it_with_its_time_constant()
    val (_, cooling) = lamp_loss(5.0, LAMP_RISE)

    assert(near(lamp_heat_capacity(5.0) / cooling, LAMP_SECONDS, 1e-12))
    assert(near(lamp_heat_capacity(10.0), 2.0 * lamp_heat_capacity(5.0), 1e-12), "a lamp twice the power has twice the filament")

// ## Steady

@test
private at_its_rated_voltage_it_draws_its_rated_power()
    val sch = parse_schematic(TORCH).unwrap()
    var s = sim(sch.circuit)
    val l = part(sch, "L1")

    s.operating_point().unwrap()
    assert(near(s.power(l), 5.0, 1e-2), s"5 W, not ${s.power(l)}")
    assert(near(s.current(l), RATED_AMPS, 1e-2), s"${s.current(l)}")
    assert(near(s.current(part(sch, "A1")), s.current(l), 1e-9), "what the ammeter reads")
    assert(near(s.filament(l), LAMP_RISE, 1e-3), s"its filament at its rated heat, not ${s.filament(l)}")
    assert_eq(s.filament(part(sch, "B1")), 0.0, "a battery has no filament")

@test
private at_half_its_voltage_it_draws_more_than_half_its_current()
    val sch = parse_schematic(replace_all(TORCH, "12V\n", "6V\n")).unwrap()
    var s = sim(sch.circuit)
    val l = part(sch, "L1")

    s.operating_point().unwrap()

    val share = s.current(l) / RATED_AMPS

    // Cooler, its resistance is lower: about two thirds of its current at half its voltage, where a
    // resistor would draw half.
    assert(share > 0.6 && share < 0.75, s"${share} of its rated current")
    assert(s.filament(l) < LAMP_RISE && s.filament(l) > 0.5 * LAMP_RISE, s"${s.filament(l)}")
    assert(s.power(l) < 5.0 / 2.0, "but well under half its power")

@test
private behind_a_resistor_it_settles_where_its_filament_radiates_what_it_takes()
    val sch = parse_schematic(replace_all(TORCH, "wire         4 6  0 6", "resistor R1  4 6  0 6  20")).unwrap()
    var s = sim(sch.circuit)
    val l = part(sch, "L1")

    s.operating_point().unwrap()

    val r = s.across(l) / s.current(l)

    assert(near(lamp_loss(5.0, s.filament(l)).0, s.power(l), 1e-6), s"radiating ${lamp_loss(5.0, s.filament(l)).0} W of ${s.power(l)}")
    assert(near(r, lamp_ohms(12.0, 5.0, s.filament(l)), 1e-6), s"${r} Ω")
    assert(near(s.current(l), 12.0 / (20.0 + r), 1e-6), "what the resistor lets through")
    assert(r < 28.8 && r > 2.88, s"between cold and hot: ${r} Ω")

@test
private turned_round_it_draws_the_same_current_reversed()
    val sch = parse_schematic(replace_all(TORCH, "lamp     L1  4 0  4 6", "lamp     L1  4 6  4 0")).unwrap()
    var s = sim(sch.circuit)

    s.operating_point().unwrap()
    assert(near(s.current(part(sch, "L1")), -RATED_AMPS, 1e-2), s"${s.current(part(sch, "L1"))}")
    assert(near(s.power(part(sch, "L1")), 5.0, 1e-2))

@test
private with_nothing_across_it_its_filament_is_cold()
    val sch = parse_schematic(replace_all(TORCH, "battery  B1  0 0  0 6  12V", "switch   S1  0 0  0 6  open")).unwrap()
    var s = sim(sch.circuit)

    s.operating_point().unwrap()
    assert(s.filament(part(sch, "L1")).abs() < 1e-6, s"${s.filament(part(sch, "L1"))}")

// ## Switched on

@test
private switched_on_cold_it_draws_ten_times_its_steady_current_at_first()
    val sch = parse_schematic(TORCH).unwrap()
    var s = sim(sch.circuit)
    val a = part(sch, "A1")

    s.power_on().unwrap()
    assert(near(s.current(a), 10.0 * RATED_AMPS, 1e-3), s"12 V across its cold 2.88 Ω, not ${s.current(a)}")
    assert(s.filament(part(sch, "L1")).abs() < 1e-3)

@test
private its_inrush_falls_away_over_tens_of_milliseconds()
    val sch = parse_schematic(TORCH).unwrap()
    var s = sim(sch.circuit)
    val a = part(sch, "A1")
    val l = part(sch, "L1")

    s.power_on().unwrap()

    var was = s.current(a)
    var twice = -1.0
    var settled = -1.0
    var t = 0.0

    while t < 0.3
        t += 1e-3
        s.advance_to(t).unwrap()

        val now = s.current(a)

        assert(now <= was * (1.0 + 1e-6), s"falling all the way: ${now} after ${was} at ${t}")
        assert(near(s.current(l), now, 1e-6), "the lamp's own current is the ammeter's")

        if t > 0.0015 && t < 0.0025 then assert(now > 3.0 * RATED_AMPS, s"more than three times its steady current 2 ms in: ${now}")

        if twice < 0.0 && now < 2.0 * RATED_AMPS then twice = t

        if settled < 0.0 && near(now, RATED_AMPS, 1e-2) then settled = t

        was = now

    // Its filament takes some milliseconds to heat: it draws more than twice its steady current for the
    // first several, and is within a percent of it in less than a tenth of a second.
    assert(twice > 5e-3 && twice < 30e-3, s"twice its steady current at ${twice} s")
    assert(settled > 30e-3 && settled < 100e-3, s"within a percent of its steady current at ${settled} s")
    assert(near(s.current(a), RATED_AMPS, 1e-3), s"settled near its rated current, not ${s.current(a)}")
    assert(near(s.power(l), 5.0, 1e-2), s"${s.power(l)}")

@test
private switched_off_it_cools_with_its_time_constant()
    val sch = parse_schematic(replace_all(TORCH, "wire         4 6  0 6", "switch   S1  4 6  0 6  closed")).unwrap()
    var s = sim(sch.circuit)
    val l = part(sch, "L1")

    s.operating_point().unwrap()
    assert(near(s.filament(l), LAMP_RISE, 1e-3), s"lit before it is switched off, not ${s.filament(l)}")

    s.set_switch(part(sch, "S1"), false)
    s.advance_to(2e-3).unwrap()

    // Over the first tenth of a time constant it cools as e^(−t/τ) from full heat.
    val cooled = 1.0 - s.filament(l) / LAMP_RISE

    assert(near(cooled, 1.0 - (-0.1).exp(), 0.1), s"${cooled} of its heat lost in 2 ms")

    s.advance_to(0.5).unwrap()
    assert(s.filament(l) < 0.5 * LAMP_RISE, s"a dull red by half a second: ${s.filament(l)}")

@test
private started_settled_it_is_lit_at_once()
    val sch = parse_schematic(s"start settled\n${TORCH}").unwrap()
    var s = sim(sch.circuit)
    val a = part(sch, "A1")

    assert(sch.settled)
    s.operating_point().unwrap()
    assert(near(s.current(a), RATED_AMPS, 1e-2), s"${s.current(a)}")

    s.advance_to(0.05).unwrap()
    assert(near(s.current(a), RATED_AMPS, 1e-2), s"no inrush once lit: ${s.current(a)}")
    assert(near(s.filament(part(sch, "L1")), LAMP_RISE, 1e-3))

@test
private it_follows_a_sine_at_its_resistance_hot()
    val sch = parse_schematic(TORCH).unwrap()
    var s = sim(sch.circuit)
    val r = s.response(1e3, [drive(part(sch, "B1"), 1.0, 0.0)][..]).unwrap()

    // A volt across its hot 28.8 Ω: its filament cannot follow a kilohertz.
    assert(near(r.current(part(sch, "A1")).abs(), 1.0 / 28.8, 1e-2), s"${r.current(part(sch, "A1")).abs()}")

@test
private on_mains_it_flickers_by_a_few_percent()
    val sch = parse_schematic(replace_all(TORCH, "battery  B1  0 0  0 6  12V", "source   B1  0 0  0 6  sine 16.97 50")).unwrap()
    var s = sim(sch.circuit)
    val l = part(sch, "L1")

    s.operating_point().unwrap()
    s.advance_to(0.3).unwrap()

    var low = 1e9
    var high = 0.0
    var t = 0.3

    while t < 0.34
        t += 2.5e-4
        s.advance_to(t).unwrap()
        low = low.min(s.filament(l))
        high = high.max(s.filament(l))

    // 12 V r.m.s. lights it at about its rated heat, and its filament swings by a few percent as the
    // mains rises and falls a hundred times a second.
    assert(near(0.5 * (low + high), LAMP_RISE, 2e-2), s"${low} to ${high}")
    assert(high - low > 0.01 * LAMP_RISE && high - low < 0.2 * LAMP_RISE, s"${low} to ${high}")
