module sh.sysl.amber

import sysl.buf.{Buf, buf}
import sysl.text.{Search, fields, split, to_lower}

// A SPICE netlist: the format every circuit simulator reads, and the one published circuits come in.
//
//     RC charge
//     V1 in 0 PULSE(0 5 0 1n 1n 10m 20m)
//     R1 in out 1k
//     C1 out 0 1u
//     .tran 0.5m 5m
//     .end
//
// **The first line is a title**, whatever it says. Then one element or command a line; a line starting
// with `+` continues the one before, `*` starts a comment line, and `;` or `$` starts a comment
// partway along one. Case does not matter: everything is read in lower case, names included.
//
// The subset read here:
//
// | line | what it is |
// |---|---|
// | `R<name> n1 n2 value` | resistor |
// | `C<name> n1 n2 value [IC=v]` | capacitor, holding `v` volts when switched on with `uic` |
// | `L<name> n1 n2 value [IC=i]` | inductor, carrying `i` amps likewise |
// | `K<name> L<first> L<second> k` | two inductors wound together, coupled by `k` (0 < k ≤ 1): a transformer |
// | `V<name> n+ n- [DC] value` or a wave | voltage source |
// | `I<name> n+ n- [DC] value` or a wave | current source, flowing from n+ through it to n- |
// | `D<name> anode cathode model [area]` | diode |
// | `Q<name> collector base emitter [substrate] model [area]` | bipolar transistor |
// | `M<name> drain gate source bulk model [L=l] [W=w] [M=m]` | MOSFET, its bulk taken as its source |
// | `.model <name> D (IS= N= RS= …)` | a diode's parameters |
// | `.model <name> NPN (IS= BF= BR= NF= NR= VAF= VAR= …)`, or `PNP` | a transistor's parameters |
// | `.model <name> NMOS (LEVEL=1 VTO= KP= LAMBDA= …)`, or `PMOS` | a MOSFET's parameters |
// | `.op` | the operating point |
// | `.tran tstep tstop [tstart [tmax]] [UIC]` | a run through time, printed every `tstep` |
// | `.dc source start stop step` | the operating point at each value of a source |
// | `.ac dec\|oct\|lin points fstart fstop` | the response to a small sine at each frequency |
// | `.end` | the end; anything after it is not read |
//
// Waves are SPICE's `PULSE(v1 v2 td tr tf pw per)`, `SIN(vo va freq td theta phase)` and
// `PWL(t1 v1 t2 v2 …)`, with SPICE's defaults for the parameters left off. A source's `AC magnitude
// [phase]`, the phase in degrees, is the sine `.ac` drives it with; a `.control` block is ngspice's own
// scripting and is skipped whole.
//
// **What is read but not modelled is said, not dropped.** A diode model's junction capacitance, a
// transistor model's base resistance, a MOSFET's body effect or a bulk not on its source, a `.options`
// line, a `.print`: each leaves a note on the netlist, and a program running it shows the notes, so a
// reader knows where amber's answer may part from another simulator's. What would change the circuit
// itself and cannot be read — a subcircuit, a junction field-effect transistor, a MOSFET model above
// level 1, a `.param` — is refused.

// One analysis a netlist asks for.
enum Analysis derives Eq
    Op
    // Every `step` seconds from `start` to `stop`; steps no longer than `longest`; from empty when
    // `from_empty`, SPICE's `UIC`, and from the operating point otherwise.
    Tran(step: real, stop: real, start: real, longest: real, from_empty: bool)
    // Source `source` set to each value from `from` to `to` by `step`.
    Sweep(source: string, from: real, to: real, step: real)
    // The response to the sources' `AC` parts at frequencies from `from` to `to` hertz: `points` a
    // decade or an octave apart, or `points` in all evenly spaced.
    Ac(spacing: Spacing, points: int, from: real, to: real)

// How `.ac` spaces its frequencies.
enum Spacing
    Decade
    Octave
    Linear

// The frequencies `.ac` visits: each `points` a decade or an octave from `from`, while not past `to`,
// or `points` of them from `from` to `to` evenly.
frequencies(spacing: Spacing, points: int, from: real, to: real) -> Buf[real]
    var out: Buf[real] = buf()

    if spacing == Linear
        for k in 0..<points
            out.push(if points == 1 then from else from + (to - from) * real(k) / real(points - 1))

        return out

    val base = if spacing == Decade then 10.0 else 2.0
    var k = 0

    loop
        val f = from * base.pow(real(k) / real(points))

        if f > to * (1.0 + 1e-9) then break

        out.push(f)
        k += 1

    out

struct Netlist
    title: string
    circuit: Circuit
    analyses: Buf[Analysis]
    // What each capacitor and inductor holds when switched on, by part; 0 for the rest.
    initial: Buf[real]
    // The sources with an `AC` part, which `.ac` drives.
    drives: Buf[Drive]
    // What was read and not modelled, one sentence each.
    notes: Buf[string]

// What a `.model` line describes.
private enum CardModel
    DiodeCard(diode: DiodeModel)
    TransistorCard(transistor: TransistorModel)
    MosfetCard(mosfet: MosfetModel)

// A model as the netlist gives it.
private struct ModelCard
    name: string
    model: CardModel

// An element line read: the part, the nodes its terminals are on (the third only for a transistor or
// a MOSFET),
// and what it holds when switched on.
private struct Element
    kind: Kind
    a: string
    b: string
    c: Option[string]
    ic: real

// Read a netlist. An error names the line it is about.
parse_netlist(text: string) -> Result[Netlist, string]
    if text.trim() == "" then return Err("a netlist starts with a title line")

    val lines = logical_lines(text)?

    var notes: Buf[string] = buf()
    var models: Buf[ModelCard] = buf()
    var analyses: Buf[Analysis] = buf()
    // `.tran`'s step and stop, which a wave's missing parameters default to.
    var tstep = 0.0
    var tstop = 0.0

    // Models and analyses first, since an element may name a model defined after it and a wave's
    // defaults come from `.tran`.
    for k in 1..<lines.len()
        val (line_no, words) = lines[k]

        if words[0].starts_with(".")
            val at = s"line ${line_no}"

            words[0] match
                ".model" -> models.push(model_card(words, &notes).map_err(why -> s"${at}: ${why}")?)
                ".op" -> analyses.push(Op)
                ".tran" ->
                    val a = tran_card(words).map_err(why -> s"${at}: ${why}")?

                    if a is Tran(step, stop, _, _, _)
                        tstep = step
                        tstop = stop

                    analyses.push(a)
                ".dc" -> analyses.push(dc_card(words).map_err(why -> s"${at}: ${why}")?)
                ".ac" -> analyses.push(ac_card(words).map_err(why -> s"${at}: ${why}")?)
                ".options" | ".option" | ".print" | ".plot" | ".probe" | ".save" | ".width" | ".temp" ->
                    notes.push(s"${at}: ${words[0]} is not acted on")
                ".ic" | ".nodeset" -> notes.push(s"${at}: ${words[0]} is not read; give capacitors and inductors IC= instead")
                ".end" -> ()
                _ -> return Err(s"${at}: ${words[0]} is not read by amber")

    var c = circuit()
    var initial: Buf[real] = buf()
    var drives: Buf[Drive] = buf()

    // Couplings name inductors that may come after them, so they are read once every part is in.
    var couplings: Buf[(int, Buf[string])] = buf()

    for k in 1..<lines.len()
        val (line_no, words) = lines[k]

        if words[0].starts_with(".") then continue

        if words[0].bytes[0] == u8('k')
            couplings.push((line_no, words))
            continue

        val e = element_card(words, &models, tstep, tstop, &notes).map_err(why -> s"line ${line_no}: ${why}")?

        if c.find_part(words[0]).is_some() then return Err(s"line ${line_no}: '${words[0]}' is already the name of another element")

        e.c match
            Some(third) -> c.connect3(words[0], e.kind, e.a, e.b, third)
            None -> c.connect(words[0], e.kind, e.a, e.b)

        initial.push(e.ic)

        if e.kind.wave().is_some()
            if source_ac(words.view()[3..<words.len()]) is Some((mag, phase))
                drives.push(drive(int(c.parts.len()) - 1, mag, phase))

    for k in 0..<couplings.len()
        val (line_no, words) = couplings[k]

        coupling_card(&c, words).map_err(why -> s"line ${line_no}: ${why}")?

    for k in 0..<analyses.len()
        if analyses[k] is Sweep(source, _, _, _)
            val found = c.find_part(source) match
                Some(i) -> c.parts[usize(i)].kind.wave().is_some()
                None -> false

            if !found then return Err(s".dc sweeps '${source}', which is not a source in the netlist")

    Ok(Netlist(split(text, "\n")[0].trim(), c, analyses, initial, drives, notes))

// The netlist's lines with comments taken out and continuations joined, each with the number of the
// line it began on, split into words. The title keeps its case; everything else is lower case, with
// brackets, commas and `=` as separators (an `=` kept as a word of its own).
private logical_lines(text: string) -> Result[Buf[(int, Buf[string])], string]
    var out: Buf[(int, Buf[string])] = buf()
    var line_no = 0
    var skipping = false
    var ended = false

    for raw in split(text, "\n")
        line_no += 1

        if ended then continue

        if line_no == 1
            out.push((1, words_of(raw.trim())))
            continue

        val cut = strip_comment(raw)
        val line = to_lower(cut.trim())

        if line == "" || line.starts_with("*") then continue

        if skipping
            if line.starts_with(".endc") then skipping = false

            continue

        if line.starts_with(".control")
            skipping = true
            continue

        if line.starts_with("+")
            if out.len() <= 1 then return Err(s"line ${line_no}: a '+' line continues nothing")

            val more = words_of(line[1..<line.len])

            for k in 0..<more.len()
                out[out.len() - 1].1.push(more[k])

            continue

        val words = words_of(line)

        if words.len() == 0 then continue

        if words[0] == ".end" then ended = true

        out.push((line_no, words))

    Ok(out)

// The line before a `;`, or a `$` that starts a word.
private strip_comment(line: string) -> string
    val b = line.bytes

    for i in 0..<b.len
        if b[i] == u8(';') then return line[0..<i]

        if b[i] == u8('$') && (i == 0 || b[i - 1] == u8(' ') || b[i - 1] == u8('\t')) then return line[0..<i]

    line

private words_of(line: string) -> Buf[string]
    var spaced = ""
    val b = line.bytes
    var start: usize = 0

    for i in 0..<b.len
        val c = b[i]

        if c == u8('(') || c == u8(')') || c == u8(',') || c == u8('=')
            spaced = spaced + line[start..<i] + (if c == u8('=') then " = " else " ")
            start = i + 1

    spaced = spaced + line[start..<line.len]

    val parts = fields(spaced)
    var out: Buf[string] = buf()

    for k in 0..<parts.len
        out.push(parts[k])

    out

// `.model name d (is=… n=… rs=…)`, `npn` or `pnp` for a transistor, or `nmos` or `pmos` for a
// MOSFET, with SPICE's defaults for the parameters left off.
private model_card(words: Buf[string], notes: *Buf[string]) -> Result[ModelCard, string]
    if words.len() < 3 then return Err(".model needs a name and a type")

    val name = words[1]
    val diode = words[2] == "d"
    val mos = words[2] == "nmos" || words[2] == "pmos"

    if !diode && !mos && words[2] != "npn" && words[2] != "pnp"
        return Err(s"model type '${words[2]}' is not supported yet; amber has diodes, bipolar transistors and MOSFETs")

    var d = DiodeModel(1e-14, 1.0, 0.0, 0.0, 1e-3)
    var t = TransistorModel(words[2] == "pnp", 1e-16, 100.0, 1.0, 1.0, 1.0, 0.0, 0.0)
    var f = MosfetModel(words[2] == "pmos", 0.0, 2e-5, 0.0)
    var k: usize = 3

    while k < words.len()
        if k + 2 >= words.len() || words[k + 1] != "=" then return Err(s"'${words[k]}' in model '${name}' needs '= value'")

        val v = parse_value(words[k + 2])?

        // Level 1 is the square law; the others are other equations, which would be a different circuit.
        if mos && words[k] == "level" && v != 1.0 then return Err(s"model '${name}' is level ${words[k + 2]}; amber has level 1")

        val known = if diode then diode_param(&d, words[k], v) else if mos then mosfet_param(&f, words[k], v) else transistor_param(&t, words[k], v)

        if !known then notes.push(s"model ${name}: ${words[k]} is not modelled")

        k += 3

    if diode
        if d.is <= 0.0 || d.n <= 0.0 || d.rs < 0.0 then return Err(s"model '${name}' needs IS and N above zero and RS not below")

        if d.bv < 0.0 || d.ibv <= 0.0 then return Err(s"model '${name}' needs BV not below zero and IBV above it")

        return Ok(ModelCard(name, DiodeCard(d)))

    if mos
        if f.kp <= 0.0 || f.lambda < 0.0 then return Err(s"model '${name}' needs KP above zero and LAMBDA not below")

        return Ok(ModelCard(name, MosfetCard(f)))

    if t.is <= 0.0 || t.bf <= 0.0 || t.br <= 0.0 || t.nf <= 0.0 || t.nr <= 0.0
        return Err(s"model '${name}' needs IS, BF, BR, NF and NR above zero")

    if t.early_f < 0.0 || t.early_r < 0.0 then return Err(s"model '${name}' needs VAF and VAR not below zero")

    Ok(ModelCard(name, TransistorCard(t)))

// Set the diode parameter `key` to `v`; false for one amber does not model.
private diode_param(m: *DiodeModel, key: string, v: real) -> bool
    key match
        "is" -> m.is = v
        "n" -> m.n = v
        "rs" -> m.rs = v
        "bv" -> m.bv = v
        "ibv" -> m.ibv = v
        _ -> return false

    true

// Set the transistor parameter `key` to `v`; false for one amber does not model. `va` and `vb` are
// SPICE's other names for VAF and VAR.
private transistor_param(m: *TransistorModel, key: string, v: real) -> bool
    key match
        "is" -> m.is = v
        "bf" -> m.bf = v
        "br" -> m.br = v
        "nf" -> m.nf = v
        "nr" -> m.nr = v
        "vaf" | "va" -> m.early_f = v
        "var" | "vb" -> m.early_r = v
        _ -> return false

    true

// Set the MOSFET parameter `key` to `v`; false for one amber does not model. `vt0` is SPICE's other
// name for VTO, and `level` is read by the card, which refuses any but 1.
private mosfet_param(m: *MosfetModel, key: string, v: real) -> bool
    key match
        "level" -> ()
        "vto" | "vt0" -> m.vto = v
        "kp" -> m.kp = v
        "lambda" -> m.lambda = v
        _ -> return false

    true

// `.tran tstep tstop [tstart [tmax]] [uic]`.
private tran_card(words: Buf[string]) -> Result[Analysis, string]
    var n = words.len()
    var from_empty = false

    if words[n - 1] == "uic"
        from_empty = true
        n -= 1

    if n < 3 || n > 5 then return Err(".tran takes a step, a stop, and perhaps a start and a longest step")

    val step = parse_value(words[1])?
    val stop = parse_value(words[2])?
    val start = if n > 3 then parse_value(words[3])? else 0.0
    // ngspice's default longest step: the print step, or a fiftieth of the run, whichever is shorter.
    val longest = if n > 4 then parse_value(words[4])? else min_of(step, (stop - start) / 50.0)

    if step <= 0.0 || stop <= start || start < 0.0 || longest <= 0.0 then return Err(".tran needs a step above zero and a stop after its start")

    Ok(Tran(step, stop, start, longest, from_empty))

// `.ac dec|oct|lin points fstart fstop`.
private ac_card(words: Buf[string]) -> Result[Analysis, string]
    if words.len() != 5 then return Err(".ac takes dec, oct or lin, a number of points, a start and a stop")

    val spacing = words[1] match
        "dec" -> Decade
        "oct" -> Octave
        "lin" -> Linear
        _ -> return Err(s".ac spaces its frequencies by dec, oct or lin, not '${words[1]}'")

    val points = parse_value(words[2])?
    val from = parse_value(words[3])?
    val to = parse_value(words[4])?

    if points < 1.0 || points != points.floor() then return Err(".ac's number of points is a whole number above zero")

    if from <= 0.0 || to < from then return Err(".ac's frequencies start above zero and stop at or after their start")

    Ok(Ac(spacing, int(points), from, to))

// `.dc source start stop step`.
private dc_card(words: Buf[string]) -> Result[Analysis, string]
    if words.len() != 5 then return Err(".dc takes one source, a start, a stop and a step")

    val from = parse_value(words[2])?
    val to = parse_value(words[3])?
    val step = parse_value(words[4])?

    if step == 0.0 || (to - from) / step < 0.0 then return Err(".dc's step must lead from its start to its stop")

    Ok(Sweep(words[1], from, to, step))

private min_of(a: real, b: real) -> real = if a < b then a else b

// An element line: the part, its nodes, and what it holds when switched on.
private element_card(words: Buf[string], models: *Buf[ModelCard], tstep: real, tstop: real,
                     notes: *Buf[string]) -> Result[Element, string]
    val name = words[0]

    if name.bytes[0] == u8('q') then return transistor_card(words, models)

    if name.bytes[0] == u8('m') then return mosfet_card(words, models, notes)

    if words.len() < 4 then return Err(s"'${name}' needs two nodes and a value")

    val a = words[1]
    val b = words[2]
    val rest = words.view()[3..<words.len()]

    name.bytes[0] match
        'r' ->
            if rest.len != 1 then return Err(s"'${name}' takes one value")

            Ok(Element(Resistor(positive(rest[0], "a resistance")?), a, b, None, 0.0))
        'c' ->
            val (v, ic) = value_and_ic(name, rest)?

            if v <= 0.0 then return Err("a capacitance is more than zero")

            Ok(Element(Capacitor(v), a, b, None, ic))
        'l' ->
            val (v, ic) = value_and_ic(name, rest)?

            if v <= 0.0 then return Err("an inductance is more than zero")

            Ok(Element(Inductor(v), a, b, None, ic))
        'v' -> Ok(Element(VoltageSource(source_wave(name, rest, tstep, tstop)?), a, b, None, 0.0))
        'i' -> Ok(Element(CurrentSource(source_wave(name, rest, tstep, tstop)?), a, b, None, 0.0))
        'd' ->
            if rest.len < 1 || rest.len > 2 then return Err(s"'${name}' takes a model and perhaps an area")

            val m = find_model(name, rest[0], models)? match
                DiodeCard(m) -> m
                other -> return Err(s"'${name}' is a diode, and model '${rest[0]}' is ${owner(other)}")
            val area = if rest.len == 2 then positive(rest[1], "an area")? else 1.0

            // An area scales the junction: more saturation current and breakdown current, less series
            // resistance.
            Ok(Element(Diode(DiodeModel(m.is * area, m.n, m.rs / area, m.bv, m.ibv * area)), a, b, None, 0.0))
        'j' -> Err(s"'${name}' is a junction field-effect transistor, which amber does not have yet")
        'x' -> Err(s"'${name}' is a subcircuit, which amber does not read")
        _ -> Err(s"'${name}' is not an element amber reads")

// `K<name> L<first> L<second> k`: two inductors wound together, coupled by `k`.
private coupling_card(c: *Circuit, words: Buf[string]) -> Result[unit, string]
    val name = words[0]

    if words.len() != 4 then return Err(s"'${name}' takes two inductors and a coupling")

    if c.find_part(name).is_some() then return Err(s"'${name}' is already the name of another element")

    for other in c.couplings
        if other.name == name then return Err(s"'${name}' is already the name of another element")

    val first = c.find_part(words[1]).ok_or(s"'${name}' couples '${words[1]}', which is not in the netlist")?
    val second = c.find_part(words[2]).ok_or(s"'${name}' couples '${words[2]}', which is not in the netlist")?

    c.couple(name, first, second, parse_value(words[3])?)

// `Q<name> collector base emitter [substrate] model [area]`. The substrate is read and left
// unconnected: its junction has no capacitance and no current in the model amber has, as in SPICE's
// with the substrate parameters left at their defaults.
private transistor_card(words: Buf[string], models: *Buf[ModelCard]) -> Result[Element, string]
    val name = words[0]

    if words.len() < 5 then return Err(s"'${name}' needs a collector, a base and an emitter node, and a model")

    // The word after the emitter is the model if a .model has that name, and the substrate otherwise.
    var at: usize = 4

    if !models_have(models, words[4]) && words.len() > 5 then at = 5

    val rest = words.view()[at..<words.len()]

    if rest.len > 2 then return Err(s"'${name}' takes its nodes, a model, and perhaps an area")

    val m = find_model(name, rest[0], models)? match
        TransistorCard(m) -> m
        other -> return Err(s"'${name}' is a transistor, and model '${rest[0]}' is ${owner(other)}")
    val area = if rest.len == 2 then positive(rest[1], "an area")? else 1.0

    // An area is that many transistors side by side: each junction's saturation current is scaled.
    var scaled = m

    scaled.is = m.is * area
    Ok(Element(Transistor(scaled), words[1], words[2], Some(words[3]), 0.0))

// `M<name> drain gate source bulk model [l=…] [w=…] [m=…]`, with SPICE's 100 µm for a length or width
// left off. `m` is that many MOSFETs side by side, which is a channel that many times as wide. The bulk
// is read and taken to be on the source, which is what level 1 needs no body effect for; a bulk
// elsewhere leaves a note. The other instance parameters, the junctions' areas and perimeters and
// `off`, leave a note each.
private mosfet_card(words: Buf[string], models: *Buf[ModelCard], notes: *Buf[string]) -> Result[Element, string]
    val name = words[0]

    if words.len() < 6 then return Err(s"'${name}' needs a drain, a gate, a source and a bulk node, and a model")

    val m = find_model(name, words[5], models)? match
        MosfetCard(m) -> m
        other -> return Err(s"'${name}' is a MOSFET, and model '${words[5]}' is ${owner(other)}")
    var w = DEFAULT_W
    var l = DEFAULT_L
    var times = 1.0
    var k: usize = 6

    while k < words.len()
        if words[k] == "off"
            notes.push(s"'${name}': off is not acted on")
            k += 1
            continue

        if k + 2 >= words.len() || words[k + 1] != "=" then return Err(s"'${words[k]}' on '${name}' needs '= value'")

        val v = words[k + 2]

        words[k] match
            "w" -> w = positive(v, "a channel width")?
            "l" -> l = positive(v, "a channel length")?
            "m" -> times = positive(v, "a multiplier")?
            _ ->
                parse_value(v)?
                notes.push(s"'${name}': ${words[k]} is not modelled")

        k += 3

    if words[4] != words[3] then notes.push(s"'${name}': its bulk is taken to be on its source, '${words[3]}'")

    Ok(Element(Mosfet(m, w * times, l), words[1], words[2], Some(words[3]), 0.0))

// What a model is for, as an error puts it.
private owner(model: CardModel) -> string = model match
    DiodeCard(_) -> "a diode's"
    TransistorCard(_) -> "a transistor's"
    MosfetCard(_) -> "a MOSFET's"

private models_have(models: *Buf[ModelCard], name: string) -> bool
    for k in 0..<models.len()
        if models[k].name == name then return true

    false

// The model called `model` that element `element` names.
private find_model(element: string, model: string, models: *Buf[ModelCard]) -> Result[CardModel, string]
    for k in 0..<models.len()
        if models[k].name == model then return Ok(models[k].model)

    Err(s"'${element}' names model '${model}', which no .model defines")

private positive(word: string, what: string) -> Result[real, string]
    val v = parse_value(word)?

    if v <= 0.0 then return Err(s"${what} is more than zero")

    Ok(v)

// A value, then perhaps `ic = v`.
private value_and_ic(name: string, rest: []const string) -> Result[(real, real), string]
    val v = parse_value(rest[0])?

    if rest.len == 1 then return Ok((v, 0.0))

    if rest.len == 4 && rest[1] == "ic" && rest[2] == "="
        return Ok((v, parse_value(rest[3])?))

    Err(s"'${name}' takes a value and perhaps IC=")

// A source's `ac` part, `AC magnitude [phase]`, with the phase in degrees: how `.ac` drives it. A
// source without one is not driven; SPICE's magnitude when the word stands alone is 1.
private source_ac(words: []const string) -> Option[(real, real)]
    for k in 0..<words.len
        if words[k] == "ac"
            val mag = if k + 1 < words.len then parse_value(words[k + 1]).unwrap_or(1.0) else 1.0
            val phase = if k + 2 < words.len then parse_value(words[k + 2]).unwrap_or(0.0) else 0.0

            return Some((mag, phase))

    None

// A source's value or wave: `[dc] v`, `pulse(…)`, `sin(…)` or `pwl(…)`, each perhaps with an `ac`
// part, which `source_ac` reads.
private source_wave(name: string, words: []const string, tstep: real, tstop: real) -> Result[Wave, string]
    var dc: Option[real] = None
    var wave: Option[Wave] = None
    var driven = false
    var k: usize = 0

    while k < words.len
        val w = words[k]

        if w == "dc"
            if k + 1 >= words.len then return Err(s"'${name}': dc needs a value")

            dc = Some(parse_value(words[k + 1])?)
            k += 2
        elif w == "ac"
            // A magnitude and perhaps a phase, read by `source_ac`.
            driven = true
            k += 1

            var taken = 0

            while k < words.len && taken < 2 && parse_value(words[k]).is_ok()
                k += 1
                taken += 1
        elif w == "pulse" || w == "sin" || w == "pwl"
            var args: Buf[real] = buf()

            k += 1

            while k < words.len && parse_value(words[k]).is_ok()
                args.push(parse_value(words[k]).unwrap())
                k += 1

            wave = Some(spice_wave(name, w, args, tstep, tstop)?)
        elif w == "exp" || w == "sffm" || w == "am"
            return Err(s"'${name}': ${w} sources are not supported yet")
        else
            if dc.is_some() || k != 0 then return Err(s"'${name}': '${w}' is not part of a source")

            dc = Some(parse_value(w)?)
            k += 1

    wave match
        Some(w) -> Ok(w)
        None -> dc match
            Some(v) -> Ok(Dc(v))
            // A source that is only an `AC` part holds nothing still, as SPICE has it.
            None -> if driven then Ok(Dc(0.0)) else Err(s"'${name}' needs a value")

// SPICE's waves from their arguments, with SPICE's defaults for those left off.
private spice_wave(name: string, kind: string, v: Buf[real], tstep: real, tstop: real) -> Result[Wave, string]
    val n = v.len()
    // Where `.tran` has not said, an edge is a nanosecond and a period is for ever.
    val step = if tstep > 0.0 then tstep else 1e-9
    val stop = if tstop > 0.0 then tstop else 1e300

    kind match
        "pulse" ->
            if n < 2 || n > 7 then return Err(s"'${name}': PULSE takes from two to seven values")

            val td = if n > 2 then v[2] else 0.0
            val tr = if n > 3 && v[3] > 0.0 then v[3] else step
            val tf = if n > 4 && v[4] > 0.0 then v[4] else step
            val pw = if n > 5 then v[5] else stop
            val per = if n > 6 && v[6] > 0.0 then v[6] else stop

            if per < tr + pw + tf then return Ok(Pulse(v[0], v[1], td, tr, tf, pw, tr + pw + tf + stop))

            Ok(Pulse(v[0], v[1], td, tr, tf, pw, per))
        "sin" ->
            if n < 2 || n > 6 then return Err(s"'${name}': SIN takes from two to six values")

            val freq = if n > 2 && v[2] > 0.0 then v[2] else 1.0 / stop

            Ok(Sine(v[0], v[1], freq, if n > 3 then v[3] else 0.0, if n > 4 then v[4] else 0.0, if n > 5 then v[5] else 0.0))
        _ ->
            if n == 0 || n % 2 != 0 then return Err(s"'${name}': PWL takes pairs of a time and a value")

            var points: Buf[(real, real)] = buf()

            for k in 0..<n / 2
                if k > 0 && v[2 * k] < v[2 * k - 2] then return Err(s"'${name}': PWL's times run forward")

                points.push((v[2 * k], v[2 * k + 1]))

            Ok(Pwl(points))
