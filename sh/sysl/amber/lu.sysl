module sh.sysl.amber

import sysl.buf.{Buf, buf}
import sysl.math.{Float, Magnitude}
import sysl.math.complex.Complex

// What a system's matrix holds: a real number for the circuit through time, a complex one for its
// response to a sine. Pivoting asks each entry its size, which is the one comparison both have.
trait Entry: Add + Sub + Mul + Div + Zero + Eq + Magnitude

impl Entry for real

impl[F: Float] Entry for Complex[F]

// A square system `A · x = z`, solved by LU factorisation with partial pivoting.
//
// **It is kept dense and eliminated sparse.** A circuit's matrix is mostly zeros, a handful of
// entries a row — a node's own conductances and its neighbours' — and so are its factors, filled in
// only where elimination joins neighbours of neighbours. Each step of the elimination looks once at
// the pivot's row for the entries that are not zero, and updates only the rows with something under
// the pivot, only in those columns: the work is the factors' entries rather than `n³`. Leaving out a
// product with zero changes no sum, so the answer is the dense elimination's to the last bit.
//
// **Only the entries ever written are cleared** for the next writing: those `at` has stamped and
// those elimination has filled in, which `touched` lists, rather than all `n²`.
struct System[T: Entry]
    n: int
    // Row-major, `n × n`.
    a: Buf[T]
    z: Buf[T]
    // Whether each entry has ever been written, and those entries' places.
    written: Buf[bool]
    touched: Buf[int]
    // Each pivot row's columns right of the diagonal that are not zero, the rows of U, one after
    // another: row `k`'s are `cols[starts[k]..<starts[k + 1]]`. Made afresh by each `solve`.
    cols: Buf[int]
    starts: Buf[int]
    // The rows below the pivot with something to eliminate, for the step at hand.
    below: Buf[int]

    clear(*self)
        for k in self.touched
            self.a[usize(k)] = T.zero()

        for i in 0..<self.z.len()
            self.z[i] = T.zero()

    // Add `v` to the entry at row `r`, column `c`. A row or column of -1 is ground, which has no
    // equation of its own, and the stamp lands nowhere.
    at(*self, r: int, c: int, v: T)
        if r < 0 || c < 0 then return

        val k = r * self.n + c

        self.mark(k)
        self.a[usize(k)] += v

    // Add `v` to the right-hand side at row `r`.
    rhs(*self, r: int, v: T)
        if r < 0 then return

        self.z[usize(r)] += v

    // Solve in place: on return `z` holds `x`, and `a` holds the factors. `None` when the matrix is
    // singular — a node no part fixes the voltage of, or a loop of voltage sources.
    solve(*self) -> Option[unit]
        val n = self.n
        val nothing = T.zero().magnitude()
        val zero = T.zero()

        self.cols.clear()
        self.starts.clear()

        for k in 0..<n
            var p = k
            var best = self.a[usize(k * n + k)].magnitude()

            for r in k + 1..<n
                val v = self.a[usize(r * n + k)].magnitude()

                if v > best
                    best = v
                    p = r

            if best <= nothing then return None

            // Only the columns still to be eliminated: those left of the diagonal are never read
            // again.
            if p != k
                for c in k..<n
                    val t = self.a[usize(k * n + c)]

                    // A value moved into an entry never written makes it one to clear.
                    if t != zero then self.mark(p * n + c)

                    if self.a[usize(p * n + c)] != zero then self.mark(k * n + c)

                    self.a[usize(k * n + c)] = self.a[usize(p * n + c)]
                    self.a[usize(p * n + c)] = t

                val t = self.z[usize(k)]

                self.z[usize(k)] = self.z[usize(p)]
                self.z[usize(p)] = t

            self.starts.push(int(self.cols.len()))

            for c in k + 1..<n
                if self.a[usize(k * n + c)] != zero then self.cols.push(c)

            self.below.clear()

            for r in k + 1..<n
                if self.a[usize(r * n + k)] != zero then self.below.push(r)

            val pivot = self.a[usize(k * n + k)]
            val first = usize(self.starts[usize(k)])
            val last = self.cols.len()

            for r in self.below
                val f = self.a[usize(r * n + k)] / pivot

                for j in first..<last
                    val at = r * n + self.cols[j]

                    self.mark(at)
                    self.a[usize(at)] -= f * self.a[usize(k * n + self.cols[j])]

                self.z[usize(r)] -= f * self.z[usize(k)]

        self.starts.push(int(self.cols.len()))

        var r = n - 1

        while r >= 0
            var s = self.z[usize(r)]

            for j in usize(self.starts[usize(r)])..<usize(self.starts[usize(r + 1)])
                val c = self.cols[j]

                s -= self.a[usize(r * n + c)] * self.z[usize(c)]

            self.z[usize(r)] = s / self.a[usize(r * n + r)]
            r -= 1

        Some(())

    // Note entry `k` as written, so the next clearing clears it.
    private mark(*self, k: int)
        if !self.written[usize(k)]
            self.written[usize(k)] = true
            self.touched.push(k)
end System

system[T: Entry](n: int) -> System[T]
    var a: Buf[T] = buf()
    var z: Buf[T] = buf()
    var written: Buf[bool] = buf()

    for _ in 0..<n * n
        a.push(T.zero())
        written.push(false)

    for _ in 0..<n
        z.push(T.zero())

    System(n, a, z, written, buf(), buf(), buf(), buf())
