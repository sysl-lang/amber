module sh.sysl.amber

import sysl.buf.{Buf, buf}

// A dense square system `A · x = z`, solved by LU factorisation with partial pivoting.
//
// A circuit's matrix is mostly zeros, and a large one wants a sparse factorisation; the circuits a
// person draws on a screen have tens of unknowns, where the dense one is simpler and fast enough.
struct System
    n: int
    // Row-major, `n × n`.
    a: Buf[real]
    z: Buf[real]

    clear(*self)
        for i in 0..<self.a.len()
            self.a[i] = 0.0

        for i in 0..<self.z.len()
            self.z[i] = 0.0

    // Add `v` to the entry at row `r`, column `c`. A row or column of -1 is ground, which has no
    // equation of its own, and the stamp lands nowhere.
    at(*self, r: int, c: int, v: real)
        if r < 0 || c < 0 then return

        self.a[usize(r * self.n + c)] += v

    // Add `v` to the right-hand side at row `r`.
    rhs(*self, r: int, v: real)
        if r < 0 then return

        self.z[usize(r)] += v

    // Solve in place: on return `z` holds `x`, and `a` holds the factors. `None` when the matrix is
    // singular — a node no part fixes the voltage of, or a loop of voltage sources.
    solve(*self) -> Option[unit]
        val n = self.n

        for k in 0..<n
            var p = k
            var best = self.a[usize(k * n + k)].abs()

            for r in k + 1..<n
                val v = self.a[usize(r * n + k)].abs()

                if v > best
                    best = v
                    p = r

            if best < 1e-300 then return None

            if p != k
                for c in 0..<n
                    val t = self.a[usize(k * n + c)]

                    self.a[usize(k * n + c)] = self.a[usize(p * n + c)]
                    self.a[usize(p * n + c)] = t

                val t = self.z[usize(k)]

                self.z[usize(k)] = self.z[usize(p)]
                self.z[usize(p)] = t

            val pivot = self.a[usize(k * n + k)]

            for r in k + 1..<n
                val f = self.a[usize(r * n + k)] / pivot

                if f != 0.0
                    for c in k + 1..<n
                        self.a[usize(r * n + c)] -= f * self.a[usize(k * n + c)]

                    self.z[usize(r)] -= f * self.z[usize(k)]

        var r = n - 1

        while r >= 0
            var s = self.z[usize(r)]

            for c in r + 1..<n
                s -= self.a[usize(r * n + c)] * self.z[usize(c)]

            self.z[usize(r)] = s / self.a[usize(r * n + r)]
            r -= 1

        Some(())
end System

system(n: int) -> System
    var a: Buf[real] = buf()
    var z: Buf[real] = buf()

    for _ in 0..<n * n
        a.push(0.0)

    for _ in 0..<n
        z.push(0.0)

    System(n, a, z)
