module sh.sysl.amber

import sysl.buf.{Buf, buf}
import sysl.math.max
import sysl.math.complex.Complex

// What an analysis answers with: named columns, and a row for each moment or each value swept.
struct Table
    columns: Buf[string]
    rows: Buf[Buf[real]]

    // The column called `name`, if there is one.
    column(self, name: string) -> Option[int]
        for k in 0..<self.columns.len()
            if self.columns[k] == name then return Some(int(k))

        None

// Run analysis `a` of netlist `net`.
//
// **The columns are SPICE's vectors**: `v(node)` for every node but ground, then `i(name)` for every
// voltage source and inductor, the current through it from its first node to its second. A run through
// time puts `time` first, a sweep the swept source's name; the operating point is one row.
run_analysis(net: Netlist, a: Analysis) -> Result[Table, string]
    var s = sim(net.circuit)

    for i in 0..<net.initial.len()
        s.set_initial(int(i), net.initial[i])

    a match
        Op ->
            s.operating_point()?

            var t = table(net, "")

            t.rows.push(row(net, &s, None))
            Ok(t)
        Tran(step, stop, start, longest, from_empty) ->
            s.longest_step = longest

            if from_empty then s.power_on()? else s.operating_point()?

            var t = table(net, "time")
            // Printed every `step` from the first multiple of it at or after `start`; the last row may
            // land a hair past `stop` by rounding, and is put on it.
            val count = int((stop / step + 1e-9).floor())
            var k = int((start / step - 1e-9).ceil())

            while k <= count
                val at = if k == count then stop else real(k) * step

                s.advance_to(at)?
                t.rows.push(row(net, &s, Some(at)))
                k += 1

            Ok(t)
        Sweep(source, from, to, step) ->
            val i = net.circuit.find_part(source).unwrap()
            var t = table(net, source)
            val count = int(((to - from) / step + 1e-9).floor())

            for k in 0..count
                val value = from + real(k) * step

                s.set_wave(i, Dc(value))
                s.operating_point()?
                t.rows.push(row(net, &s, Some(value)))

            Ok(t)
        Ac(spacing, points, from, to) ->
            s.operating_point()?

            var t = ac_table(net)

            for f in frequencies(spacing, points, from, to)
                val r = s.response(f, net.drives.view())?
                var cells: Buf[real] = buf()

                cells.push(f)

                for n in 1..<net.circuit.nodes.len()
                    push_phasor(&cells, r.voltage(int(n)))

                for i in 0..<net.circuit.parts.len()
                    net.circuit.parts[i].kind match
                        VoltageSource(_) | Inductor(_) -> push_phasor(&cells, r.current(int(i)))
                        _ -> ()

                t.rows.push(cells)

            Ok(t)

// `.ac`'s columns, SPICE's names for the parts of a phasor: for each node `vdb` (its size in
// decibels), `vp` (its phase in radians), `vr` and `vi` (its real and imaginary parts), and the same
// four for each voltage source's and inductor's current.
private ac_table(net: Netlist) -> Table
    var columns: Buf[string] = buf()

    columns.push("frequency")

    for n in 1..<net.circuit.nodes.len()
        for part in ["vdb", "vp", "vr", "vi"]
            columns.push(s"${part}(${net.circuit.nodes[n]})")

    for i in 0..<net.circuit.parts.len()
        val p = net.circuit.parts[i]

        p.kind match
            VoltageSource(_) | Inductor(_) ->
                for part in ["idb", "ip", "ir", "ii"]
                    columns.push(s"${part}(${p.name})")
            _ -> ()

    Table(columns, buf())

private push_phasor(cells: *Buf[real], z: Complex[real])
    cells.push(decibels(z))
    cells.push(z.arg())
    cells.push(z.re)
    cells.push(z.im)

// A phasor's size in decibels, `20 log10 |z|`; a node the sine never reaches is given -300 dB rather
// than minus infinity.
decibels(z: Complex[real]) -> real = 20.0 * max(z.abs(), 1e-15).log10()

private table(net: Netlist, first: string) -> Table
    var columns: Buf[string] = buf()

    if first != "" then columns.push(first)

    for n in 1..<net.circuit.nodes.len()
        columns.push(s"v(${net.circuit.nodes[n]})")

    for i in 0..<net.circuit.parts.len()
        val p = net.circuit.parts[i]

        p.kind match
            VoltageSource(_) | Inductor(_) -> columns.push(s"i(${p.name})")
            _ -> ()

    Table(columns, buf())

private row(net: Netlist, s: *Sim, first: Option[real]) -> Buf[real]
    var r: Buf[real] = buf()

    if first is Some(v) then r.push(v)

    for n in 1..<net.circuit.nodes.len()
        r.push(s.voltage(int(n)))

    for i in 0..<net.circuit.parts.len()
        net.circuit.parts[i].kind match
            VoltageSource(_) | Inductor(_) -> r.push(s.current(int(i)))
            _ -> ()

    r
