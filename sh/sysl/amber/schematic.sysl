module sh.sysl.amber

import sysl.buf.{Buf, buf}
import sysl.text.{Search, fields, split}

// A schematic: parts placed on a grid, joined by wires, which says both how the circuit looks and how
// it is connected.
//
// **A file is one element per line**, a kind, then a name for the ones that have one, then the grid
// points the element runs between, then its value:
//
//     # A battery, a resistor and an LED.
//     battery  B1  0 0  0 6  9V
//     resistor R1  0 0  6 0  470
//     led      D1  6 0  6 6  red
//     wire         6 6  0 6
//     ground       0 6
//     meter    M1  6 0  6 6
//
// | kind | points | value |
// |---|---|---|
// | `wire` | two | — |
// | `resistor` | two | ohms |
// | `capacitor` | two | farads |
// | `inductor` | two | henries |
// | `battery` | two, `+` first | volts |
// | `source` | two, `+` first | a wave, below |
// | `current` | two; the current flows out of the second | amps, or a wave |
// | `gen` | two: output, then return | a signal generator's settings, below |
// | `supply` | two, `+` first | a bench power supply's settings, below |
// | `switch` | two | `open` (the default) or `closed` |
// | `diode` | two, anode first | — |
// | `led` | two, anode first | `red` (the default), `yellow`, `green` or `blue` |
// | `zener` | two, anode first | the voltage it breaks down at, reversed |
// | `npn`, `pnp` | three: collector, base, emitter | a model: `2N3904` (an npn's, the default) or `2N3906` (a pnp's) |
// | `nmos`, `pmos` | three: drain, gate, source | a model: `2N7000` (an nmos's, the default) or `BS250` (a pmos's) |
// | `transformer` | four: the primary's two ends, then the secondary's | a turns ratio, `120:9`, and perhaps the primary's inductance |
// | `speaker` | two | its voice coil's resistance, 8 Ω if not given; a viewer plays the voltage across it |
// | `opamp` | one, its middle; its pins are around it | a model: `741` (the default) or `TL072` |
// | `ground` | one | — |
// | `label` | one: names the node it is on | — |
// | `meter` | two: a voltmeter, red lead first | — |
//
// A transistor's collector and emitter are its body's two ends, and its base stands off to one side,
// a square or more from the line between them:
//
//     npn      Q1  3 9  5 11  3 13  2N3904
//
// A MOSFET is placed the same way, its drain and source the two ends and its gate off to one side; its
// channel is the library's default width and length:
//
//     nmos     M1  3 9  1 11  3 13  2N7000
//
// A transformer is two windings, each placed by its two ends, the first its dotted end, where the two
// rise together. Its primary is 10 H unless the line gives another inductance after the ratio, and its
// secondary is that over the ratio squared; the two are coupled at 0.999. It carries what a real one
// has without being drawn: a gigohm of insulation between its windings' second ends, and its core's
// losses, 10 kΩ across its primary.
//
//     transformer T1  10 2  10 10  12 2  12 10  120:9
//
// A wave is one of
//
//     dc <value>
//     sine <amplitude> <frequency> [<offset>]
//     square <low> <high> <frequency> [<duty>]
//     triangle <low> <high> <frequency>
//     pulse <low> <high> <delay> <rise> <fall> <width> <period>
//     pwl <time> <value> <time> <value> …
//
// A signal generator is a bench instrument rather than a bare source: a waveform, its frequency, its
// amplitude (the peak, from the offset), perhaps an offset, and perhaps an output resistance, which is
// 50 Ω if the line does not say. A `dc` generator puts out its offset, and keeps its frequency and
// amplitude for when it is switched back to a wave:
//
//     gen      G1  0 4  0 8  sine 1k 10m
//     gen      G2  0 4  0 8  square 50 2.5 2.5 600
//
// A bench power supply is a voltage and a current limit, regulated: it holds the voltage until the load
// would draw more than the limit, then holds the limit. `raw` makes it unregulated, a transformer,
// rectifier and capacitor: the voltage on average, a ripple peak to peak at twice the mains frequency
// (50 Hz, or 60), and an internal resistance (1 Ω if not given) it sags behind:
//
//     supply   P1  0 4  0 8  12 1
//     supply   P2  0 4  0 8  15 500m raw 2 60 1.5
//
// and a line `speed <seconds>` says how many seconds of the circuit's time a viewer should show in each
// second of its own; a line `start settled` says a viewer should switch it on already settled at its
// DC operating point rather than from every capacitor empty. `#` starts a comment, and a blank line is
// nothing.
//
// **Points join where they meet.** Two elements whose ends are at the same point are connected, and so
// is an end that lands anywhere along a wire, which is how a junction is drawn. Every set of joined
// points that a part or a ground touches is one node; the one holding a ground is ground, the one
// holding a label takes the label's name, and the others are numbered. A meter only looks: its leads
// join nothing together and make no node of their own.

enum Shape: u8
    Wire
    Resistor
    Capacitor
    Inductor
    Battery
    Source
    CurrentSource
    Generator
    Supply
    Switch
    Diode
    Led
    Zener
    Npn
    Pnp
    Nmos
    Pmos
    // One winding of a transformer: a `transformer` line makes two, its primary and then its secondary.
    Winding
    // A loudspeaker: to the circuit its voice coil's resistance; a viewer plays the voltage across it.
    Speaker
    // An op-amp, placed by its middle, its five pins around it: its non-inverting input, inverting
    // input, output, positive supply and negative supply.
    OpAmp
    Ground
    Label
    Meter

    // The number of grid points it is placed by.
    points(self) -> int = self match
        Ground | Label -> 1
        Npn | Pnp | Nmos | Pmos -> 3
        OpAmp -> 5
        _ -> 2

    // Whether it is a part of the circuit, rather than a wire, a marker or an instrument.
    is_part(self) -> bool = self != Wire && self != Ground && self != Label && self != Meter

// The colour an LED shines, which is also which model it is.
enum Colour: u8
    Red
    Yellow
    Green
    Blue

    model(self) -> DiodeModel = self match
        Red -> RED_LED
        Yellow -> YELLOW_LED
        Green -> GREEN_LED
        Blue -> BLUE_LED

// One element as it was placed.
struct Element
    shape: Shape
    name: string
    // The value as it was written, `470` or `sine 5 1k`, for showing beside the part; a transistor's
    // model, whether written or taken by default.
    value: string
    x1: int
    y1: int
    x2: int
    y2: int
    // The third point, a transistor's emitter; the second again for anything else.
    x3: int
    y3: int
    // The fourth and fifth points, an op-amp's supply pins; the third again for anything else.
    x4: int
    y4: int
    x5: int
    y5: int
    // The node each end is on; -1 for a meter's lead on a point no part reaches. `c` is a transistor's
    // emitter, and `b` again for anything else; `d` and `e` are an op-amp's supplies, and `c` again for
    // anything else.
    a: int
    b: int
    c: int
    d: int
    e: int
    // Which of the circuit's parts it is; -1 for anything that is not a part.
    part: int
    colour: Colour

    // Grid point `k` it is placed by, from 0.
    point(self, k: int) -> (int, int) = k match
        0 -> (self.x1, self.y1)
        1 -> (self.x2, self.y2)
        2 -> (self.x3, self.y3)
        3 -> (self.x4, self.y4)
        _ -> (self.x5, self.y5)

    // The node its end `k` is on.
    node(self, k: int) -> int = k match
        0 -> self.a
        1 -> self.b
        2 -> self.c
        3 -> self.d
        _ -> self.e

// A straight run of wire with no junction along it, between two grid points, and the element it is a
// piece of. A wire with a junction partway along is two segments, since the two halves can carry
// different currents.
struct Segment
    element: int
    x1: int
    y1: int
    x2: int
    y2: int

struct Schematic
    elements: Buf[Element]
    circuit: Circuit
    segments: Buf[Segment]
    // Seconds of the circuit's time a viewer shows in a second of its own; 0 where the file does not
    // say.
    speed: real
    // Whether a viewer starts the circuit at its DC operating point rather than switched on from empty.
    settled: bool

    // The element called `name`, if there is one.
    find(self, name: string) -> Option[int]
        for i in 0..<self.elements.len()
            if self.elements[i].name == name then return Some(int(i))

        None

    // The node at grid point (`x`, `y`), if a part or wire is joined there.
    node_at(self, x: int, y: int) -> Option[int]
        for i in 0..<self.elements.len()
            val e = self.elements[i]

            if e.shape == Meter || e.a < 0 then continue

            for end in 0..<e.shape.points()
                if e.point(end) == (x, y) then return Some(e.node(end))

            if e.shape == Wire && on_segment(x, y, e) then return Some(e.a)

        None

    // The current along each segment, in the order of `segments`, from its first point to its second.
    //
    // **Within a node, the wires share out the current the parts on it push in and draw out.** Each
    // node's wires form a graph on the grid points; a tree is grown over it, and each tree edge carries
    // everything that enters the subtree beyond it. A ground symbol is a way out to the reference,
    // which every ground in the circuit shares. A loop of wire has no single answer — any current may
    // circulate round it — and its closing segment is given none.
    segment_currents(self, s: Sim) -> Buf[real]
        // The grid points that segment ends and part ends sit on, numbered; point 0 is the reference
        // that ground symbols lead to.
        var px: Buf[int] = buf()
        var py: Buf[int] = buf()

        px.push(0)
        py.push(0)

        val first = self.segments.len()
        var inject: Buf[real] = buf()
        var edge_a: Buf[int] = buf()
        var edge_b: Buf[int] = buf()

        inject.push(0.0)

        for k in 0..<self.segments.len()
            val g = self.segments[k]

            edge_a.push(point_id(&px, &py, &inject, g.x1, g.y1))
            edge_b.push(point_id(&px, &py, &inject, g.x2, g.y2))

        for i in 0..<self.elements.len()
            val e = self.elements[i]

            if e.shape == Ground
                edge_a.push(point_id(&px, &py, &inject, e.x1, e.y1))
                edge_b.push(0)

            // A transistor or an op-amp takes in at each terminal the current that flows into it there.
            if e.part >= 0 && e.shape.points() >= 3
                for t in 0..<e.shape.points()
                    val (x, y) = e.point(t)
                    val p = point_id(&px, &py, &inject, x, y)

                    inject[usize(p)] -= s.terminal_current(e.part, t)
            elif e.part >= 0
                val amps = s.current(e.part)
                val a = point_id(&px, &py, &inject, e.x1, e.y1)
                val b = point_id(&px, &py, &inject, e.x2, e.y2)

                // The part draws its current from its first end's point and pushes it into its
                // second's.
                inject[usize(a)] -= amps
                inject[usize(b)] += amps

        val points = px.len()
        // The tree: each point's parent and the edge to it, and the order points were reached in.
        var parent: Buf[int] = buf()
        var via: Buf[int] = buf()
        var order: Buf[int] = buf()

        for _ in 0..<points
            parent.push(-2)
            via.push(-1)

        for root in 0..<points
            if parent[root] != -2 then continue

            parent[root] = -1
            order.push(int(root))

            var head: usize = order.len() - 1

            while head < order.len()
                val p = order[head]

                head += 1

                for k in 0..<edge_a.len()
                    val other = if edge_a[k] == p then edge_b[k] elif edge_b[k] == p then edge_a[k] else -1

                    if other >= 0 && parent[usize(other)] == -2
                        parent[usize(other)] = p
                        via[usize(other)] = int(k)
                        order.push(other)

        var flow: Buf[real] = buf()

        for _ in 0..<edge_a.len()
            flow.push(0.0)

        // Leaves first: each point hands its parent everything that entered below it.
        var k = order.len()

        while k > 0
            k -= 1

            val p = order[k]
            val up = parent[usize(p)]

            if up < 0 then continue

            val e = via[usize(p)]
            val amps = inject[usize(p)]

            // `amps` flows from `p` to `up`; the edge is positive from its first point to its second.
            flow[usize(e)] = if edge_a[usize(e)] == p then amps else -amps
            inject[usize(up)] += amps

        var out: Buf[real] = buf()

        for k in 0..<first
            out.push(flow[k])

        out
end Schematic

// The number of the grid point (`x`, `y`), numbering it now if it is new.
private point_id(px: *Buf[int], py: *Buf[int], inject: *Buf[real], x: int, y: int) -> int
    for k in 1..<px.len()
        if px[k] == x && py[k] == y then return int(k)

    px.push(x)
    py.push(y)
    inject.push(0.0)
    int(px.len()) - 1

// Read a schematic and build its circuit. An error names the line.
parse_schematic(text: string) -> Result[Schematic, string]
    var elements: Buf[Element] = buf()
    var kinds: Buf[Option[Kind]] = buf()
    var speed = 0.0
    var settled = false
    var line_no = 0

    for raw in split(text, "\n")
        line_no += 1

        val hash = raw.index_of_byte('#')
        val line = hash match
            Some(at) -> raw[0..<at]
            None -> raw
        val words = fields(line)

        if words.len == 0 then continue

        if words[0] == "speed"
            if words.len != 2 then return Err(s"line ${line_no}: speed takes one value, seconds a second")

            speed = parse_value(words[1]).map_err(why -> s"line ${line_no}: ${why}")?

            if speed <= 0.0 then return Err(s"line ${line_no}: a speed is more than zero")

            continue

        if words[0] == "start"
            if words.len != 2 then return Err(s"line ${line_no}: start takes one word, settled")

            if words[1] != "settled" then return Err(s"line ${line_no}: '${words[1]}' is not a way to start: settled")

            settled = true
            continue

        var parts: Buf[(Element, Option[Kind])] = buf()

        if words[0] == "transformer"
            parts = transformer(words).map_err(why -> s"line ${line_no}: ${why}")?
        elif words[0] == "opamp"
            parts.push(opamp(words).map_err(why -> s"line ${line_no}: ${why}")?)
        else
            parts.push(element(words).map_err(why -> s"line ${line_no}: ${why}")?)

        val name = parts[0].0.name

        if name != ""
            for k in 0..<elements.len()
                if elements[k].name == name then return Err(s"line ${line_no}: '${name}' is already the name of another element")

        for (e, kind) in parts
            elements.push(e)
            kinds.push(kind)

    join(&elements)

    var sch = build(elements, kinds)?

    sch.speed = speed
    sch.settled = settled
    Ok(sch)

// One line's element, its nodes not yet known, and the part it is if it is one.
private element(words: []string) -> Result[(Element, Option[Kind]), string]
    val shape = shape_named(words[0])?
    val named = shape != Wire && shape != Ground
    var at: usize = 1
    var name = ""

    val one = a_word(words[0])

    if named
        if words.len < 2 then return Err(s"${one} needs a name")

        name = words[1]
        at = 2

    val count = usize(shape.points() * 2)

    if words.len < at + count then return Err(s"${one} is placed by ${shape.points()} point${if count == 2 then "" else "s"}")

    var xy: [6]int = [0, 0, 0, 0, 0, 0]

    for k in 0..<count
        xy[k] = parse_coordinate(words[at + k])?

    if shape.points() == 1
        xy[2] = xy[0]
        xy[3] = xy[1]
    elif shape.points() == 3
        transistor_placed(shape, one, xy)?
    elif xy[0] == xy[2] && xy[1] == xy[3]
        return Err(s"${one} needs two different points")

    if shape.points() < 3
        xy[4] = xy[2]
        xy[5] = xy[3]

    at += count

    val rest = words[at..<words.len]
    var colour = Red

    if shape == Led && rest.len > 0 then colour = colour_named(rest[0])?

    val kind = if shape.is_part() then Some(part_kind(shape, words[0], rest, colour)?) else None
    val most = shape match
        Wire | Ground | Label | Meter | Diode -> 0
        Source | CurrentSource | Generator | Supply -> rest.len
        _ -> 1

    if rest.len > usize(most) then return Err(s"'${rest[usize(most)]}' is more than ${one} takes")

    val value = shape match
        Npn | Pnp | Nmos | Pmos -> if rest.len == 0 then default_model(shape) else rest[0]
        Speaker -> if rest.len == 0 then "8" else rest[0]
        _ -> rest.join(" ")

    Ok((Element(shape, name, value, xy[0], xy[1], xy[2], xy[3], xy[4], xy[5], xy[4], xy[5], xy[4], xy[5], -1, -1, -1, -1, -1, -1, colour), kind))

// A speaker's voice coil when its line gives none: the usual 8 Ω.
const SPEAKER_OHMS: real = 8.0

// A transformer's primary inductance when its line gives none: about 30 mA drawn from 120 V at 60 Hz
// with nothing on the secondary, a small mains transformer's.
const PRIMARY_HENRIES: real = 10.0

// How closely a transformer's windings are coupled: all but a thousandth of the flux one makes passes
// through the other.
const TRANSFORMER_COUPLING: real = 0.999

// The insulation between a transformer's windings. It carries nothing to speak of, and it says where
// the secondary stands while whatever it feeds draws nothing, as a rectifier's diodes all off do;
// without it the secondary's voltage would be anything at all, and the solver would chase it.
const INSULATION_OHMS: real = 1e9

// A transformer's core losses, as a resistance across its primary: about a watt and a half from 120 V,
// a small mains transformer's with nothing on its secondary. It is also where the core's energy goes
// when the primary is cut off, as a switch opening on it does; without it the current in the primary
// would have nowhere to go, and its voltage no limit.
const CORE_OHMS: real = 10e3

// A transformer's line: its name, its primary's two points, its secondary's two points, its turns ratio
// `primary:secondary`, and perhaps its primary's inductance. Each winding's first point is its dotted
// end, so the two first points rise together. It is two windings, the primary first.
private transformer(words: []string) -> Result[Buf[(Element, Option[Kind])], string]
    if words.len < 2 then return Err("a transformer needs a name")

    val name = words[1]

    if words.len < 10 then return Err("a transformer is placed by 4 points: its primary's two ends, then its secondary's")

    var xy: [8]int = [0, 0, 0, 0, 0, 0, 0, 0]

    for k in 0..<8
        xy[k] = parse_coordinate(words[2 + k])?

    if xy[0] == xy[2] && xy[1] == xy[3] then return Err("a transformer's primary needs two different points")

    if xy[4] == xy[6] && xy[5] == xy[7] then return Err("a transformer's secondary needs two different points")

    val rest = words[10..<words.len]

    if rest.len == 0 then return Err("a transformer needs its turns ratio, primary:secondary, such as 120:9")

    if rest.len > 2 then return Err(s"'${rest[2]}' is more than a transformer takes")

    val sides = split(rest[0], ":")

    if sides.len != 2 then return Err(s"'${rest[0]}' is not a turns ratio: primary:secondary, such as 120:9")

    val ratio = positive(sides[0], "a turns ratio's primary")? / positive(sides[1], "a turns ratio's secondary")?
    val primary = if rest.len == 2 then positive(rest[1], "an inductance")? else PRIMARY_HENRIES
    var out: Buf[(Element, Option[Kind])] = buf()

    out.push((Element(Winding, name, rest[0], xy[0], xy[1], xy[2], xy[3], xy[2], xy[3], xy[2], xy[3], xy[2], xy[3], -1, -1, -1, -1, -1, -1, Red),
              Some(Inductor(primary))))
    out.push((Element(Winding, name, "", xy[4], xy[5], xy[6], xy[7], xy[6], xy[7], xy[6], xy[7], xy[6], xy[7], -1, -1, -1, -1, -1, -1, Red),
              Some(Inductor(primary / (ratio * ratio)))))
    Ok(out)

// An op-amp's line: its name, the grid point at its middle, and perhaps its model, `741` (the
// default) or `TL072`. Its pins are around that point: the inverting input two squares left and one up,
// the non-inverting input two left and one down, the output two right, and the positive and negative
// supplies two up and two down.
private opamp(words: []string) -> Result[(Element, Option[Kind]), string]
    if words.len < 2 then return Err("an opamp needs a name")

    if words.len < 4 then return Err("an opamp is placed by 1 point, its middle")

    if words.len > 5 then return Err(s"'${words[5]}' is more than an opamp takes")

    val name = words[1]
    val x = parse_coordinate(words[2])?
    val y = parse_coordinate(words[3])?
    val model = if words.len == 5 then words[4] else "741"
    val m = model match
        "741" -> OPAMP_741
        "TL072" -> OPAMP_TL072
        _ -> return Err(s"'${model}' is not an op-amp model: 741 or TL072")

    Ok((Element(OpAmp, name, model, x - 2, y + 1, x - 2, y - 1, x + 2, y, x, y - 2, x, y + 2, -1, -1, -1, -1, -1, -1, Red), Some(OpAmp(m))))

// "a resistor", "an inductor", "an npn": the kind with its article.
private a_word(word: string) -> string
    val b = word.bytes
    val vowel = b.len > 0 && (b[0] == u8('a') || b[0] == u8('e') || b[0] == u8('i') || b[0] == u8('o') || b[0] == u8('u'))

    if vowel || word == "npn" || word == "nmos" then s"an ${word}" else s"a ${word}"

// A transistor's three points, collector, base and emitter (a MOSFET's drain, gate and source), in `xy`:
// its two ends apart, and its base or gate a square or more off the line between them, where its symbol
// has room.
private transistor_placed(shape: Shape, one: string, xy: [6]int) -> Result[unit, string]
    val dx = xy[4] - xy[0]
    val dy = xy[5] - xy[1]
    val mos = shape == Nmos || shape == Pmos
    val (first, middle, last) = if mos then ("drain", "gate", "source") else ("collector", "base", "emitter")

    if dx == 0 && dy == 0 then return Err(s"${one} needs its ${first} and ${last} at different points")

    // Twice the area of the triangle the three points make, which is the base's distance from the line
    // times the line's length.
    val cross = dx * (xy[3] - xy[1]) - dy * (xy[2] - xy[0])

    if cross * cross < dx * dx + dy * dy then return Err(s"${one}'s ${middle} stands a square or more off the line from its ${first} to its ${last}")

    Ok(())

private shape_named(word: string) -> Result[Shape, string] = word match
    "wire" -> Ok(Wire)
    "resistor" -> Ok(Resistor)
    "capacitor" -> Ok(Capacitor)
    "inductor" -> Ok(Inductor)
    "battery" -> Ok(Battery)
    "source" -> Ok(Source)
    "current" -> Ok(CurrentSource)
    "gen" -> Ok(Generator)
    "supply" -> Ok(Supply)
    "switch" -> Ok(Switch)
    "diode" -> Ok(Diode)
    "led" -> Ok(Led)
    "zener" -> Ok(Zener)
    "npn" -> Ok(Npn)
    "pnp" -> Ok(Pnp)
    "nmos" -> Ok(Nmos)
    "pmos" -> Ok(Pmos)
    "ground" -> Ok(Ground)
    "label" -> Ok(Label)
    "meter" -> Ok(Meter)
    "speaker" -> Ok(Speaker)
    _ -> Err(s"'${word}' is not a kind of element")

private colour_named(word: string) -> Result[Colour, string] = word match
    "red" -> Ok(Red)
    "yellow" -> Ok(Yellow)
    "green" -> Ok(Green)
    "blue" -> Ok(Blue)
    _ -> Err(s"'${word}' is not an LED colour: red, yellow, green or blue")

// The part an element is, from the words after its points.
private part_kind(shape: Shape, kind_word: string, rest: []string, colour: Colour) -> Result[Kind, string]
    val optional = shape match
        // A generator and a supply say for themselves what they are missing.
        Diode | Led | Switch | Npn | Pnp | Nmos | Pmos | Generator | Supply | Speaker -> true
        _ -> false

    if rest.len == 0 && !optional then return Err(s"${a_word(kind_word)} needs a value")

    shape match
        Resistor -> Ok(Resistor(positive(rest[0], "a resistance")?))
        Capacitor -> Ok(Capacitor(positive(rest[0], "a capacitance")?))
        Inductor -> Ok(Inductor(positive(rest[0], "an inductance")?))
        Battery -> Ok(VoltageSource(Dc(parse_value(rest[0])?)))
        Source -> Ok(VoltageSource(parse_wave(rest)?))
        CurrentSource -> Ok(CurrentSource(if rest.len == 1 then Dc(parse_value(rest[0])?) else parse_wave(rest)?))
        Generator ->
            val (osc, ohms) = parse_generator(rest)?

            Ok(Generator(osc.wave(), ohms))
        Supply -> Ok(Supply(parse_supply(rest)?))
        Switch ->
            if rest.len == 0 then return Ok(Switch(false))

            rest[0] match
                "open" -> Ok(Switch(false))
                "closed" -> Ok(Switch(true))
                _ -> Err(s"'${rest[0]}' is not a switch's state: open or closed")
        Speaker -> Ok(Resistor(if rest.len == 0 then SPEAKER_OHMS else positive(rest[0], "a speaker's resistance")?))
        Diode -> Ok(Diode(SILICON))
        Led -> Ok(Diode(colour.model()))
        Zener -> Ok(Diode(zener_model(positive(rest[0], "a breakdown voltage")?)))
        Npn | Pnp -> Ok(Transistor(transistor_model(shape, if rest.len == 0 then default_model(shape) else rest[0])?))
        Nmos | Pmos -> Ok(Mosfet(mosfet_model(shape, if rest.len == 0 then default_model(shape) else rest[0])?, DEFAULT_W, DEFAULT_L))
        _ -> Err(s"${a_word(kind_word)} is not a part")

// The model a transistor is when its line names none.
private default_model(shape: Shape) -> string = shape match
    Pnp -> "2N3906"
    Nmos -> "2N7000"
    Pmos -> "BS250"
    _ -> "2N3904"

// A MOSFET's model by its name, which must be one of its own polarity's.
private mosfet_model(shape: Shape, word: string) -> Result[MosfetModel, string] = shape match
    Nmos -> if word == "2N7000" then Ok(NMOS_2N7000) else Err(s"'${word}' is not an NMOS model: 2N7000")
    _ -> if word == "BS250" then Ok(PMOS_BS250) else Err(s"'${word}' is not a PMOS model: BS250")

// A transistor's model by its name, which must be one of its own polarity's.
private transistor_model(shape: Shape, word: string) -> Result[TransistorModel, string] = shape match
    Npn -> if word == "2N3904" then Ok(NPN_2N3904) else Err(s"'${word}' is not an NPN model: 2N3904")
    _ -> if word == "2N3906" then Ok(PNP_2N3906) else Err(s"'${word}' is not a PNP model: 2N3906")

private positive(word: string, what: string) -> Result[real, string]
    val v = parse_value(word)?

    if v <= 0.0 then return Err(s"${what} is more than zero")

    Ok(v)

// A wave from its words: `dc 5`, `sine 5 1k`, `square 0 5 1k`, `pulse …`, `pwl …`.
parse_wave(words: []string) -> Result[Wave, string]
    if words.len == 0 then return Err("a wave needs a kind: dc, sine, square, triangle, pulse or pwl")

    var v: Buf[real] = buf()

    for k in 1..<words.len
        v.push(parse_value(words[k])?)

    val n = v.len()

    words[0] match
        "dc" ->
            if n != 1 then return Err("dc takes a value")

            Ok(Dc(v[0]))
        "sine" ->
            if n < 2 || n > 3 then return Err("sine takes an amplitude, a frequency and perhaps an offset")

            if v[1] <= 0.0 then return Err("a frequency is more than zero")

            Ok(Sine(if n == 3 then v[2] else 0.0, v[0], v[1], 0.0, 0.0, 0.0))
        "square" ->
            if n < 3 || n > 4 then return Err("square takes a low, a high, a frequency and perhaps a duty")

            if v[2] <= 0.0 then return Err("a frequency is more than zero")

            val duty = if n == 4 then v[3] else 0.5

            if duty <= 0.0 || duty >= 1.0 then return Err("a duty is between 0 and 1")

            Ok(square(v[0], v[1], v[2], duty))
        "triangle" ->
            if n != 3 then return Err("triangle takes a low, a high and a frequency")

            if v[2] <= 0.0 then return Err("a frequency is more than zero")

            Ok(triangle(v[0], v[1], v[2]))
        "pulse" ->
            if n != 7 then return Err("pulse takes low, high, delay, rise, fall, width and period")

            if v[3] <= 0.0 || v[4] <= 0.0 then return Err("a pulse's rise and fall take some time")

            if v[6] < v[3] + v[4] + v[5] then return Err("a pulse's period holds its rise, width and fall")

            Ok(Pulse(v[0], v[1], v[2], v[3], v[4], v[5], v[6]))
        "pwl" ->
            if n == 0 || n % 2 != 0 then return Err("pwl takes pairs of a time and a value")

            var points: Buf[(real, real)] = buf()

            for k in 0..<n / 2
                if k > 0 && v[2 * k] < v[2 * k - 2] then return Err("pwl's times run forward")

                points.push((v[2 * k], v[2 * k + 1]))

            Ok(Pwl(points))
        _ -> Err(s"'${words[0]}' is not a kind of wave: dc, sine, square, triangle, pulse or pwl")

// A signal generator's settings from the words after its points — `sine 1k 10m`, `square 50 2.5 2.5
// 600` — and its output resistance, 50 Ω where they do not give one.
parse_generator(words: []string) -> Result[(Oscillator, real), string]
    if words.len == 0 then return Err("a generator needs a waveform: sine, square, triangle or dc")

    val form = waveform_named(words[0]).ok_or(s"'${words[0]}' is not a generator's waveform: sine, square, triangle or dc")?

    if words.len < 3 then return Err("a generator takes a waveform, a frequency, an amplitude, and perhaps an offset and an output resistance")

    if words.len > 5 then return Err(s"'${words[5]}' is more than a generator takes")

    val frequency = positive(words[1], "a frequency")?
    val amplitude = parse_value(words[2])?

    if amplitude < 0.0 then return Err("an amplitude is not below zero")

    val offset = if words.len > 3 then parse_value(words[3])? else 0.0
    val ohms = if words.len > 4 then positive(words[4], "an output resistance")? else 50.0

    Ok((oscillator(form, frequency, amplitude, offset), ohms))

// A bench supply's settings from the words after its points: `12 1` for 12 V regulated, limited to an
// amp, or `15 500m raw 2` for a raw supply averaging 15 V with 2 V of ripple, then perhaps the mains
// frequency, 50 or 60 Hz (50 if not given), and perhaps an internal resistance (1 Ω if not given).
parse_supply(words: []string) -> Result[PowerSupply, string]
    if words.len < 2 then return Err("a supply takes a voltage, a current limit, and perhaps raw with a ripple, a mains frequency and an internal resistance")

    val volts = parse_value(words[0])?

    if volts < 0.0 then return Err("a supply's voltage is not below zero")

    val amps = positive(words[1], "a current limit")?

    if words.len == 2 then return Ok(regulated(volts, amps))

    if words[2] != "raw" then return Err(s"'${words[2]}' is not a supply's mode: raw, or nothing for regulated")

    if words.len < 4 then return Err("a raw supply takes a ripple, and perhaps a mains frequency and an internal resistance")

    if words.len > 6 then return Err(s"'${words[6]}' is more than a supply takes")

    val ripple = parse_value(words[3])?

    if ripple < 0.0 || ripple > 2.0 * volts then return Err("a ripple is between zero and twice the voltage")

    val mains = if words.len > 4 then parse_value(words[4])? else 50.0

    if mains != 50.0 && mains != 60.0 then return Err("a mains frequency is 50 or 60")

    val ohms = if words.len > 5 then positive(words[5], "an internal resistance")? else 1.0

    Ok(raw_supply(volts, amps, ripple, mains, ohms))

private parse_coordinate(word: string) -> Result[int, string]
    val b = word.bytes
    var i: usize = 0
    var negative = false

    if b.len > 0 && b[0] == u8('-')
        negative = true
        i = 1

    if i == b.len then return Err(s"'${word}' is not a grid coordinate")

    var n = 0

    while i < b.len
        if b[i] < u8('0') || b[i] > u8('9') then return Err(s"'${word}' is not a grid coordinate")

        n = n * 10 + int(b[i] - u8('0'))
        i += 1

    Ok(if negative then -n else n)

// Whether (`x`, `y`) lies on wire `w`, ends included.
private on_segment(x: int, y: int, w: Element) -> bool
    val cross = (w.x2 - w.x1) * (y - w.y1) - (w.y2 - w.y1) * (x - w.x1)

    if cross != 0 then return false

    x >= min_of(w.x1, w.x2) && x <= max_of(w.x1, w.x2) && y >= min_of(w.y1, w.y2) && y <= max_of(w.y1, w.y2)

private min_of(a: int, b: int) -> int = if a < b then a else b

private max_of(a: int, b: int) -> int = if a < b then b else a

// The most ends an element has: an op-amp's five pins.
const MOST_ENDS: int = 5

// Number every end by the set of joined points it belongs to: `a` to `e` are set to a net number, the
// same for ends that are joined, and an element with fewer ends repeats its last. Nets are found by
// union–find over the ends, `MOST_ENDS` slots per element. A meter's leads take the net of whatever
// they touch and join nothing to anything.
private join(elements: *Buf[Element])
    val n = elements.len()
    var parent: Buf[int] = buf()

    for k in 0..<MOST_ENDS * int(n)
        parent.push(int(k))

    for i in 0..<n
        val e = elements[i]
        val mine0 = MOST_ENDS * int(i)

        // A wire's two ends are one net; a part's are two or more.
        if e.shape == Wire then unite(&parent, mine0, mine0 + 1)

        for j in 0..<n
            val f = elements[j]

            if e.shape == Meter && f.shape == Meter then continue

            for end in 0..<f.shape.points()
                val (x, y) = f.point(end)
                val k = MOST_ENDS * int(j) + end

                for mine in 0..<e.shape.points()
                    val (ex, ey) = e.point(mine)

                    if ex == x && ey == y then unite(&parent, mine0 + mine, k)

                if e.shape == Wire && on_segment(x, y, e) then unite(&parent, mine0, k)

    for i in 0..<n
        val ends = elements[i].shape.points()
        val net = (end: int) -> root(&parent, MOST_ENDS * int(i) + min_of(end, ends - 1))

        elements[i].a = net(0)
        elements[i].b = net(1)
        elements[i].c = net(2)
        elements[i].d = net(3)
        elements[i].e = net(4)

private root(parent: *Buf[int], k: int) -> int
    var r = k

    while parent[usize(r)] != r
        r = parent[usize(r)]

    r

private unite(parent: *Buf[int], a: int, b: int)
    val ra = root(parent, a)
    val rb = root(parent, b)

    if ra != rb then parent[usize(ra)] = rb

// Turn net numbers into the circuit's nodes, every part into a part of the circuit, and the wires into
// segments.
private build(given: Buf[Element], kinds: Buf[Option[Kind]]) -> Result[Schematic, string]
    var elements = given
    var c = circuit()
    // The node each net became, by net number; -1 until it has one.
    var node_of: Buf[int] = buf()
    // Whether a part's end or a ground is on the net, which is what makes it a node.
    var live: Buf[bool] = buf()

    for _ in 0..<MOST_ENDS * int(elements.len())
        node_of.push(-1)
        live.push(false)

    for i in 0..<elements.len()
        val e = elements[i]

        if e.shape.is_part() || e.shape == Ground
            for end in 0..<MOST_ENDS
                live[usize(e.node(end))] = true

    // Grounds first, then labels, so a node's name is the one it was given wherever the label is.
    for i in 0..<elements.len()
        if elements[i].shape == Ground then node_of[usize(elements[i].a)] = 0

    for i in 0..<elements.len()
        val e = elements[i]

        if e.shape == Label
            if !live[usize(e.a)] then return Err(s"label '${e.name}' is on nothing")

            if node_of[usize(e.a)] == 0 then return Err(s"label '${e.name}' is on ground")

            if node_of[usize(e.a)] > 0 then return Err(s"label '${e.name}' is on a node already called '${c.nodes[usize(node_of[usize(e.a)])]}'")

            node_of[usize(e.a)] = c.node(e.name)

    var unnamed = 0

    for i in 0..<elements.len()
        for end in 0..<MOST_ENDS
            val net = elements[i].node(end)

            if live[usize(net)] && node_of[usize(net)] < 0
                unnamed += 1

                var name = s"n${unnamed}"

                while c.find_node(name).is_some()
                    unnamed += 1
                    name = s"n${unnamed}"

                node_of[usize(net)] = c.node(name)

    for i in 0..<elements.len()
        elements[i].a = node_of[usize(elements[i].a)]
        elements[i].b = node_of[usize(elements[i].b)]
        elements[i].c = node_of[usize(elements[i].c)]
        elements[i].d = node_of[usize(elements[i].d)]
        elements[i].e = node_of[usize(elements[i].e)]

        if kinds[i] is Some(kind)
            val e = elements[i]

            elements[i].part = int(c.parts.len())

            kind.terminals() match
                5 -> c.add5(e.name, kind, e.a, e.b, e.c, e.d, e.e)
                3 -> c.add3(e.name, kind, e.a, e.b, e.c)
                _ -> c.add(e.name, kind, e.a, e.b)

    // A transformer's windings, the primary (which carries the ratio) and the secondary after it, are
    // coupled, its insulation joins their second ends, and its core's losses are across its primary.
    for i in 0..<elements.len()
        val e = elements[i]

        if e.shape == Winding && e.value != ""
            val other = elements[i + 1]

            c.couple(e.name, e.part, other.part, TRANSFORMER_COUPLING)?
            c.add(s"${e.name} insulation", Resistor(INSULATION_OHMS), other.b, e.b)
            c.add(s"${e.name} core", Resistor(CORE_OHMS), e.a, e.b)

    Ok(Schematic(elements, c, segments_of(elements), 0.0, false))

// Every wire cut at the points along it where something else ends.
private segments_of(elements: Buf[Element]) -> Buf[Segment]
    var out: Buf[Segment] = buf()

    for i in 0..<elements.len()
        val w = elements[i]

        if w.shape != Wire then continue

        // Distances along the wire, in grid steps from its first end, where it is cut.
        val steps = max_of((w.x2 - w.x1).abs(), (w.y2 - w.y1).abs())
        var cuts: Buf[int] = buf()

        cuts.push(0)

        for j in 0..<elements.len()
            val f = elements[j]

            if j == i || f.shape == Meter then continue

            for end in 0..<f.shape.points()
                val (x, y) = f.point(end)

                if on_segment(x, y, w)
                    val d = max_of((x - w.x1).abs(), (y - w.y1).abs())

                    if d > 0 && d < steps && !has(&cuts, d) then cuts.push(d)

        cuts.push(steps)
        sort(&cuts)

        for k in 1..<cuts.len()
            val (ax, ay) = along(w, cuts[k - 1], steps)
            val (bx, by) = along(w, cuts[k], steps)

            out.push(Segment(int(i), ax, ay, bx, by))

    out

// The grid point `d` of `steps` along wire `w`. A diagonal wire's points between grid points round.
private along(w: Element, d: int, steps: int) -> (int, int) =
    (w.x1 + (w.x2 - w.x1) * d / steps, w.y1 + (w.y2 - w.y1) * d / steps)

private has(b: *Buf[int], v: int) -> bool
    for k in 0..<b.len()
        if b[k] == v then return true

    false

private sort(b: *Buf[int])
    for i in 1..<b.len()
        var j = i

        while j > 0 && b[j - 1] > b[j]
            val t = b[j]

            b[j] = b[j - 1]
            b[j - 1] = t
            j -= 1
