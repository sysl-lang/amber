        3.98107171e+07, -6.65131398e+01, -1.98229671e-04, 9.91174834e-01, 6.96758148e-07,
        6.30957344e+07, -6.65131398e+01, -1.25075478e-04, 9.91174834e-01, 4.39625567e-07,
