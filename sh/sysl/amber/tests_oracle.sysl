@test("ngspice: a diode's curve, swept through a resistor")
oracle_diode_dc()
    val netlist = """
        A diode's curve, swept through a resistor
        V1 a 0 0
        R1 a k 220
        D1 k 0 dmod
        .model dmod D (IS=1e-14 N=1.05 RS=1.5)
        .dc V1 -2 5 0.25
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        run
        wrdata diode_dc.data v(k)
        .endc
        .end
        """
    val names = ["v(k)"]
    val expected = [
        -2.00000000e+00, -2.00000000e+00,
        -1.75000000e+00, -1.75000000e+00,
        -1.50000000e+00, -1.50000000e+00,
        -1.25000000e+00, -1.25000000e+00,
        -1.00000000e+00, -1.00000000e+00,
        -7.50000000e-01, -7.50000000e-01,
        -5.00000000e-01, -5.00000000e-01,
        -2.50000000e-01, -2.50000000e-01,
        0.00000000e+00, -4.80354282e-29,
        2.50000000e-01, 2.49999978e-01,
        5.00000000e-01, 4.99783929e-01,
        7.50000000e-01, 6.63206023e-01,
        1.00000000e+00, 6.98489208e-01,
        1.25000000e+00, 7.15619629e-01,
        1.50000000e+00, 7.27261615e-01,
        1.75000000e+00, 7.36276899e-01,
        2.00000000e+00, 7.43755555e-01,
        2.25000000e+00, 7.50228001e-01,
        2.50000000e+00, 7.55990700e-01,
        2.75000000e+00, 7.61226271e-01,
        3.00000000e+00, 7.66055052e-01,
        3.25000000e+00, 7.70560483e-01,
        3.50000000e+00, 7.74802775e-01,
        3.75000000e+00, 7.78826786e-01,
        4.00000000e+00, 7.82667449e-01,
        4.25000000e+00, 7.86350187e-01,
        4.50000000e+00, 7.89897188e-01,
        4.75000000e+00, 7.93325746e-01,
        5.00000000e+00, 7.96650038e-01,
    ]

    agree(parse_netlist(netlist).unwrap(), names, expected[..])

@test("ngspice: a battery, a resistor, and two leds in parallel with their own resistors")
oracle_led_op()
    val netlist = """
        A battery, a resistor, and two LEDs in parallel with their own resistors
        V1 top 0 9
        R1 top a 470
        D1 a 0 dred
        R2 top b 330
        D2 b c dgreen
        R3 c 0 100
        .model dred D (IS=1e-17 N=2 RS=2)
        .model dgreen D (IS=3.5e-20 N=2 RS=2)
        .op
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        run
        wrdata led_op.data v(a) v(b) v(c)
        .endc
        .end
        """
    val names = ["v(a)", "v(b)", "v(c)"]
    val expected = [
        9.00000000e+00, 1.83894096e+00, 3.73177512e+00, 1.59643178e+00,
    ]

    agree(parse_netlist(netlist).unwrap(), names, expected[..])

@test("ngspice: nmos common-source stage biased by a divider, with a source resistor")
oracle_nmos_bias()
    val netlist = """
        NMOS common-source stage biased by a divider, with a source resistor
        VDD vdd 0 12
        R1 vdd g 100k
        R2 g 0 47k
        RD vdd d 2.2k
        RS s 0 470
        VM d dq 0
        M1 dq g s s nmod W=50u L=10u
        .model nmod NMOS (LEVEL=1 VTO=1 KP=1m LAMBDA=0.02)
        .op
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        run
        wrdata nmos_bias.data v(g) v(dq) v(s) i(vm)
        .endc
        .end
        """
    val names = ["v(g)", "v(dq)", "v(s)", "i(vm)"]
    val expected = [
        1.20000000e+01, 3.83673469e+00, 4.17157899e+00, 1.67243540e+00, 3.55837319e-03,
    ]

    agree(parse_netlist(netlist).unwrap(), names, expected[..])

@test("ngspice: a mosfet switching an led from a pulse at its gate, a capacitor across it")
oracle_nmos_led()
    val netlist = """
        A MOSFET switching an LED from a pulse at its gate, a capacitor across it
        V1 vcc 0 5
        V2 in 0 PULSE(0 5 1m 10u 10u 2m 5m)
        RG in g 1k
        RL vcc a 220
        D1 a c dred
        VM c dq 0
        CL dq 0 100n
        * A bleeder, so the drain's voltage while the MOSFET is off is set by a part rather than by picoamps:
        * amber puts GMIN across a capacitor at the operating point and ngspice does not, and with nothing
        * else there the two leakages put the drain 40 mV apart.
        RB dq 0 1meg
        M1 dq g 0 0 m2n7000
        .model m2n7000 NMOS (LEVEL=1 VTO=2 KP=0.1 LAMBDA=0.01)
        .model dred D (IS=1e-17 N=2 RS=2)
        .tran 50u 5m
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        tran 50u 5m 0 2u
        linearize v(g) v(dq) i(vm)
        wrdata nmos_led.data v(g) v(dq) i(vm)
        .endc
        .end
        """
    val names = ["v(g)", "v(dq)", "i(vm)"]
    val expected = [
        0.00000000e+00, 0.00000000e+00, 3.62237696e+00, 3.62238060e-06,
        5.00000000e-05, 0.00000000e+00, 3.62237696e+00, 3.62238060e-06,
