@test("ngspice: common-emitter amplifier biased by a divider, with an emitter resistor")
oracle_ce_bias()
    val netlist = """
        Common-emitter amplifier biased by a divider, with an emitter resistor
        VCC vcc 0 12
        R1 vcc b 47k
        R2 b 0 10k
        RC vcc c 2.2k
        RE e 0 470
        VM c cq 0
        Q1 cq b e q2n3904
        .model q2n3904 NPN (IS=6.734f BF=416.4 BR=0.7371 VAF=74.03)
        .op
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        run
        wrdata ce_bias.data v(b) v(c) v(e) i(vm)
        .endc
        .end
        """
    val names = ["v(b)", "v(c)", "v(e)", "i(vm)"]
    val expected = [
        1.20000000e+01, 2.05077634e+00, 5.65208421e+00, 1.35925139e+00, 2.88541627e-03,
    ]

    agree(parse_netlist(netlist).unwrap(), names, expected[..])

@test("ngspice: a cmos inverter swept through its input")
oracle_cmos_inverter()
    val netlist = """
        A CMOS inverter swept through its input
        VDD vdd 0 5
        VIN in 0 0
        MN out in 0 0 nmod W=10u L=2u
        MP out in vdd vdd pmod W=20u L=2u
        .model nmod NMOS (LEVEL=1 VTO=0.8 KP=100u LAMBDA=0.05)
        .model pmod PMOS (LEVEL=1 VTO=-0.9 KP=40u LAMBDA=0.05)
        .dc VIN 0 5 0.1
