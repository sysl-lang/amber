@test("ngspice: pnp current mirror sourcing into a load, and an npn emitter follower after it")
oracle_pnp_mirror()
    val netlist = """
        PNP current mirror sourcing into a load, and an NPN emitter follower after it
        VCC vcc 0 10
        Q1 ref ref vcc q2n3906
        RREF ref 0 9.1k
        Q2 out ref vcc q2n3906
        RL out 0 4.7k
        Q3 vcc out f q2n3904
        RF f 0 1k
        .model q2n3906 PNP (IS=1.41f BF=180.7 BR=4.977 VAF=18.7)
        .model q2n3904 NPN (IS=6.734f BF=416.4 BR=0.7371 VAF=74.03)
        .op
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        run
        wrdata pnp_mirror.data v(ref) v(out) v(f) i(vcc)
        .endc
        .end
        """
    val names = ["v(ref)", "v(out)", "v(f)", "i(vcc)"]
    val expected = [
        1.00000000e+01, 9.29395208e+00, 5.62642105e+00, 4.92140081e+00, -7.13982512e-03,
    ]

    agree(parse_netlist(netlist).unwrap(), names, expected[..])

@test("ngspice: rc low-pass driven by a pulse train")
oracle_rc_pulse()
    val netlist = """
        RC low-pass driven by a pulse train
        V1 in 0 PULSE(0 5 0.1m 10u 10u 1m 2m)
        R1 in out 1k
        C1 out 0 470n
        .tran 20u 6m
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        tran 20u 6m 0 0.4u
        linearize v(in) v(out)
        wrdata rc_pulse.data v(in) v(out)
        .endc
        .end
