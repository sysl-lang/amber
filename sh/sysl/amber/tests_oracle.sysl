@test("ngspice: step-down transformer's response from 1 hz to 100 khz")
oracle_ac_transformer()
    val netlist = """
        Step-down transformer's response from 1 Hz to 100 kHz
        * Ten turns to one with a little leakage: flat at a tenth from where the primary's inductance stops
        * shorting the line, about 10 Hz here, until the leakage starts to drop the load's current.
        VM line 0 DC 0 AC 1
        RP line p 2
        LP p 0 10
        LS s 0 0.1
        K1 LP LS 0.999
        RS s out 0.5
        RL out 0 47
        .ac dec 5 1 100k
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        ac dec 5 1 100k
        wrdata ac_transformer.data vr(out) vi(out) vr(p) vi(p)
        .endc
        .end
        """
    val names = ["vr(out)", "vi(out)", "vr(p)", "vi(p)"]
    val expected = [
        1.00000000e+00, 9.87070571e-02, 3.13801190e-03, 9.98569053e-01, 3.17721003e-02,
        1.58489319e+00, 9.87671782e-02, 1.97866734e-03, 9.99177268e-01, 2.00590609e-02,
        2.51188643e+00, 9.87911331e-02, 1.24480970e-03, 9.99419610e-01, 1.26594983e-02,
