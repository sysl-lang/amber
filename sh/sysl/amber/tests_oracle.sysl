module sh.sysl.amber
@tests

// amber against ngspice, on the netlists in oracle/: written by oracle/generate.zsh, not by hand.
//
// ngspice-47 with reltol 1e-6 is the reference, so the difference is
// amber's own error.

@test("ngspice: common-emitter amplifier's gain from 1 hz to 100 mhz")
oracle_ac_ce_amplifier()
    val netlist = """
        Common-emitter amplifier's gain from 1 Hz to 100 MHz
        * examples/amplifier.amber as a netlist: the coupling capacitors cut the low end; the model has no
        * junction capacitance, so the high end stays flat.
        VG g 0 DC 0 AC 1
        RG g in 50
        CIN in b 1u
        VCC vcc 0 12
        R1 vcc b 47k
        R2 b 0 10k
        RC vcc c 3.9k
        Q1 c b e q2n3904
        RE1 e x 22
        RE2 x 0 1k
        CE x 0 100u
        COUT c out 220n
        RL out 0 10k
        .model q2n3904 NPN (IS=6.734f BF=416.4 BR=0.7371 VAF=74.03)
        .ac dec 5 1 100meg
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        ac dec 5 1 100meg
        wrdata ac_ce_amplifier.data vr(out) vi(out) vr(b) vi(b)
        .endc
        .end
        """
    val names = ["vr(out)", "vi(out)", "vr(b)", "vi(b)"]
    val expected = [
        1.00000000e+00, 2.77512513e-03, 1.35473322e-03, 3.15737779e-03, 5.06115698e-02,
        1.58489319e+00, 7.54403236e-03, 5.32031138e-03, 7.87665148e-03, 7.97130767e-02,
        2.51188643e+00, 2.24579534e-02, 2.04699230e-02, 1.94508914e-02, 1.24391204e-01,
        3.98107171e+00, 7.69408953e-02, 7.48356367e-02, 4.68730012e-02, 1.89854076e-01,
        6.30957344e+00, 3.01235157e-01, 2.40952970e-01, 1.06887682e-01, 2.75715460e-01,
        1.00000000e+01, 1.20232041e+00, 5.56984966e-01, 2.18544027e-01, 3.63594896e-01,
        1.58489319e+01, 4.07115806e+00, 2.29746277e-01, 3.77626220e-01, 4.15853137e-01,
        2.51188643e+01, 9.68205893e+00, -4.43080673e+00, 5.45371664e-01, 4.13857404e-01,
        3.98107171e+01, 1.25438521e+01, -1.88516480e+01, 6.93240810e-01, 3.74881378e-01,
        6.30957344e+01, 8.89642676e-01, -3.80742020e+01, 8.15346128e-01, 3.12299044e-01,
        1.00000000e+02, -2.33208676e+01, -4.58371770e+01, 9.01995398e-01, 2.35407471e-01,
        1.58489319e+02, -4.46052427e+01, -3.95139659e+01, 9.51041913e-01, 1.62941056e-01,
        2.51188643e+02, -5.67943057e+01, -2.85764781e+01, 9.74299478e-01, 1.07207077e-01,
        3.98107171e+02, -6.24647051e+01, -1.90802503e+01, 9.84301196e-01, 6.88460071e-02,
        6.30957344e+02, -6.48714860e+01, -1.23178429e+01, 9.88412841e-01, 4.37518953e-02,
        1.00000000e+03, -6.58547385e+01, -7.84374158e+00, 9.90071156e-01, 2.76853319e-02,
        1.58489319e+03, -6.62502507e+01, -4.96724447e+00, 9.90734797e-01, 1.74884113e-02,
        2.51188643e+03, -6.64083586e+01, -3.13870225e+00, 9.90999548e-01, 1.10395140e-02,
        3.98107171e+03, -6.64714061e+01, -1.98154008e+00, 9.91105035e-01, 6.96673773e-03,
