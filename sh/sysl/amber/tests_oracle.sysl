module sh.sysl.amber
@tests

// amber against ngspice, on the netlists in oracle/: written by oracle/generate.zsh, not by hand.
//
// ngspice-47 with reltol 1e-6 is the reference, so the difference is
// amber's own error.

@test("ngspice: astable multivibrator: two transistors cross-coupled through two capacitors")
oracle_astable()
    val netlist = """
        Astable multivibrator: two transistors cross-coupled through two capacitors
        VCC vcc 0 5
        RC1 vcc c1 1k
        RC2 vcc c2 1k
        RB1 vcc b1 47k
        RB2 vcc b2 47k
        C1 c1 b2 10n
        C2 c2 b1 15n
        Q1 c1 b1 0 q2n3904
        Q2 c2 b2 0 q2n3904
        * The model has no junction capacitance, so without these the switching would be instantaneous and
        * no step short enough to follow it.
        CB1 b1 0 220p
        CB2 b2 0 220p
        CC1 c1 0 220p
        CC2 c2 0 220p
        * Started from empty, which transistor wins the race to turn on is decided by rounding. A diode
        * holds Q2's base down for the first 10 us, so Q1 wins, and then lets go for good.
        VK k 0 PULSE(-1 0 10u 1u 1u 1 2)
        RK b2 kd 100
        DK kd k dk
        .model dk D (IS=1e-14)
        .model q2n3904 NPN (IS=6.734f BF=416.4 BR=0.7371 VAF=74.03)
        .tran 20u 3m UIC
        .control
        option reltol=1e-6 abstol=1e-14 vntol=1e-9
        tran 20u 3m 0 1u uic
        linearize v(c1) v(c2) v(b1)
        wrdata astable.data v(c1) v(c2) v(b1)
        .endc
        .end
        """
    val names = ["v(c1)", "v(c2)", "v(b1)"]
    val expected = [
        0.00000000e+00, 2.68051031e-04, 1.69905784e-04, 1.72287744e-04,
        2.00000000e-05, 5.40052774e-02, 3.84317850e+00, 7.16478881e-01,
        4.00000000e-05, 7.76860460e-02, 4.68620081e+00, 7.10565499e-01,
