module sh.sysl.amber

import sysl.buf.{Buf, buf}

// A circuit: named nodes and the parts between them.
//
// **Node 0 is ground**, the reference every voltage is measured against, and it is always there. Every
// other node is numbered in the order it is first named. A part names its terminals by node number.

// The constants a diode's equation is written in.
//
// `is` is the saturation current, `n` the emission coefficient and `rs` the series resistance. The
// current through the junction at a voltage `v` across it is `is · (exp(v / (n · Vt)) − 1)`, where
// `Vt` is the thermal voltage, about 25.85 mV at room temperature.
//
// **A zener is a diode that breaks down at `bv` volts reversed**, SPICE's BV, conducting `ibv` there,
// SPICE's IBV; `bv` is 0 for a diode that does not break down. Reversed past its knee the junction
// carries a second exponential, `−is · exp(−(v + knee) / (n · Vt))`, where the knee is just short of
// `bv`, placed so the current at `−bv` is `ibv`, as SPICE places it.
struct DiodeModel derives Eq
    is: real
    n: real
    rs: real
    bv: real
    ibv: real

// A silicon signal diode, the 1N4148's figures: about 0.6 V forward at a milliamp.
val SILICON = DiodeModel(2.52e-9, 1.752, 0.568, 0.0, 1e-3)

// A red LED: about 1.8 V forward at 10 mA. The other colours are the same equation with a higher
// knee, since a shorter wavelength is a wider band gap.
val RED_LED = DiodeModel(1e-17, 2.0, 2.0, 0.0, 1e-3)
val GREEN_LED = DiodeModel(3.5e-20, 2.0, 2.0, 0.0, 1e-3)
val YELLOW_LED = DiodeModel(2e-19, 2.0, 2.0, 0.0, 1e-3)
val BLUE_LED = DiodeModel(1e-28, 2.0, 2.0, 0.0, 1e-3)

// A zener diode breaking down at `volts`: a small regulator zener, the 1N47xx series at a level its
// equations can carry: a sharp forward knee near 0.7 V, a few ohms in series, and 5 mA at its rated
// voltage reversed.
zener_model(volts: real) -> DiodeModel = DiodeModel(1e-14, 1.0, 2.0, volts, 5e-3)

// The constants a bipolar transistor's equations are written in: SPICE's Gummel–Poon model with only
// its transport and Early terms, which is Ebers–Moll with the base widened by the voltage across it.
//
// `is` is the transport saturation current, `bf` and `br` the forward and reverse current gains, `nf`
// and `nr` the emission coefficients of the base–emitter and base–collector junctions, and `early_f`
// and `early_r` the forward and reverse Early voltages, SPICE's VAF and VAR, 0 for none. With `vbe` and
// `vbc` across the junctions, `if = is · (exp(vbe / (nf · Vt)) − 1)` and
// `ir = is · (exp(vbc / (nr · Vt)) − 1)`, the base is `qb = 1 / (1 − vbc / VAF − vbe / VAR)` wide, and
//
//     collector current = (if − ir) / qb − ir / br
//     base current      = if / bf + ir / br
//
// A PNP transistor is the same equations with every voltage and current reversed.
struct TransistorModel derives Eq
    pnp: bool
    is: real
    bf: real
    br: real
    nf: real
    nr: real
    early_f: real
    early_r: real

// A small-signal NPN transistor, the 2N3904's figures: a gain of about 400, an Early voltage of 74 V.
val NPN_2N3904 = TransistorModel(false, 6.734e-15, 416.4, 0.7371, 1.0, 1.0, 74.03, 0.0)

// Its PNP complement, the 2N3906: a gain of about 180, an Early voltage of 18.7 V.
val PNP_2N3906 = TransistorModel(true, 1.41e-15, 180.7, 4.977, 1.0, 1.0, 18.7, 0.0)

// The constants a MOSFET's equations are written in: SPICE's level 1, Shichman and Hodges's square law,
// with the bulk tied to the source.
//
// `vto` is the threshold voltage, `kp` the transconductance parameter in A/V², and `lambda` the
// channel-length modulation in 1/V. A channel `w` wide and `l` long has `β = kp · w / l`. With `vgs`
// from gate to source, `vds` from drain to source and `vgst = vgs − vto`, the current into the drain
// is
//
//     cutoff,      vgst ≤ 0:    0
//     linear,      vds < vgst:  β · vds · (vgst − vds / 2) · (1 + lambda · vds)
//     saturation,  vds ≥ vgst:  β / 2 · vgst² · (1 + lambda · vds)
//
// The device is symmetric: with `vds` below zero the drain and source change places, as SPICE has it.
// A p-channel MOSFET is the same equations with every voltage and current reversed, and SPICE writes
// its threshold reversed too, so an enhancement PMOS has a negative `vto`.
struct MosfetModel derives Eq
    pmos: bool
    vto: real
    kp: real
    lambda: real

// A small-signal n-channel MOSFET with the 2N7000's figures at a level-1 approximation: a threshold
// of 2 V, and about 4 Ω on at 4.5 V and 1.25 Ω at 10 V on SPICE's square channel.
val NMOS_2N7000 = MosfetModel(false, 2.0, 0.1, 0.01)

// A small-signal p-channel MOSFET with the BS250's figures at a level-1 approximation: a threshold of
// −2 V and about 12 Ω on at −10 V.
val PMOS_BS250 = MosfetModel(true, -2.0, 0.01, 0.02)

// SPICE's channel when a MOSFET's card gives none: 100 µm wide and 100 µm long, so `β` is `kp`.
const DEFAULT_W: real = 100e-6
const DEFAULT_L: real = 100e-6

// An operational amplifier as it behaves, rather than the twenty-odd transistors inside one: a
// macromodel, as op-amp makers publish for SPICE.
//
// **The input** is `rin` ohms between the two inputs, and nothing else draws on them.
//
// **The gain** is made on a node inside: the difference between the inputs, `vd`, pushes a current
// `islew · tanh(gm · vd / islew)` into it, against `INNER_OHMS` and a capacitor to ground. Below its
// corner, `gbw / gain` hertz, the op-amp gains `gain`; above it the gain falls as `gbw / f`, so a
// circuit gaining 10 with feedback has a bandwidth of `gbw / 10`, as a real one does. The current is
// limited, so the inner node can change no faster than `slew` volts a second: the slew rate.
//
// **The inner node is held within the rails**: its swing stops `headroom` volts inside each supply,
// where the output's would.
//
// **The output** follows the inner node behind `rout`, its current smoothly limited to `ilim` either
// way, as the short-circuit protection of a real one limits it: into a load too heavy for it, the
// peaks flatten. It is drawn from the positive supply when it flows out and from the negative one when
// it flows in, and `iq` flows from one supply to the other whatever the output does.
struct OpAmpModel derives Eq
    gain: real
    gbw: real
    slew: real
    rin: real
    rout: real
    ilim: real
    headroom: real
    iq: real

    // The input stage's transconductance, and the current that limits it, for the inner node's
    // resistance and capacitance.
    gm(self) -> real = self.gain / INNER_OHMS
    islew(self) -> real = self.slew * self.inner_farads()
    inner_farads(self) -> real = self.gain / (2.0 * 3.141592653589793 * self.gbw * INNER_OHMS)

// The inner node's resistance to ground. Its value only scales the inner node's currents; the
// behaviour is set by the gain, the bandwidth and the slew rate.
const INNER_OHMS: real = 1e3

// A general-purpose op-amp, the 741's figures: a gain of 200,000, 1 MHz of gain-bandwidth, half a volt
// a microsecond, 2 MΩ in, 75 Ω out, 25 mA at most, its output a volt and a half short of each supply,
// and 1.7 mA of its own.
val OPAMP_741 = OpAmpModel(2e5, 1e6, 0.5e6, 2e6, 75.0, 25e-3, 1.5, 1.7e-3)

// A JFET-input op-amp, the TL072's: the same gain, 3 MHz, 13 V a microsecond, a teraohm in, and 1.4 mA.
val OPAMP_TL072 = OpAmpModel(2e5, 3e6, 13e6, 1e12, 75.0, 25e-3, 1.5, 1.4e-3)

// What a pin is doing: driving high, driving low, or listening.
enum PinMode
    High
    Low
    Input

// A pin's resistor to one of its rails, on while it is an input.
enum Pull
    Floating
    Up
    Down

// A microcontroller's pin as the circuit sees it.
//
// **Driving, it is its rail behind `ohms`**: `volts` above the chip's ground when high, the ground
// when low, so a pin driving an LED's current droops as a real one does.
//
// **Listening, it is `pull_ohms` to `volts` or to ground if a pull is on**, and otherwise nothing but
// its leakage. What the chip reads is the pin's voltage against `low_volts` and `high_volts`, as a
// Schmitt trigger reads it: below the one a 0, above the other a 1, and between them whatever it
// read last.
struct PinDrive derives Eq
    mode: PinMode
    pull: Pull
    volts: real
    ohms: real
    pull_ohms: real
    low_volts: real
    high_volts: real

    // The same pin doing `mode` with its pull `pull`.
    set(self, mode: PinMode, pull: Pull) -> PinDrive =
        PinDrive(mode, pull, self.volts, self.ohms, self.pull_ohms, self.low_volts, self.high_volts)

// An RP2040's pin, as its datasheet gives one: 3.3 V, about 50 Ω driving at its default strength,
// 50 kΩ pulls, and reading a 0 below 0.8 V and a 1 above 2 V. It starts as an input, floating, as the
// chip's pins come out of reset.
val RP2040_PIN = PinDrive(PinMode.Input, Pull.Floating, 3.3, 50.0, 50e3, 0.8, 2.0)

// A bench power supply's settings.
//
// **Regulated, it is a constant-voltage, constant-current supply.** It holds `volts` across its
// terminals, behind a milliohm, until the load would draw more than `amps`; then it holds `amps` and
// lets the voltage fall to whatever the load makes of that current, as a bench supply's CC lamp says.
//
// **Raw, it is what a transformer, a rectifier and a smoothing capacitor give**: `volts` on average with
// `ripple` volts peak to peak riding on it at twice the `mains` frequency, behind `ohms` of internal
// resistance, so the voltage sags as the load draws more. The ripple is the capacitor's sawtooth: a
// quick charge over the fifth of each half cycle when the rectifier conducts, then a straight
// discharge over the rest. The current limit holds in raw mode too, as a fuse-less bench unit's would.
struct PowerSupply derives Eq
    volts: real
    amps: real
    raw: bool
    ripple: real
    mains: real
    ohms: real

    // What it would put across its terminals with nothing connected.
    wave(self) -> Wave
        if !self.raw || self.ripple == 0.0 then return Dc(self.volts)

        val period = 0.5 / self.mains
        val charge = CHARGING * period

        Pulse(self.volts - self.ripple / 2.0, self.volts + self.ripple / 2.0, 0.0, charge, period - charge, 0.0, period)

    // The resistance behind the voltage it would put out.
    resistance(self) -> real = if self.raw then self.ohms else REGULATED_OHMS

// A regulated supply's output resistance.
const REGULATED_OHMS: real = 1e-3

// The part of each half cycle of the mains a raw supply's rectifier conducts for, charging its
// capacitor.
const CHARGING: real = 0.2

// A regulated supply at `volts` limited to `amps`.
regulated(volts: real, amps: real) -> PowerSupply = PowerSupply(volts, amps, false, 0.0, 50.0, 1.0)

// A raw supply averaging `volts` with `ripple` volts peak to peak at twice `mains`, behind `ohms`, limited
// to `amps`.
raw_supply(volts: real, amps: real, ripple: real, mains: real = 50.0, ohms: real = 1.0) -> PowerSupply =
    PowerSupply(volts, amps, true, ripple, mains, ohms)

// What a part is, with the values that say how it behaves.
enum Kind derives Eq
    // A resistor of `ohms`.
    Resistor(ohms: real)
    // A capacitor of `farads`: the current through it is C · dv/dt, so it passes no current once it is
    // charged, and its voltage cannot jump.
    Capacitor(farads: real)
    // An inductor of `henries`: the voltage across it is L · di/dt, so it is a plain wire once its
    // current is steady, and its current cannot jump.
    Inductor(henries: real)
    // An ideal voltage source: the first terminal is the wave's value above the second, whatever is
    // drawn from it. A battery is one whose wave is `Dc`.
    VoltageSource(wave: Wave)
    // An ideal current source: the wave's value flows through it from its first terminal to its second,
    // so out of the second into the circuit, as SPICE has it.
    CurrentSource(wave: Wave)
    // A bench signal generator: the wave's value behind an output resistance of `ohms`, which must be
    // more than zero. Its terminals are its output and its return, so the voltage across it is what
    // reaches the circuit, the wave less what the resistance drops. It is solved as its Norton
    // equivalent, `wave / ohms` in parallel with `ohms`, and needs no node of its own.
    Generator(wave: Wave, ohms: real)
    // A bench power supply, its terminals `+` and `−`: a constant voltage until the load would draw
    // more than its current limit, then that current. It needs no node of its own: it is solved as the
    // current it delivers against the voltage across it, a curve that bends smoothly from one to the
    // other.
    Supply(supply: PowerSupply)
    // A junction diode, conducting from its first terminal (the anode) to its second (the cathode).
    Diode(model: DiodeModel)
    // A switch: a hundredth of an ohm closed, and no connection open.
    Switch(closed: bool)
    // A bipolar transistor, with three terminals: collector, base and emitter, in that order.
    Transistor(model: TransistorModel)
    // A MOSFET with a channel `w` wide and `l` long, in metres, with three terminals: drain, gate and
    // source, in that order. Its bulk is its source.
    Mosfet(model: MosfetModel, w: real, l: real)
    // An operational amplifier, with five terminals: its non-inverting input, its inverting input, its
    // output, and its positive and negative supplies, in that order. It is its behaviour rather than its
    // transistors, as `OpAmpModel` says.
    OpAmp(model: OpAmpModel)
    // A microcontroller's pin, between the pin and the chip's ground: driven high or low behind its
    // output resistance, or an input, with its pull-up or pull-down if one is on. A program running on
    // the chip sets it as it runs, as `PinDrive` says.
    Pin(drive: PinDrive)

    // How many terminals a part of this kind has: 5 for an op-amp, 3 for a transistor, 2 for the rest.
    terminals(self) -> int = self match
        OpAmp(_) -> 5
        Transistor(_) | Mosfet(_, _, _) -> 3
        _ -> 2

    // A source's wave; `None` for a part that is not a source.
    wave(self) -> Option[Wave] = self match
        VoltageSource(w) -> Some(w)
        CurrentSource(w) -> Some(w)
        Generator(w, _) -> Some(w)
        Supply(s) -> Some(s.wave())
        _ -> None

// One part: its name, what it is, and the nodes its terminals are on. A two-terminal part uses `a` and
// `b` and has the rest at -1; a transistor's collector, base and emitter are `a`, `b` and `c`, and a
// MOSFET's drain, gate and source; an op-amp's non-inverting input, inverting input, output, positive
// supply and negative supply are `a` to `e`.
struct Part
    name: string
    kind: Kind
    a: int
    b: int
    c: int
    d: int
    e: int

    // The node terminal `k` is on, counting from 0.
    terminal(self, k: int) -> int = k match
        0 -> self.a
        1 -> self.b
        2 -> self.c
        3 -> self.d
        _ -> self.e

// Two inductors wound on one core, SPICE's `K`: parts `first` and `second`, coupled by `k`, more than 0
// and at most 1, so that their mutual inductance is `k · √(L1 · L2)`. A change of current in either
// puts a voltage across the other as well as across itself:
//
//     v1 = L1 · di1/dt + M · di2/dt
//     v2 = M · di1/dt + L2 · di2/dt
//
// With both currents flowing in at their first terminals, the two first terminals are the windings'
// dotted ends. A transformer is two windings coupled almost perfectly; what `k` falls short of 1 is the
// flux one winding makes that misses the other, its leakage.
struct Coupling derives Eq
    name: string
    first: int
    second: int
    k: real

struct Circuit
    // Node names by number; `nodes[0]` is ground, `"0"`.
    nodes: Buf[string]
    parts: Buf[Part]
    couplings: Buf[Coupling]

    // The node called `name`, numbered now if it has not been seen. `0`, `gnd` and `GND` are ground.
    node(*self, name: string) -> int
        if name == "0" || name == "gnd" || name == "GND" then return 0

        for i in 0..<self.nodes.len()
            if self.nodes[i] == name then return int(i)

        self.nodes.push(name)
        int(self.nodes.len()) - 1

    // The number of the node called `name`, if there is one.
    find_node(self, name: string) -> Option[int]
        if name == "0" || name == "gnd" || name == "GND" then return Some(0)

        for i in 0..<self.nodes.len()
            if self.nodes[i] == name then return Some(int(i))

        None

    // The part called `name`, if there is one.
    find_part(self, name: string) -> Option[int]
        for i in 0..<self.parts.len()
            if self.parts[i].name == name then return Some(int(i))

        None

    // Add a two-terminal part between nodes `a` and `b`.
    add(*self, name: string, kind: Kind, a: int, b: int) = self.parts.push(Part(name, kind, a, b, -1, -1, -1))

    // Add a three-terminal part on nodes `a`, `b` and `c`.
    add3(*self, name: string, kind: Kind, a: int, b: int, c: int) = self.parts.push(Part(name, kind, a, b, c, -1, -1))

    // Add a five-terminal part, an op-amp, on nodes `a` to `e`.
    add5(*self, name: string, kind: Kind, a: int, b: int, c: int, d: int, e: int) = self.parts.push(Part(name, kind, a, b, c, d, e))

    // Add a part between two nodes named rather than numbered.
    connect(*self, name: string, kind: Kind, a: string, b: string)
        val na = self.node(a)
        val nb = self.node(b)

        self.add(name, kind, na, nb)

    // Add a three-terminal part on three nodes named rather than numbered: a transistor's collector,
    // base and emitter, or a MOSFET's drain, gate and source.
    connect3(*self, name: string, kind: Kind, a: string, b: string, c: string)
        val na = self.node(a)
        val nb = self.node(b)
        val nc = self.node(c)

        self.add3(name, kind, na, nb, nc)

    // Couple inductors `first` and `second` by `k`. Either not an inductor, the two the same part, or a
    // `k` outside (0, 1] is refused.
    couple(*self, name: string, first: int, second: int, k: real) -> Result[unit, string]
        if first == second then return Err(s"'${name}' couples '${self.parts[usize(first)].name}' to itself")

        for i in [first, second]
            if !(self.parts[usize(i)].kind is Inductor(_)) then return Err(s"'${name}' couples '${self.parts[usize(i)].name}', which is not an inductor")

        if !(k > 0.0 && k <= 1.0) then return Err(s"'${name}' couples by more than 0 and at most 1, not ${k}")

        self.couplings.push(Coupling(name, first, second, k))
        Ok(())

    node_count(self) -> int = int(self.nodes.len())
end Circuit

// An empty circuit, holding only ground.
circuit() -> Circuit
    var nodes: Buf[string] = buf()

    nodes.push("0")
    Circuit(nodes, buf(), buf())
