module sh.sysl.amber

import sysl.buf.{Buf, buf}

// A circuit: named nodes and the parts between them.
//
// **Node 0 is ground**, the reference every voltage is measured against, and it is always there. Every
// other node is numbered in the order it is first named. A part names its terminals by node number.

// The constants a diode's equation is written in.
//
// `is` is the saturation current, `n` the emission coefficient and `rs` the series resistance. The
// current through the junction at a voltage `v` across it is `is · (exp(v / (n · Vt)) − 1)`, where
// `Vt` is the thermal voltage, about 25.85 mV at room temperature.
struct DiodeModel derives Eq
    is: real
    n: real
    rs: real

// A silicon signal diode, the 1N4148's figures: about 0.6 V forward at a milliamp.
val SILICON = DiodeModel(2.52e-9, 1.752, 0.568)

// A red LED: about 1.8 V forward at 10 mA. The other colours are the same equation with a higher
// knee, since a shorter wavelength is a wider band gap.
val RED_LED = DiodeModel(1e-17, 2.0, 2.0)
val GREEN_LED = DiodeModel(3.5e-20, 2.0, 2.0)
val YELLOW_LED = DiodeModel(2e-19, 2.0, 2.0)
val BLUE_LED = DiodeModel(1e-28, 2.0, 2.0)

// The constants a bipolar transistor's equations are written in: SPICE's Gummel–Poon model with only
// its transport and Early terms, which is Ebers–Moll with the base widened by the voltage across it.
//
// `is` is the transport saturation current, `bf` and `br` the forward and reverse current gains, `nf`
// and `nr` the emission coefficients of the base–emitter and base–collector junctions, and `early_f`
// and `early_r` the forward and reverse Early voltages, SPICE's VAF and VAR, 0 for none. With `vbe` and
// `vbc` across the junctions, `if = is · (exp(vbe / (nf · Vt)) − 1)` and
// `ir = is · (exp(vbc / (nr · Vt)) − 1)`, the base is `qb = 1 / (1 − vbc / VAF − vbe / VAR)` wide, and
//
//     collector current = (if − ir) / qb − ir / br
//     base current      = if / bf + ir / br
//
// A PNP transistor is the same equations with every voltage and current reversed.
struct TransistorModel derives Eq
    pnp: bool
    is: real
    bf: real
    br: real
    nf: real
    nr: real
    early_f: real
    early_r: real

// A small-signal NPN transistor, the 2N3904's figures: a gain of about 400, an Early voltage of 74 V.
val NPN_2N3904 = TransistorModel(false, 6.734e-15, 416.4, 0.7371, 1.0, 1.0, 74.03, 0.0)

// Its PNP complement, the 2N3906: a gain of about 180, an Early voltage of 18.7 V.
val PNP_2N3906 = TransistorModel(true, 1.41e-15, 180.7, 4.977, 1.0, 1.0, 18.7, 0.0)

// What a part is, with the values that say how it behaves.
enum Kind derives Eq
    // A resistor of `ohms`.
    Resistor(ohms: real)
    // A capacitor of `farads`: the current through it is C · dv/dt, so it passes no current once it is
    // charged, and its voltage cannot jump.
    Capacitor(farads: real)
    // An inductor of `henries`: the voltage across it is L · di/dt, so it is a plain wire once its
    // current is steady, and its current cannot jump.
    Inductor(henries: real)
    // An ideal voltage source: the first terminal is the wave's value above the second, whatever is
    // drawn from it. A battery is one whose wave is `Dc`.
    VoltageSource(wave: Wave)
    // An ideal current source: the wave's value flows through it from its first terminal to its second,
    // so out of the second into the circuit, as SPICE has it.
    CurrentSource(wave: Wave)
    // A junction diode, conducting from its first terminal (the anode) to its second (the cathode).
    Diode(model: DiodeModel)
    // A switch: a hundredth of an ohm closed, and no connection open.
    Switch(closed: bool)
    // A bipolar transistor, with three terminals: collector, base and emitter, in that order.
    Transistor(model: TransistorModel)

    // How many terminals a part of this kind has: 3 for a transistor, 2 for the rest.
    terminals(self) -> int = if self is Transistor(_) then 3 else 2

    // A source's wave; `None` for a part that is not a source.
    wave(self) -> Option[Wave] = self match
        VoltageSource(w) -> Some(w)
        CurrentSource(w) -> Some(w)
        _ -> None

// One part: its name, what it is, and the nodes its terminals are on. A two-terminal part uses `a` and
// `b` and has `c` at -1; a transistor's collector, base and emitter are `a`, `b` and `c`.
struct Part
    name: string
    kind: Kind
    a: int
    b: int
    c: int

    // The node terminal `k` is on, counting from 0.
    terminal(self, k: int) -> int = k match
        0 -> self.a
        1 -> self.b
        _ -> self.c

struct Circuit
    // Node names by number; `nodes[0]` is ground, `"0"`.
    nodes: Buf[string]
    parts: Buf[Part]

    // The node called `name`, numbered now if it has not been seen. `0`, `gnd` and `GND` are ground.
    node(*self, name: string) -> int
        if name == "0" || name == "gnd" || name == "GND" then return 0

        for i in 0..<self.nodes.len()
            if self.nodes[i] == name then return int(i)

        self.nodes.push(name)
        int(self.nodes.len()) - 1

    // The number of the node called `name`, if there is one.
    find_node(self, name: string) -> Option[int]
        if name == "0" || name == "gnd" || name == "GND" then return Some(0)

        for i in 0..<self.nodes.len()
            if self.nodes[i] == name then return Some(int(i))

        None

    // The part called `name`, if there is one.
    find_part(self, name: string) -> Option[int]
        for i in 0..<self.parts.len()
            if self.parts[i].name == name then return Some(int(i))

        None

    // Add a two-terminal part between nodes `a` and `b`.
    add(*self, name: string, kind: Kind, a: int, b: int) = self.parts.push(Part(name, kind, a, b, -1))

    // Add a three-terminal part on nodes `a`, `b` and `c`.
    add3(*self, name: string, kind: Kind, a: int, b: int, c: int) = self.parts.push(Part(name, kind, a, b, c))

    // Add a part between two nodes named rather than numbered.
    connect(*self, name: string, kind: Kind, a: string, b: string)
        val na = self.node(a)
        val nb = self.node(b)

        self.add(name, kind, na, nb)

    // Add a three-terminal part on three nodes named rather than numbered: a transistor's collector,
    // base and emitter.
    connect3(*self, name: string, kind: Kind, a: string, b: string, c: string)
        val na = self.node(a)
        val nb = self.node(b)
        val nc = self.node(c)

        self.add3(name, kind, na, nb, nc)

    node_count(self) -> int = int(self.nodes.len())
end Circuit

// An empty circuit, holding only ground.
circuit() -> Circuit
    var nodes: Buf[string] = buf()

    nodes.push("0")
    Circuit(nodes, buf())
